# This .gitignore file is based on the Unity .gitignore template.
# It is designed to ignore files and directories commonly generated by Unity,
# as well as other common development tools and operating systems.

# Project files
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Pp]rofilerCaptures/

# Asset meta files
# unity ignores .meta files, but git may not always ignore them properly
# so we add them here to be safe
*.meta

# Visual Studio / Rider files
.vs/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Unity-generated crash reports
crash_log.txt

# OS generated files
.DS_Store
.Trashes
thumbs.db
ehthumbs.db
desktop.ini

# Rider
.idea/

# Gradle (Android)
.gradle/
build/

# Autogenerated VS Code files
.vscode/

# Package Manager
/[Pp]ackages/[Mm]anifest.json
/[Pp]ackages/[Mm]anifest.json.meta
/[Pp]ackages/[Pp]ackage[Ll]ock.json
/[Pp]ackages/[Pp]ackage[Ll]ock.json.meta

# Build results
/Assets/AssetStoreTools
/Assets/StreamingAssets

# External assets
/Export.zip 