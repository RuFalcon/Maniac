    - target: {fileID: 5733112312123226230, guid: a37b255c4bd1e664aaa7cab7723d79b2, type: 3}
      propertyPath: _prologueText
      value: "\u0412\u044B \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0435
        \u0432 \u0441\u0435\u0431\u044F \u043D\u0430 \u0436\u0435\u0441\u0442\u043A\u043E\u0439
        \u043A\u043E\u0439\u043A\u0435 \u0432 \u0431\u0435\u0442\u043E\u043D\u043D\u043E\u0439
        \u043A\u043E\u043C\u043D\u0430\u0442\u0435. \u0412 \u0443\u0433\u043B\u0443
        - \u0433\u043E\u0440\u0430 \u0441\u0442\u0430\u0440\u043E\u0433\u043E \u0432\u043E\u0435\u043D\u043D\u043E\u0433\u043E
        \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u044F. \u0417\u0432\u043E\u043D\u0438\u0442
        \u0441\u0442\u0430\u0440\u044B\u0439 \u043F\u043E\u043B\u0435\u0432\u043E\u0439
        \u0442\u0435\u043B\u0435\u0444\u043E\u043D \u043D\u0430 \u0441\u0442\u0435\u043D\u0435.
        \u0412\u044B \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0435
        \u0442\u0440\u0443\u0431\u043A\u0443, \u0438 \u0433\u0440\u0443\u0431\u044B\u0439,
        \u0432\u043B\u0430\u0441\u0442\u043D\u044B\u0439 \u0433\u043E\u043B\u043E\u0441,
        \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u0438\u0437 \u0440\u0430\u0446\u0438\u0438,
        \u0434\u0443\u0431\u043B\u0438\u0440\u0443\u0435\u0442\u0441\u044F \u0442\u0435\u043A\u0441\u0442\u043E\u043C
        \u043D\u0430 \u0432\u0430\u0448\u0435\u043C \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u043E\u043C"
      objectReference: {fileID: 0}
