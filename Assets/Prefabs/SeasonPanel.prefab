--- !u!114 &8896363275951460785
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4933660028221494186}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0422\u044B \u0434\u0443\u043C\u0430\u043B, \u0447\u0442\u043E \u0432\u0441\u0435
    \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u043E\u0441\u044C? \u042D\u0442\u043E
    \u0431\u044B\u043B\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u0447\u0430\u043B\u043E.
    16 \u043D\u043E\u0432\u044B\u0445 \u0434\u0435\u043B \u0436\u0434\u0443\u0442
    \u0442\u0435\u0431\u044F. \u0421\u0440\u0430\u0437\u0438\u0441\u044C \u0441 \u0431\u0435\u0437\u0443\u043C\u043D\u044B\u043C
    \u041A\u0438\u0431\u0435\u0440-\u0413\u0438\u0442\u043B\u0435\u0440\u043E\u043C,
    \u0432\u044B\u043F\u0435\u0439 \u0441\u043D\u043E\u0431\u0438\u0441\u0442\u0441\u043A\u043E\u0433\u043E
    \u043F\u0438\u0432\u0430, \u0432\u044B\u0436\u0438\u0432\u0438 \u0432 \u0430\u0434\u0441\u043A\u043E\u0439
    \u043A\u0443\u0445\u043D\u0435 \u0434\u0435\u043C\u043E\u043D\u0430-\u043F\u043E\u0432\u0430\u0440\u0430
    \u0438 \u0440\u0430\u0441\u043A\u0440\u043E\u0439 \u0433\u043B\u0430\u0432\u043D\u0443\u044E
    \u0442\u0430\u0439\u043D\u0443 - \u043A\u0442\u043E \u0441\u0442\u043E\u0438\u0442
    \u0437\u0430 \u0432\u0441\u0435\u043C \u044D\u0442\u0438\u043C \u0431\u0435\u0437\u0443\u043C\u0438\u0435\u043C?
    \u041D\u043E\u0432\u044B\u0439 \u0441\u0435\u0437\u043E\u043D \u0443\u0436\u0430\u0441\u0430
    \u0443\u0436\u0435 \u0437\u0434\u0435\u0441\u044C."
