  m_text: "\u0412\u044B \u0437\u0430\u0431\u043B\u0443\u0434\u0438\u043B\u0438\u0441\u044C
    \u0432 \u043B\u0435\u0441\u0443. \u0421\u043E\u043B\u043D\u0446\u0435 \u0441\u0430\u0434\u0438\u0442\u0441\u044F.
    \u0412\u0430\u0448 \u0442\u0435\u043B\u0435\u0444\u043E\u043D \u043D\u0435 \u043B\u043E\u0432\u0438\u0442
    \u0441\u0435\u0442\u044C, \u043D\u043E \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E
    \u0432 \u0432\u0430\u0448\u0435\u043C \u0440\u044E\u043A\u0437\u0430\u043A\u0435
    \u043E\u0436\u0438\u0432\u0430\u0435\u0442 \u0438 \u0448\u0438\u043F\u0438\u0442
    \u0441\u0442\u0430\u0440\u0430\u044F \u0440\u0430\u0446\u0438\u044F, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
    \u0432\u044B \u043D\u0430\u0448\u043B\u0438 \u0440\u0430\u043D\u0435\u0435"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 109443566c1f3e94ebf753fd46464e6a, type: 2}
