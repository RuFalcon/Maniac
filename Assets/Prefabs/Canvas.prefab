      m_Calls: []
  m_text: "\u0412\u044B \u0441\u043B\u044B\u0448\u0438\u0442\u0435, \u043A\u0430\u043A
    \u043E\u043D, \u0434\u0435\u0437\u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u0438 \u043B\u0438\u0448\u0435\u043D\u043D\u044B\u0439 \u0441\u0432\u043E\u0435\u0433\u043E
    \"\u043E\u0440\u0443\u0436\u0438\u044F\", \u0432 \u043F\u0430\u043D\u0438\u043A\u0435
    \u0443\u0431\u0435\u0433\u0430\u0435\u0442 \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0443.
    \u0412\u044B \u043F\u043E\u0431\u0435\u0434\u0438\u043B\u0438, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0432
    \u0435\u0433\u043E \u0436\u0435 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442
    \u2014 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044E \u2014 \u043F\u0440\u043E\u0442\u0438\u0432
    \u043D\u0435\u0433\u043E"
