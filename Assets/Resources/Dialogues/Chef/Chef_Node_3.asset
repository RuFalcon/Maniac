  maniacProfile: {fileID: 11400000, guid: 71fe859d50d04e94e91499e1a6fb0365, type: 2}
  maniacMessages:
  - "\u041D\u0435 \u0433\u043E\u043B\u043E\u0434\u0435\u043D? \u0425\u0430! \u0412\u043E\u0442
    \u044D\u0442\u043E \u043E\u0442\u0432\u0435\u0442! \u041B\u0443\u0447\u0448\u0438\u0439
    \u0433\u043E\u0441\u0442\u044C - \u0442\u043E\u0442, \u043A\u0442\u043E \u043D\u0435
    \u043D\u0430\u0435\u0434\u0430\u0435\u0442\u0441\u044F \u043F\u0435\u0440\u0435\u0434
    \u0433\u043B\u0430\u0432\u043D\u044B\u043C \u0431\u043B\u044E\u0434\u043E\u043C!"
  - "\u0412\u044B \u0431\u0435\u0440\u0435\u0436\u0435\u0442\u0435 \u0430\u043F\u043F\u0435\u0442\u0438\u0442...
    \u0434\u043B\u044F \u0441\u0435\u0431\u044F! \u0412\u044B \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442\u0435
    \u0441\u0443\u0442\u044C \u0437\u0432\u0430\u043D\u043E\u0433\u043E \u0443\u0436\u0438\u043D\u0430!"
  - "\u0412\u044B - \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u0439 \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442!
    \u0421\u0432\u0435\u0436\u0438\u0439, \u0443\u043C\u043D\u044B\u0439, \u0441
    \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u043C \u0431\u0430\u043B\u0430\u043D\u0441\u043E\u043C
    \u044D\u043C\u043E\u0446\u0438\u0439! \u041D\u043E \u043B\u044E\u0431\u043E\u0435
    \u043C\u044F\u0441\u043E \u043D\u0443\u0436\u043D\u043E \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E
    \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C."
  - "\u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0438\u0442\u0435, \u043A\u0430\u043A\u043E\u0439
    \u043C\u0430\u0440\u0438\u043D\u0430\u0434 \u0432\u044B \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0438\u0442\u0430\u0435\u0442\u0435?
    \u041F\u0440\u044F\u043D\u044B\u0439 (\u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435
    \u0433\u043D\u0435\u0432\u0430), \u043A\u0438\u0441\u043B\u044B\u0439 (\u043D\u0430
    \u043E\u0441\u043D\u043E\u0432\u0435 \u043E\u0442\u0447\u0430\u044F\u043D\u0438\u044F)
    \u0438\u043B\u0438 \u0441\u043B\u0430\u0434\u043A\u0438\u0439 (\u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435
    \u043B\u043E\u0436\u043D\u043E\u0439 \u043D\u0430\u0434\u0435\u0436\u0434\u044B)?"
  playerChoices:
  - choiceText: "\u041F\u0440\u044F\u043D\u044B\u0439."
    nextNode: {fileID: 11400000, guid: 43dfead3303a22047809afe7de6028fd, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0413\u043D\u0435\u0432! \u041E\u0442\u043B\u0438\u0447\u043D\u043E!
      \u041E\u043D \u0441\u0434\u0435\u043B\u0430\u0435\u0442 \u043C\u044F\u0441\u043E
      \u0436\u0435\u0441\u0442\u0447\u0435, \u043D\u043E \u0430\u0440\u043E\u043C\u0430\u0442\u043D\u0435\u0435!"
    failureOutcomeText: "\u041A\u043E\u043C\u043D\u0430\u0442\u0430 \u043D\u0430\u043F\u043E\u043B\u043D\u044F\u0435\u0442\u0441\u044F
      \u0437\u0430\u043F\u0430\u0445\u043E\u043C \u0441\u0435\u0440\u044B, \u0438
      \u0432\u0430\u0441 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u043E\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0442\u044C
      \u0438\u0440\u0440\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u0430\u044F
      \u0437\u043B\u043E\u0441\u0442\u044C"
  - choiceText: "\u041A\u0438\u0441\u043B\u044B\u0439."
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041E\u0442\u0447\u0430\u044F\u043D\u0438\u0435! \u041F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E!
      \u041E\u043D\u043E \u0440\u0430\u0437\u043C\u044F\u0433\u0447\u0438\u0442 \u0432\u043E\u043B\u043E\u043A\u043D\u0430!"
    failureOutcomeText: "\u0412\u044B \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435,
      \u043A\u0430\u043A \u0432\u0430\u0441 \u043D\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0432\u043E\u043B\u043D\u0430 \u043F\u043E\u043B\u043D\u043E\u0439 \u0431\u0435\u0437\u044B\u0441\u0445\u043E\u0434\u043D\u043E\u0441\u0442\u0438"
  - choiceText: "\u042F \u0434\u0443\u043C\u0430\u044E, \u0432\u0430\u0448\u0435\u043C\u0443
      \u0431\u043B\u044E\u0434\u0443 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442
      \u043E\u0434\u043D\u043E\u0433\u043E \u0432\u0430\u0436\u043D\u043E\u0433\u043E
      \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u0430."
