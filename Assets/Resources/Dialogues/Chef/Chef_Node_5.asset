    \u044D\u0442\u043E \u0436\u0435..."
  playerChoices: []
  victoryMessage: "\u0412\u044B \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442\u0435:
    \"\u0421\u0430\u043C\u043E\u0435 \u0438\u0437\u044B\u0441\u043A\u0430\u043D\u043D\u043E\u0435
    \u0431\u043B\u044E\u0434\u043E - \u0442\u043E, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u0445\u043E\u0447\u0435\u0442 \u0441\u044A\u0435\u0441\u0442\u044C \u0441\u0430\u043C\u043E\u0433\u043E
    \u043F\u043E\u0432\u0430\u0440\u0430. \u0412\u044B \u0445\u043E\u0442\u0438\u0442\u0435
    \u0441\u044A\u0435\u0441\u0442\u044C \u043C\u0435\u043D\u044F, \u043D\u043E \u0447\u0442\u043E
    \u0435\u0441\u043B\u0438 \u044F \u0445\u043E\u0447\u0443 \u0441\u044A\u0435\u0441\u0442\u044C
    \u0432\u0430\u0441? \u0427\u0435\u0439 \u0433\u043E\u043B\u043E\u0434 \u0441\u0438\u043B\u044C\u043D\u0435\u0435?\"
    \u0412\u044B \u0432\u0432\u0435\u043B\u0438 \u0432 \u0435\u0433\u043E \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u0439
    \u0440\u0435\u0446\u0435\u043F\u0442 \u043F\u0430\u0440\u0430\u0434\u043E\u043A\u0441...
    \u041F\u043E\u043A\u0430 \u043E\u043D \u043F\u043E\u0433\u0440\u0443\u0436\u0435\u043D
    \u0432 \u0433\u0430\u0441\u0442\u0440\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0441\u0442\u0443\u043F\u043E\u0440, \u0432\u044B \u0441\u0431\u0435\u0433\u0430\u0435\u0442\u0435
    \u0447\u0435\u0440\u0435\u0437 \u043F\u0440\u0438\u043E\u0442\u043A\u0440\u044B\u0442\u0443\u044E
