  maniacProfile: {fileID: 11400000, guid: 71fe859d50d04e94e91499e1a6fb0365, type: 2}
  maniacMessages:
  - "\u0421\u043B\u0435\u0437\u044B! \u041F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E!
    \u0421\u043E\u043B\u044C - \u043B\u0443\u0447\u0448\u0438\u0439 \u0443\u0441\u0438\u043B\u0438\u0442\u0435\u043B\u044C
    \u0432\u043A\u0443\u0441\u0430! \u0412\u044B \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442\u0435
    \u0442\u043E\u043B\u043A \u0432 \u043F\u0440\u0438\u043F\u0440\u0430\u0432\u0430\u0445."
  - "\u0412\u0430\u0448 \u0432\u043A\u0443\u0441 \u043D\u0435\u043F\u043B\u043E\u0445.
    \u0422\u0435\u043F\u0435\u0440\u044C - \u0437\u0430\u043A\u0443\u0441\u043A\u0430.
    \u042F \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u043B \u0442\u0440\u0438
    \u043F\u0430\u0448\u0442\u0435\u0442\u0430. \u0418\u0437 \u0441\u0442\u0440\u0430\u0445\u0430,
    \u0438\u0437 \u0437\u0430\u0432\u0438\u0441\u0442\u0438 \u0438 \u0438\u0437 \u043B\u0436\u0438."
  - "\u0412\u0441\u0435 \u0441\u0432\u0435\u0436\u0430\u0439\u0448\u0435\u0435, \u043E\u0442
    \u043C\u043E\u0438\u0445 \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0438\u0445...
    \u0433\u043E\u0441\u0442\u0435\u0439. \u041A\u0430\u043A\u043E\u0439 \u0436\u0435\u043B\u0430\u0435\u0442\u0435
    \u043E\u0442\u0432\u0435\u0434\u0430\u0442\u044C?"
  playerChoices:
  - choiceText: "\u041F\u0430\u0448\u0442\u0435\u0442 \u0438\u0437 \u0441\u0442\u0440\u0430\u0445\u0430."
    nextNode: {fileID: 11400000, guid: 43dfead3303a22047809afe7de6028fd, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0421\u0442\u0440\u0430\u0445... \u041A\u043B\u0430\u0441\u0441\u0438\u043A\u0430.
      \u041D\u043E \u0443 \u043D\u0435\u0433\u043E \u0433\u043E\u0440\u044C\u043A\u043E\u0432\u0430\u0442\u044B\u0439
      \u043F\u0440\u0438\u0432\u043A\u0443\u0441. \u0412\u044B \u043D\u0435 \u0433\u0443\u0440\u043C\u0430\u043D."
    failureOutcomeText: "\u041F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0432
      \u043F\u0430\u0448\u0442\u0435\u0442, \u0432\u044B \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435,
      \u043A\u0430\u043A \u0432\u0430\u0441 \u043E\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0435\u0442
      \u043B\u0435\u0434\u0435\u043D\u044F\u0449\u0438\u0439, \u0438\u0440\u0440\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439
      \u0443\u0436\u0430\u0441"
  - choiceText: "\u041F\u0430\u0448\u0442\u0435\u0442 \u0438\u0437 \u0437\u0430\u0432\u0438\u0441\u0442\u0438."
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0417\u0430\u0432\u0438\u0441\u0442\u044C... \u041E\u0441\u0442\u0440\u044B\u0439,
      \u043F\u0438\u043A\u0430\u043D\u0442\u043D\u044B\u0439 \u0432\u043A\u0443\u0441.
      \u041D\u043E \u043E\u043D \u043E\u0431\u0436\u0438\u0433\u0430\u0435\u0442."
    failureOutcomeText: "\u041F\u043E\u0441\u043B\u0435 \u043F\u0440\u043E\u0431\u044B
      \u0432\u0430\u0441 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u043C\u0443\u0447\u0438\u0442\u044C
      \u0447\u0443\u0432\u0441\u0442\u0432\u043E \u0437\u0430\u0432\u0438\u0441\u0442\u0438
      \u043A\u043E \u0432\u0441\u0435\u043C\u0443: \u043A \u043F\u043E\u0432\u0430\u0440\u0443,
      \u043A \u0435\u0433\u043E \u043A\u0443\u0445\u043D\u0435, \u0434\u0430\u0436\u0435
      \u043A \u0441\u0442\u043E\u043B\u043E\u0432\u044B\u043C \u043F\u0440\u0438\u0431\u043E\u0440\u0430\u043C"
  - choiceText: "\u042F \u043D\u0435 \u0433\u043E\u043B\u043E\u0434\u0435\u043D."
