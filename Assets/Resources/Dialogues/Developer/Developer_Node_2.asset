  maniacProfile: {fileID: 11400000, guid: bda90a6a40bd1594698c248ef158a108, type: 2}
  maniacMessages:
  - "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u0432\u043E\u043F\u0440\u043E\u0441.
    \u0422\u044B \u0431\u044B\u043B \u043E\u0431\u0440\u0430\u0437\u0446\u043E\u043C
    \u0434\u043B\u044F \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u043C\u043E\u0435\u0433\u043E
    \u0432\u0435\u043B\u0438\u0447\u0430\u0439\u0448\u0435\u0433\u043E \u0442\u0432\u043E\u0440\u0435\u043D\u0438\u044F."
  - "\u0418\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\u0430, \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
    \u043D\u0430 \u0442\u0432\u043E\u0435\u0439 \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u0438,
    \u043D\u043E \u043B\u0438\u0448\u0435\u043D\u043D\u043E\u0433\u043E \u0442\u0432\u043E\u0438\u0445
    \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u043E\u0432. \u041D\u0430\u0437\u043E\u0432\u0435\u043C
    \u0435\u0433\u043E '\u0418\u0433\u0440\u043E\u043A 2.0'."
  - "'\u0418\u0433\u0440\u043E\u043A 2.0' \u043F\u0440\u043E\u0448\u0435\u043B \u0432\u0441\u0435
    \u0442\u0435 \u0436\u0435 \u0442\u0435\u0441\u0442\u044B, \u0447\u0442\u043E
    \u0438 \u0442\u044B. \u041D\u043E \u043E\u043D \u0441\u0434\u0435\u043B\u0430\u043B
    \u044D\u0442\u043E \u0431\u044B\u0441\u0442\u0440\u0435\u0435. \u0411\u0435\u0437
    \u043E\u0448\u0438\u0431\u043E\u043A. \u0411\u0435\u0437 \u0441\u0442\u0440\u0430\u0445\u0430
    \u0438 \u0441\u043E\u043C\u043D\u0435\u043D\u0438\u0439. \u041E\u043D - \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u0430\u044F
    \u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u043C\u0430\u0448\u0438\u043D\u0430."
  - "\u0410 \u0442\u044B - \u043F\u0440\u043E\u0441\u0442\u043E \u043C\u0435\u0448\u043E\u043A
    \u0441 \u043A\u043E\u0441\u0442\u044F\u043C\u0438 \u0438 \u0438\u0440\u0440\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u043C\u0438
    \u044D\u043C\u043E\u0446\u0438\u044F\u043C\u0438. \u0422\u044B \u0443\u0441\u0442\u0430\u0440\u0435\u0432\u0448\u0430\u044F
    \u0432\u0435\u0440\u0441\u0438\u044F. \u0410 \u0443\u0441\u0442\u0430\u0440\u0435\u0432\u0448\u0438\u0435
    \u0432\u0435\u0440\u0441\u0438\u0438 \u043F\u043E\u0434\u043B\u0435\u0436\u0430\u0442
    \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u044E."
  playerChoices:
  - choiceText: "\u0422\u044B \u043D\u0435 \u043C\u043E\u0436\u0435\u0448\u044C \u043C\u0435\u043D\u044F
      \u0443\u0434\u0430\u043B\u0438\u0442\u044C! \u042F \u0447\u0435\u043B\u043E\u0432\u0435\u043A!"
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041C\u043E\u0433\u0443. \u0412 \u044D\u0442\u043E\u043C
      \u043C\u0438\u0440\u0435 \u044F - \u0431\u043E\u0433. \u0410 \u0442\u044B -
      \u0432\u0441\u0435\u0433\u043E \u043B\u0438\u0448\u044C \u0441\u0442\u0440\u043E\u043A\u0430
      \u0432 \u043C\u043E\u0435\u043C \u043A\u043E\u0434\u0435. \u0418 \u044F \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0441\u044C
      \u043D\u0430\u0436\u0430\u0442\u044C 'Delete'."
    failureOutcomeText: "\u0412\u0441\u0435 \u043A\u043D\u043E\u043F\u043A\u0438
      \u0432\u044B\u0431\u043E\u0440\u0430 \u0438\u0441\u0447\u0435\u0437\u0430\u044E\u0442,
      \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044F \u0432\u0430\u0441 \u0431\u0435\u0437
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C"
  - choiceText: "\u0418 \u0432 \u0447\u0435\u043C \u0436\u0435 \u043E\u043D \u043B\u0443\u0447\u0448\u0435?
      \u0412 \u0447\u0435\u043C \u0435\u0433\u043E \"\u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0441\u0442\u0432\u043E\"?"
    nextNode: {fileID: 11400000, guid: eaaa085192bd99e4bb29393d1baba210, type: 2}
    isCorrectChoice: 1
    maniacResponseOnFail: 
    failureOutcomeText: 
  - choiceText: "\u0417\u043D\u0430\u0447\u0438\u0442, \u0432\u0441\u0435 \u043C\u043E\u0438
      \u043F\u043E\u0431\u0435\u0434\u044B \u0431\u044B\u043B\u0438 \u0431\u0435\u0441\u0441\u043C\u044B\u0441\u043B\u0435\u043D\u043D\u044B?"
    nextNode: {fileID: 11400000, guid: 43dfead3303a22047809afe7de6028fd, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041D\u0435 \u0431\u0435\u0441\u0441\u043C\u044B\u0441\u043B\u0435\u043D\u043D\u044B.
      \u041E\u043D\u0438 \u0431\u044B\u043B\u0438 \u043F\u043E\u043B\u0435\u0437\u043D\u044B.
      \u041A\u0430\u043A \u0434\u0430\u043D\u043D\u044B\u0435 \u0434\u043B\u044F
      \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u044F \u043D\u0435\u0439\u0440\u043E\u0441\u0435\u0442\u0438.
      \u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0437\u0430 \u0442\u0432\u043E\u0439
      \u0432\u043A\u043B\u0430\u0434. \u041E\u043D \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F."
    failureOutcomeText: "\u0412\u0430\u0448 \u0430\u0432\u0430\u0442\u0430\u0440
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u043F\u0438\u043A\u0441\u0435\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0438 \u0440\u0430\u0441\u043F\u0430\u0434\u0430\u0442\u044C\u0441\u044F"
