      \u0441\u0432\u043E\u044E \u043B\u043E\u0436\u044C."
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0412\u044B \u043F\u0440\u0438\u0437\u043D\u0430\u043B\u0438
      \u0441\u0432\u043E\u044E \u0432\u0438\u043D\u0443 \u0438 \u0441\u0430\u043C\u0438
      \u0432\u044B\u043D\u0435\u0441\u043B\u0438 \u0441\u0435\u0431\u0435 \u043F\u0440\u0438\u0433\u043E\u0432\u043E\u0440.
