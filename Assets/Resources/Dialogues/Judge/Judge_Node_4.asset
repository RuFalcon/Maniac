  - choiceText: "\u042F \u0431\u044B \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u043B
      \u0441\u0435\u0431\u044F."
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0417\u043D\u0430\u0447\u0438\u0442, \u0432\u044B \u0431\u044B
