  maniacMessages:
  - "\u0412\u044B \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u043F\u043E\u0434
    \u0441\u043E\u043C\u043D\u0435\u043D\u0438\u0435 \u0441\u0430\u043C\u0443 \u043E\u0441\u043D\u043E\u0432\u0443
    \u043C\u043E\u0435\u0433\u043E \u043F\u0440\u0430\u0432\u043E\u0441\u0443\u0434\u0438\u044F.
    \u0412\u044B \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442\u0435,
    \u0447\u0442\u043E \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E\u0439
    \u0438\u0441\u0442\u0438\u043D\u044B \u043D\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442.
    \u0422\u043E\u0433\u0434\u0430 \u0438 \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E\u0433\u043E
    \u0433\u0440\u0435\u0445\u0430 \u0431\u044B\u0442\u044C \u043D\u0435 \u043C\u043E\u0436\u0435\u0442."
  - "\u041D\u043E \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u043D\u0435 \u043C\u043E\u0436\u0435\u0442
    \u0431\u044B\u0442\u044C \u043D\u0435\u043F\u0440\u0430\u0432\u043E\u0439. \u0414\u043E\u043B\u0436\u0435\u043D
    \u0431\u044B\u0442\u044C \u0432\u044B\u0445\u043E\u0434. \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
    \u0432\u043E\u043F\u0440\u043E\u0441: \u043A\u0430\u043A \u0431\u044B \u0432\u044B
    \u0440\u0430\u0441\u0441\u0443\u0434\u0438\u043B\u0438 \u0441\u0430\u043C\u0438
    \u0441\u0435\u0431\u044F, \u0431\u0443\u0434\u044C \u0432\u044B \u043D\u0430
    \u043C\u043E\u0435\u043C \u043C\u0435\u0441\u0442\u0435?"
  playerChoices:
  - choiceText: "\u042F \u0431\u044B \u043F\u0440\u0438\u0433\u043E\u0432\u043E\u0440\u0438\u043B
