    failureOutcomeText: "\u041F\u0435\u0442\u043B\u044F, \u043D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u043E
      \u0432\u0438\u0441\u0435\u0432\u0448\u0430\u044F \u043D\u0430\u0434 \u0432\u0430\u043C\u0438,
      \u0440\u0435\u0437\u043A\u043E \u043F\u0430\u0434\u0430\u0435\u0442 \u0432\u0430\u043C
