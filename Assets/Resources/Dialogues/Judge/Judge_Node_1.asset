  maniacMessages:
  - "\u0417\u0430\u0441\u0435\u0434\u0430\u043D\u0438\u0435 \u043E\u0431\u044A\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C. \u0414\u0435\u043B\u043E \u21164.
    \u041E\u0431\u0432\u0438\u043D\u044F\u0435\u043C\u044B\u0439, \u0432\u044B \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u043B\u0438
    \u043F\u0435\u0440\u0435\u0434 \u0441\u0443\u0434\u043E\u043C \u0437\u0430 \u0433\u0440\u0435\u0445,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0440\u0430\u0437\u044A\u0435\u0434\u0430\u0435\u0442
    \u0434\u0443\u0448\u0443 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E
    \u043C\u0438\u0440\u0430. \u0413\u0440\u0435\u0445 \u041B\u0436\u0438."
  - "\u042F \u0432\u0438\u0434\u0435\u043B, \u043A\u0430\u043A \u0432\u044B \u043B\u0433\u0430\u043B\u0438.
    \u041A\u043E\u043B\u043B\u0435\u0433\u0430\u043C, \u0431\u043B\u0438\u0437\u043A\u0438\u043C,
    \u0441\u0430\u043C\u043E\u043C\u0443 \u0441\u0435\u0431\u0435. \u0412\u0430\u0448\u0430
    \u0436\u0438\u0437\u043D\u044C - \u043F\u0430\u0443\u0442\u0438\u043D\u0430 \u043E\u0431\u043C\u0430\u043D\u0430.
    \u0412\u044B \u043F\u0440\u0438\u0437\u043D\u0430\u0435\u0442\u0435 \u0441\u0432\u043E\u044E
    \u0432\u0438\u043D\u0443?"
  playerChoices:
  - choiceText: "\u041A\u0430\u043A\u043E\u0435 \u043F\u0440\u0430\u0432\u043E \u0442\u044B
      \u0438\u043C\u0435\u0435\u0448\u044C \u043C\u0435\u043D\u044F \u0441\u0443\u0434\u0438\u0442\u044C?!
      \u0422\u044B \u0441\u0430\u043C \u043F\u0440\u0435\u0441\u0442\u0443\u043F\u043D\u0438\u043A!"
    nextNode: {fileID: 11400000, guid: 072ff9f99473c214d940fa9bc8ef6f07, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041F\u043E\u0434\u0441\u0443\u0434\u0438\u043C\u044B\u0439
      \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u0435\u0442 \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u044E
      \u0438 \u043D\u0435 \u0443\u0432\u0430\u0436\u0430\u0435\u0442 \u0441\u0443\u0434.
      \u042D\u0442\u043E \u043B\u0438\u0448\u044C \u0443\u0441\u0443\u0433\u0443\u0431\u043B\u044F\u0435\u0442
      \u0432\u0438\u043D\u0443. \u041F\u0440\u0438\u0433\u043E\u0432\u043E\u0440
      \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439
