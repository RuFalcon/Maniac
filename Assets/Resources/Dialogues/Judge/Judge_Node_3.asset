  maniacProfile: {fileID: 11400000, guid: 05fcbd31ba6b27546b3ebd298c794cc1, type: 2}
  maniacMessages:
  - "\u0412\u0430\u0448\u0430 \u043F\u043E\u0437\u0438\u0446\u0438\u044F \u044F\u0441\u043D\u0430.
    \u041D\u043E \u0441\u0443\u0434 \u0434\u043E\u043B\u0436\u0435\u043D \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
    \u0435\u0435 \u043D\u0430 \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C. "
  - "\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044C\u0442\u0435: \u0432\u0440\u0430\u0447
    \u043B\u0436\u0435\u0442 \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u043E
    \u0431\u043E\u043B\u044C\u043D\u043E\u043C\u0443 \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u0443
    \u043E \u0435\u0433\u043E \u0448\u0430\u043D\u0441\u0430\u0445, \u0447\u0442\u043E\u0431\u044B
    \u0442\u043E\u0442 \u043F\u0440\u043E\u0436\u0438\u043B \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
    \u0434\u043D\u0438 \u0432 \u0441\u043F\u043E\u043A\u043E\u0439\u0441\u0442\u0432\u0438\u0438.
    \u042D\u0442\u043E \u0434\u043E\u0431\u0440\u043E \u0438\u043B\u0438 \u0437\u043B\u043E?"
  playerChoices:
  - choiceText: "\u042D\u0442\u043E \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E\u0435
      \u0434\u043E\u0431\u0440\u043E."
    nextNode: {fileID: 11400000, guid: 43dfead3303a22047809afe7de6028fd, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041D\u0435\u0432\u0435\u0440\u043D\u043E! \u0412\u044B
      \u043E\u0442\u043D\u0438\u043C\u0430\u0435\u0442\u0435 \u0443 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
      \u043F\u0440\u0430\u0432\u043E \u0437\u043D\u0430\u0442\u044C \u043F\u0440\u0430\u0432\u0434\u0443
      \u043E \u0441\u0432\u043E\u0435\u0439 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
      \u0436\u0438\u0437\u043D\u0438! \u0412\u044B \u0440\u0435\u0448\u0430\u0435\u0442\u0435
      \u0437\u0430 \u043D\u0435\u0433\u043E! \u042D\u0442\u043E \u043D\u0435 \u0434\u043E\u0431\u0440\u043E,
      \u044D\u0442\u043E \u0433\u043E\u0440\u0434\u044B\u043D\u044F!"
    failureOutcomeText: "\u0412\u0430\u0448\u0435 \u043A\u0440\u0435\u0441\u043B\u043E
      \u0441\u0438\u043B\u044C\u043D\u043E \u0432\u0438\u0431\u0440\u0438\u0440\u0443\u0435\u0442,
      \u0438 \u0432\u044B \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435
      \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0435
      \u0440\u0430\u0437\u0440\u044F\u0434\u044B, \u043F\u0440\u043E\u0445\u043E\u0434\u044F\u0449\u0438\u0435
      \u0447\u0435\u0440\u0435\u0437 \u043D\u0435\u0433\u043E"
  - choiceText: "\u042D\u0442\u043E \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E\u0435
      \u0437\u043B\u043E."
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041D\u0435\u0432\u0435\u0440\u043D\u043E! \u0412\u044B
      \u043E\u0431\u0440\u0435\u043A\u0430\u0435\u0442\u0435 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
