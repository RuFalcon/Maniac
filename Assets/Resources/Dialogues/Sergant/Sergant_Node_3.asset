  maniacProfile: {fileID: 11400000, guid: 2c1899e993239d04a96b8f92d5a26f26, type: 2}
  maniacMessages:
  - "\u0412\u0435\u0440\u043D\u043E. \u0421\u043C\u043E\u0447\u0438\u0442\u044C \u0442\u043A\u0430\u043D\u044C
    \u0438 \u043F\u0440\u0438\u043B\u043E\u0436\u0438\u0442\u044C \u043A \u043B\u0438\u0446\u0443.
    \u041F\u0440\u043E\u0441\u0442\u0435\u0439\u0448\u0438\u0439 \u0441\u043F\u043E\u0441\u043E\u0431
    \u0437\u0430\u0449\u0438\u0442\u044B. \u0422\u044B \u0437\u043D\u0430\u0435\u0448\u044C
    \u043E\u0441\u043D\u043E\u0432\u044B. \u042D\u0442\u043E \u0445\u043E\u0440\u043E\u0448\u043E."
  - "\u0422\u044B \u043F\u0440\u043E\u0448\u0435\u043B \u0442\u0435\u0441\u0442 \u043D\u0430
    \u0432\u044B\u0436\u0438\u0432\u0430\u043D\u0438\u0435. \u0422\u0435\u043F\u0435\u0440\u044C
    - \u0442\u0430\u043A\u0442\u0438\u043A\u0430. \u042F \u043F\u043E\u043A\u0430\u0436\u0443
    \u0442\u0435\u0431\u0435 \u043D\u0430 \u043C\u043E\u043D\u0438\u0442\u043E\u0440\u0435
    \u043F\u043B\u0430\u043D \u043D\u0430\u0448\u0435\u0433\u043E \u043E\u0431\u044A\u0435\u043A\u0442\u0430.
    (\u041D\u0430 \u0441\u0442\u0435\u043D\u0435 \u0437\u0430\u0433\u043E\u0440\u0430\u0435\u0442\u0441\u044F
    \u044D\u043A\u0440\u0430\u043D \u0441 \u043F\u043B\u0430\u043D\u043E\u043C \u0431\u0443\u043D\u043A\u0435\u0440\u0430)"
  - "\u041C\u044B \u0437\u0434\u0435\u0441\u044C, \u043D\u0430 \u0442\u043E\u0447\u043A\u0435
    \"\u0410\u043B\u044C\u0444\u0430\". \u0412\u0440\u0430\u0433 - \u043D\u0430 \u0442\u043E\u0447\u043A\u0435
    \"\u041E\u043C\u0435\u0433\u0430\". \u041C\u0435\u0436\u0434\u0443 \u043D\u0430\u043C\u0438
    \u0442\u0440\u0438 \u043F\u0443\u0442\u0438: \u0447\u0435\u0440\u0435\u0437 \u0430\u0440\u0441\u0435\u043D\u0430\u043B
    (\u043E\u043F\u0430\u0441\u043D\u043E, \u043D\u043E \u0435\u0441\u0442\u044C
    \u043E\u0440\u0443\u0436\u0438\u0435)"
  - "\u0427\u0435\u0440\u0435\u0437 \u043B\u0430\u0437\u0430\u0440\u0435\u0442 (\u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E,
    \u043D\u043E \u0434\u043E\u043B\u0433\u043E) \u0438 \u0447\u0435\u0440\u0435\u0437
    \u0432\u0435\u043D\u0442\u0438\u043B\u044F\u0446\u0438\u044E (\u0431\u044B\u0441\u0442\u0440\u043E,
    \u043D\u043E \u043C\u043E\u0436\u043D\u043E \u0437\u0430\u0441\u0442\u0440\u044F\u0442\u044C).
    \u041A\u0430\u043A\u043E\u0439 \u043F\u0443\u0442\u044C \u0442\u044B \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0448\u044C
    \u0434\u043B\u044F \u0448\u0442\u0443\u0440\u043C\u0430?"
  playerChoices:
  - choiceText: "\u0427\u0435\u0440\u0435\u0437 \u0430\u0440\u0441\u0435\u043D\u0430\u043B.
      \u0412\u043E\u043E\u0440\u0443\u0436\u0438\u043C\u0441\u044F \u0438 \u0434\u0430\u0434\u0438\u043C
      \u0431\u043E\u0439!"
    nextNode: {fileID: 11400000, guid: 43dfead3303a22047809afe7de6028fd, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041B\u043E\u0431\u043E\u0432\u0430\u044F \u0430\u0442\u0430\u043A\u0430?
      \u0413\u043B\u0443\u043F\u043E. \u0412\u0440\u0430\u0433 \u0436\u0434\u0435\u0442
      \u044D\u0442\u043E\u0433\u043E. \u0422\u044B \u043F\u043E\u0432\u0435\u0434\u0435\u0448\u044C
      \u043E\u0442\u0440\u044F\u0434 \u043D\u0430 \u0432\u0435\u0440\u043D\u0443\u044E
      \u0441\u043C\u0435\u0440\u0442\u044C."
    failureOutcomeText: "\u042D\u043A\u0440\u0430\u043D \u0432\u0441\u043F\u044B\u0445\u0438\u0432\u0430\u0435\u0442
      \u043A\u0440\u0430\u0441\u043D\u044B\u043C, \u0438\u043C\u0438\u0442\u0438\u0440\u0443\u044F
      \u0432\u0437\u0440\u044B\u0432. \u0412\u044B \u0441\u043B\u044B\u0448\u0438\u0442\u0435
      \u043A\u0440\u0438\u043A\u0438"
  - choiceText: "\u0427\u0435\u0440\u0435\u0437 \u043B\u0430\u0437\u0430\u0440\u0435\u0442.
      \u0422\u0438\u0448\u0435 \u0435\u0434\u0435\u0448\u044C - \u0434\u0430\u043B\u044C\u0448\u0435
      \u0431\u0443\u0434\u0435\u0448\u044C."
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041C\u0435\u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      - \u044D\u0442\u043E \u0441\u043C\u0435\u0440\u0442\u044C. \u041F\u043E\u043A\u0430
      \u0442\u044B \u0431\u0443\u0434\u0435\u0448\u044C \u043F\u043E\u043B\u0437\u0442\u0438
      \u0447\u0435\u0440\u0435\u0437 \u043B\u0430\u0437\u0430\u0440\u0435\u0442,
      \u0432\u0440\u0430\u0433 \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u043F\u043F\u0438\u0440\u0443\u0435\u0442\u0441\u044F
      \u0438 \u0437\u0430\u0439\u043C\u0435\u0442 \u0432\u044B\u0433\u043E\u0434\u043D\u0443\u044E
      \u043F\u043E\u0437\u0438\u0446\u0438\u044E."
    failureOutcomeText: "\u041D\u0430 \u043F\u043B\u0430\u043D\u0435 \u0432\u0438\u0434\u043D\u043E,
      \u043A\u0430\u043A \"\u0432\u0440\u0430\u0433\" \u0441\u0442\u0430\u0432\u0438\u0442
      \u043C\u0438\u043D\u044B \u043D\u0430 \u0432\u044B\u0445\u043E\u0434\u0435
      \u0438\u0437 \u043B\u0430\u0437\u0430\u0440\u0435\u0442\u0430"
  - choiceText: "\u041D\u0438 \u043E\u0434\u0438\u043D \u0438\u0437 \u043D\u0438\u0445.
      \u041C\u044B \u0443\u0441\u0442\u0440\u043E\u0438\u043C \u0437\u0430\u0441\u0430\u0434\u0443
      \u0437\u0434\u0435\u0441\u044C, \u043D\u0430 \u0442\u043E\u0447\u043A\u0435
