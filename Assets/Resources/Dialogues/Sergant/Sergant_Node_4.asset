  maniacProfile: {fileID: 11400000, guid: 2c1899e993239d04a96b8f92d5a26f26, type: 2}
  maniacMessages:
  - "...\u0417\u0430\u043D\u044F\u0442\u044C \u043E\u0431\u043E\u0440\u043E\u043D\u0443.
    \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0437\u043D\u0430\u043D\u0438\u0435
    \u0441\u0432\u043E\u0435\u0439 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438.
    \u0417\u0430\u043C\u0430\u043D\u0438\u0442\u044C \u0432\u0440\u0430\u0433\u0430
    \u0432 \u043B\u043E\u0432\u0443\u0448\u043A\u0443... \u0420\u044F\u0434\u043E\u0432\u043E\u0439,
    \u0434\u0430 \u0442\u044B... \u043F\u0440\u0438\u0440\u043E\u0436\u0434\u0435\u043D\u043D\u044B\u0439
    \u0442\u0430\u043A\u0442\u0438\u043A! \u042D\u0442\u043E \u0431\u043B\u0435\u0441\u0442\u044F\u0449\u0430\u044F
    \u0438\u0434\u0435\u044F!"
  - "\u0422\u0432\u043E\u0439 \u043F\u043B\u0430\u043D \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D.
    \u041C\u044B \u0436\u0434\u0435\u043C \u0432\u0440\u0430\u0433\u0430 \u0437\u0434\u0435\u0441\u044C.
    \u041D\u043E \u0434\u043B\u044F \u0443\u0441\u043F\u0435\u0448\u043D\u043E\u0439
    \u0437\u0430\u0441\u0430\u0434\u044B \u043D\u0443\u0436\u0435\u043D \u043F\u0440\u0438\u043A\u0430\u0437.
    \u0427\u0435\u0442\u043A\u0438\u0439, \u044F\u0441\u043D\u044B\u0439, \u043D\u0435
    \u0442\u0435\u0440\u043F\u044F\u0449\u0438\u0439 \u0432\u043E\u0437\u0440\u0430\u0436\u0435\u043D\u0438\u0439."
  - "\u042F \u0445\u043E\u0447\u0443 \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C,
    \u043A\u0430\u043A \u0442\u044B \u043E\u0442\u0434\u0430\u0448\u044C \u043F\u0440\u0438\u043A\u0430\u0437
    \u043D\u0430\u0448\u0435\u043C\u0443 \u0432\u043E\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u043C\u043E\u043C\u0443
    \u043E\u0442\u0440\u044F\u0434\u0443. \u0427\u0442\u043E \u0442\u044B \u0441\u043A\u0430\u0436\u0435\u0448\u044C?"
  playerChoices:
  - choiceText: "\u0420\u0435\u0431\u044F\u0442\u0430, \u0434\u0430\u0432\u0430\u0439\u0442\u0435
      \u0441\u043E\u0431\u0435\u0440\u0435\u043C\u0441\u044F \u0438 \u043F\u043E\u0431\u0435\u0434\u0438\u043C!"
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u042D\u0442\u043E \u043D\u0435 \u043F\u0440\u0438\u043A\u0430\u0437!
      \u042D\u0442\u043E \u0440\u0435\u0447\u044C \u0444\u0443\u0442\u0431\u043E\u043B\u044C\u043D\u043E\u0433\u043E
      \u0442\u0440\u0435\u043D\u0435\u0440\u0430! \u0421\u043E\u043B\u0434\u0430\u0442\u0430\u043C
      \u043D\u0443\u0436\u043D\u0430 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u0438\u043A\u0430,
      \u0430 \u043D\u0435 \u043C\u043E\u0442\u0438\u0432\u0430\u0446\u0438\u044F!"
    failureOutcomeText: "\u041E\u043D \u0432 \u044F\u0440\u043E\u0441\u0442\u0438
      \u0431\u044C\u0435\u0442 \u043A\u0443\u043B\u0430\u043A\u043E\u043C \u043F\u043E
      \u0441\u0442\u043E\u043B\u0443"
  - choiceText: "\u041E\u0433\u043E\u043D\u044C \u043F\u043E \u043C\u043E\u0435\u0439
      \u043A\u043E\u043C\u0430\u043D\u0434\u0435!"
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041D\u0435\u043F\u043B\u043E\u0445\u043E. \u041D\u043E
      \u0442\u044B - \u0440\u044F\u0434\u043E\u0432\u043E\u0439. \u0422\u044B \u043D\u0435
      \u0438\u043C\u0435\u0435\u0448\u044C \u043F\u0440\u0430\u0432\u0430 \u043E\u0442\u0434\u0430\u0432\u0430\u0442\u044C
