  playerChoices: []
  victoryMessage: "\u0425\u043E\u0442\u044F \u0443 \u043D\u0435\u0433\u043E \u043D\u0435\u0442
    \u0433\u043B\u0430\u0437, \u0435\u0433\u043E \u0441\u0432\u0435\u0442\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
    \u043A\u043E\u0436\u0430 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u043E\u0436\u043E\u0433.
    \u041E\u043D\u043E \u0438\u0437\u0434\u0430\u0435\u0442 \u043E\u0433\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439,
    \u043F\u043E\u043B\u043D\u044B\u0439 \u0431\u043E\u043B\u0438 \u0432\u0438\u0437\u0433
    \u0438 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u043C\u0435\u0442\u0430\u0442\u044C\u0441\u044F
    \u043F\u043E \u043A\u043E\u043C\u043D\u0430\u0442\u0435, \u0432\u0440\u0435\u0437\u0430\u044F\u0441\u044C
    \u0432 \u0441\u0442\u0435\u043D\u044B. \u0412 \u043F\u0430\u043D\u0438\u043A\u0435
    \u043E\u043D\u043E \u0441\u043D\u043E\u0441\u0438\u0442 \u0445\u043B\u0438\u043F\u043A\u0443\u044E
    \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u0434\u0432\u0435\u0440\u044C \u0438 \u0432\u044B\u0431\u0435\u0433\u0430\u0435\u0442
    \u043D\u0430\u0440\u0443\u0436\u0443. \u0412\u044B \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B.
    \u0412\u044B \u043F\u043E\u0431\u0435\u0434\u0438\u043B\u0438, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0432
    \u0441\u0430\u043C\u044B\u0439 \u043D\u0435\u043B\u043E\u0433\u0438\u0447\u043D\u044B\u0439,
    \u043D\u043E \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0439
    \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u0441\u0432\u0435\u0442\u0430"
