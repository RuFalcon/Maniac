  - "\u0422\u0432\u043E\u0438 \u0434\u0430\u043D\u043D\u044B\u0435... \u043E\u043D\u0438
    \u0446\u0435\u043D\u043D\u044B\u0435. \u0420\u0430\u0437\u0431\u043E\u0440 \u0442\u0435\u0431\u044F
    \u043D\u0430 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u044B \u0434\u0430\u0441\u0442
    \u043D\u0430\u043C \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E
    \u043E \u0432\u0430\u0448\u0435\u0439 \u0431\u0438\u043E\u043B\u043E\u0433\u0438\u0438.
    \u041D\u043E \u0438\u0437\u0443\u0447\u0435\u043D\u0438\u0435 \u0442\u0432\u043E\u0435\u0433\u043E
    \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0432 \u0436\u0438\u0432\u043E\u043C
    \u0432\u0438\u0434\u0435 \u043C\u043E\u0436\u0435\u0442 \u0434\u0430\u0442\u044C
    \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u0431\u043E\u043B\u044C\u0448\u0435. "
  - "\u042D\u0442\u043E \u0434\u0438\u043B\u0435\u043C\u043C\u0430. \u042D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C
    \u043F\u0440\u043E\u0442\u0438\u0432 \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B\u0430.
