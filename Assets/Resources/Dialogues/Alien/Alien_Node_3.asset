  - "<\u0421\u0442\u0430\u0442\u0443\u0441 \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D
    \u0441 \"\u0411\u0438\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043E\u0431\u0440\u0430\u0437\u0435\u0446\" \u043D\u0430 \"\u041F\u0440\u0438\u043C\u0438\u0442\u0438\u0432\u043D\u043E\u0435
    \u0440\u0430\u0437\u0443\u043C\u043D\u043E\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\".>"
  - "\u0422\u0432\u043E\u0439 \u0441\u0442\u0430\u0442\u0443\u0441 \u0438\u0437\u043C\u0435\u043D\u0435\u043D.
    \u041F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u0430 \"\u0440\u0430\u0437\u0431\u043E\u0440
    \u043D\u0430 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u044B\" \u043E\u0442\u043B\u043E\u0436\u0435\u043D\u0430.
    \u0422\u0435\u043F\u0435\u0440\u044C \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F
    \"\u0438\u0437\u0443\u0447\u0435\u043D\u0438\u0435 \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0447\u0435\u0441\u043A\u0438\u0445
    \u043C\u043E\u0434\u0435\u043B\u0435\u0439\". \u042F \u043F\u043E\u043A\u0430\u0436\u0443
    \u0442\u0435\u0431\u0435 \u0437\u0430\u043F\u0438\u0441\u044C."
  - "(\u041D\u0430 \u0441\u0442\u0435\u043D\u0435 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0432\u0438\u0434\u0435\u043E: \u0432\u043E\u043B\u043A \u043E\u0445\u043E\u0442\u0438\u0442\u0441\u044F
    \u043D\u0430 \u043E\u043B\u0435\u043D\u044F). \u042D\u0442\u043E - \u0431\u0430\u0437\u043E\u0432\u0430\u044F
    \u043C\u043E\u0434\u0435\u043B\u044C \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
