  maniacProfile: {fileID: 11400000, guid: 9c2c39d161f8bf64393bfe480d88b367, type: 2}
  maniacMessages:
  - "(\u0420\u0430\u0441\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442 \u043F\u043B\u0435\u0447\u0438,
    \u044F\u0432\u043D\u043E \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u0439).
    \u0414\u0430! \u042F - \u043F\u043E\u0440\u043E\u0436\u0434\u0435\u043D\u0438\u0435
    \u0442\u044C\u043C\u044B! \u0422\u0440\u0435\u043F\u0435\u0449\u0438!"
  - "\u041F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u044F \u0432\u043A\u0443\u0448\u0443
    \u0442\u0432\u043E\u0435\u0439 \u043A\u0440\u043E\u0432\u0438, \u043C\u044B \u0434\u043E\u043B\u0436\u043D\u044B
    \u0441\u043E\u0431\u043B\u044E\u0441\u0442\u0438 \u0440\u0438\u0442\u0443\u0430\u043B.
    \u0422\u0430\u043A \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E \u0432 \"\u041D\u0435\u043A\u0440\u043E\u043D\u043E\u043C\u0438\u043A\u043E\u043D\u0435
    \u0434\u043B\u044F \u0447\u0430\u0439\u043D\u0438\u043A\u043E\u0432\", \u0433\u043B\u0430\u0432\u0430
    3."
  - "\u0422\u044B \u0434\u043E\u043B\u0436\u0435\u043D \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u043D\u043E
    \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u043C\u043D\u0435
    \u0441\u0432\u043E\u044E \u0448\u0435\u044E. \u041D\u043E, \u0447\u0442\u043E\u0431\u044B
    \u0431\u044B\u043B\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u0435\u0435,
    \u044F \u0437\u0430\u0433\u0430\u0434\u0430\u044E \u0442\u0435\u0431\u0435 \u0437\u0430\u0433\u0430\u0434\u043A\u0443."
  - "\u042F \u043D\u0435 \u0438\u043C\u0435\u044E \u0433\u043E\u043B\u043E\u0441\u0430,
    \u043D\u043E \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u044E
    \u0438\u0441\u0442\u043E\u0440\u0438\u0438. \u0423 \u043C\u0435\u043D\u044F \u043D\u0435\u0442
    \u043D\u043E\u0433, \u043D\u043E \u044F \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0443\u044E
    \u043F\u043E \u0432\u0441\u0435\u043C\u0443 \u043C\u0438\u0440\u0443. \u0427\u0442\u043E
    \u044F?"
  playerChoices:
  - choiceText: "\u041A\u043D\u0438\u0433\u0430."
    nextNode: {fileID: 11400000, guid: 888bb94615e7a024bb34691011e49685, type: 2}
    isCorrectChoice: 1
    maniacResponseOnFail: 
    failureOutcomeText: 
  - choiceText: "\u0412\u0430\u043C\u043F\u0438\u0440."
    nextNode: {fileID: 11400000, guid: 43dfead3303a22047809afe7de6028fd, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u042F?! \u041D\u0435\u0442! \u0423 \u043C\u0435\u043D\u044F
      \u0435\u0441\u0442\u044C \u0433\u043E\u043B\u043E\u0441! \u0418 \u044F \u043C\u043E\u0433\u0443
      \u043B\u0435\u0442\u0430\u0442\u044C! \u041D\u0443... \u043F\u043E\u0447\u0442\u0438.
      \u0423\u0447\u0443\u0441\u044C. \u041E\u0442\u0432\u0435\u0442 \u043D\u0435\u0432\u0435\u0440\u043D\u044B\u0439!"
    failureOutcomeText: "\u041E\u043D \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F
      \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0442\u044C\u0441\u044F \u0432
      \u043B\u0435\u0442\u0443\u0447\u0443\u044E \u043C\u044B\u0448\u044C, \u043D\u043E
      \u0443 \u043D\u0435\u0433\u043E \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F
      \u043B\u0438\u0448\u044C \u0433\u0440\u043E\u043C\u043A\u043E \u043F\u0438\u0441\u043A\u043D\u0443\u0442\u044C
      \u0438 \u043F\u043E\u0434\u043F\u0440\u044B\u0433\u043D\u0443\u0442\u044C \u043D\u0430
      \u043C\u0435\u0441\u0442\u0435"
  - choiceText: "\u0410 \u0432 \"\u041D\u0435\u043A\u0440\u043E\u043D\u043E\u043C\u0438\u043A\u043E\u043D\u0435\"
      \u043D\u0435 \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E, \u0447\u0442\u043E
      \u0432\u0430\u043C\u043F\u0438\u0440\u044B \u0431\u043E\u044F\u0442\u0441\u044F
      \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u043E\u0433\u043E \u0441\u0432\u0435\u0442\u0430?"
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0421\u043E\u043B\u043D\u0435\u0447\u043D\u043E\u0433\u043E
      \u0441\u0432\u0435\u0442\u0430? \u041A\u043E\u043D\u0435\u0447\u043D\u043E!
      \u041D\u043E \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u043E\u0447\u044C!
      \u0418 \u0432 \u044D\u0442\u043E\u043C \u0441\u043A\u043B\u0435\u043F\u0435
      \u043D\u0435\u0442 \u043E\u043A\u043E\u043D! \u0422\u044B \u0432 \u043C\u043E\u0435\u0439
      \u0432\u043B\u0430\u0441\u0442\u0438!"
    failureOutcomeText: "\u041E\u043D \u043D\u0435\u0440\u0432\u043D\u043E \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F,
      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u044F, \u043D\u0435\u0442 \u043B\u0438
      \u0449\u0435\u043B\u0435\u0439 \u0432 \u043F\u043E\u0442\u043E\u043B\u043A\u0435.
      \u0412\u044B \u0432\u0438\u0434\u0438\u0442\u0435 \u0435\u0433\u043E \u0443\u044F\u0437\u0432\u0438\u043C\u043E\u0441\u0442\u044C"
  victoryMessage: 
