  maniacProfile: {fileID: 11400000, guid: 9c2c39d161f8bf64393bfe480d88b367, type: 2}
  maniacMessages:
  - "\u0412\u0435\u0440\u043D\u043E! \u0422\u044B \u0442\u0430\u043A \u0443\u043C\u0435\u043D
    \u0434\u043B\u044F... \u0435\u0434\u044B. \u041C\u043D\u0435 \u043F\u043E\u0447\u0442\u0438
    \u0436\u0430\u043B\u044C \u0442\u0435\u0431\u044F."
  - "\u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u0441\u0442\u0430\u0442\u044C
    \u0442\u0430\u043A\u0438\u043C \u0436\u0435, \u043A\u0430\u043A \u044F. \u0411\u0435\u0441\u0441\u043C\u0435\u0440\u0442\u043D\u044B\u043C.
    \u0421\u0438\u043B\u044C\u043D\u044B\u043C. \u0418\u043B\u0438 \u043C\u043E\u0436\u0435\u0448\u044C
    \u043F\u0440\u043E\u0441\u0442\u043E \u0443\u043C\u0435\u0440\u0435\u0442\u044C.
    \u0427\u0442\u043E \u0442\u044B \u0432\u044B\u0431\u0435\u0440\u0435\u0448\u044C?"
  playerChoices:
  - choiceText: "\u042F \u0432\u044B\u0431\u0438\u0440\u0430\u044E \u0431\u0435\u0441\u0441\u043C\u0435\u0440\u0442\u0438\u0435!"
    nextNode: {fileID: 11400000, guid: 43dfead3303a22047809afe7de6028fd, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041C\u0443\u0434\u0440\u044B\u0439 \u0432\u044B\u0431\u043E\u0440!
      \u0422\u044B \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0448\u044C\u0441\u044F
      \u043A\u043E \u043C\u043D\u0435 \u0432 \u0432\u0435\u0447\u043D\u043E\u0439
      \u043D\u043E\u0447\u0438!"
    failureOutcomeText: "\u041E\u043D \u0433\u043E\u0442\u043E\u0432\u0438\u0442\u0441\u044F
      \u0432\u0430\u0441 \u0443\u043A\u0443\u0441\u0438\u0442\u044C, \u0447\u0442\u043E\u0431\u044B
      \"\u043E\u0431\u0440\u0430\u0442\u0438\u0442\u044C\". \u0418\u0433\u0440\u0430
      \u043F\u0440\u043E\u0438\u0433\u0440\u0430\u043D\u0430"
  - choiceText: "\u042F \u043B\u0443\u0447\u0448\u0435 \u0443\u043C\u0440\u0443,
      \u0447\u0435\u043C \u0441\u0442\u0430\u043D\u0443 \u0442\u0430\u043A\u0438\u043C,
      \u043A\u0430\u043A \u0442\u044B!"
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041A\u0430\u043A \u043F\u043E\u0436\u0435\u043B\u0430\u0435\u0448\u044C.
      \u0422\u0432\u043E\u044F \u0441\u043C\u0435\u043B\u043E\u0441\u0442\u044C \u0434\u0435\u043B\u0430\u0435\u0442
      \u0442\u0432\u043E\u044E \u043A\u0440\u043E\u0432\u044C \u043B\u0438\u0448\u044C
      \u0441\u043B\u0430\u0449\u0435."
    failureOutcomeText: "\u041E\u043D \u0433\u043E\u0442\u043E\u0432\u0438\u0442\u0441\u044F
      \u0432\u0430\u0441 \u0443\u043A\u0443\u0441\u0438\u0442\u044C, \u0447\u0442\u043E\u0431\u044B
      \u0443\u0431\u0438\u0442\u044C"
  - choiceText: "\u0410 \u043A\u0430\u043A\u0438\u0435 \u043C\u0438\u043D\u0443\u0441\u044B?
      \u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u043A\u0430\u043A \u0443
      \u0432\u0430\u0441 \u0441 \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u043E\u0439
      \u0435\u0434\u044B? \u0418 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u043B\u0438 \u0437\u0434\u0435\u0441\u044C \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442?"
