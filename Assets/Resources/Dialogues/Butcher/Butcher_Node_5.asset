  victoryMessage: "\u0412\u044B \u043D\u0430\u0436\u0438\u043C\u0430\u0435\u0442\u0435
    \u043D\u0430 \u043A\u043D\u043E\u043F\u043A\u0443 \u0438 \u0441 \u043E\u0433\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C
    \u0441\u043A\u0440\u0435\u0436\u0435\u0442\u043E\u043C \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F
    \u043A\u043E\u043D\u0432\u0435\u0439\u0435\u0440\u043D\u0430\u044F \u043B\u0435\u043D\u0442\u0430
    \u0441 \u043A\u0440\u044E\u043A\u0430\u043C\u0438, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
    \u0432\u0438\u0441\u044F\u0442 \u0442\u0443\u0448\u0438. \u041E\u043D\u0438 \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442
    \u0431\u044B\u0441\u0442\u0440\u043E \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F
    \u043F\u043E \u043A\u043E\u043C\u043D\u0430\u0442\u0435, \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u044F
    \u0445\u0430\u043E\u0441 \u0438 \u0448\u0443\u043C. \u041E\u0434\u043D\u0430
    \u0438\u0437 \u0442\u0443\u0448 \u0441\u0431\u0438\u0432\u0430\u0435\u0442 \u041C\u044F\u0441\u043D\u0438\u043A\u0430
    \u0441 \u043D\u043E\u0433. \u041F\u043E\u043A\u0430 \u043E\u043D \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F
    \u0432\u0441\u0442\u0430\u0442\u044C, \u0432\u044B \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u0442\u0435
