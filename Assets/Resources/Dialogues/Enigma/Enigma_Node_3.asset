  maniacProfile: {fileID: 11400000, guid: b29c420f9f697854d95b82fb1e8d9bbc, type: 2}
  maniacMessages:
  - "\u0412\u0435\u0440\u043D\u043E. \u0422\u044B \u0443\u043C\u043D\u0435\u0435,
    \u0447\u0435\u043C \u043A\u0430\u0436\u0435\u0448\u044C\u0441\u044F. \u042D\u0442\u043E
    \u0434\u0435\u043B\u0430\u0435\u0442 \u0438\u0433\u0440\u0443 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u0435\u0435."
  - "\u0412\u0442\u043E\u0440\u043E\u0439 \u0432\u043E\u043F\u0440\u043E\u0441. \u042F
    \u0432\u0441\u0435\u0433\u0434\u0430 \u0433\u043E\u043B\u043E\u0434\u043D\u0430.
    \u0415\u0441\u043B\u0438 \u043C\u0435\u043D\u044F \u043D\u0435 \u043A\u043E\u0440\u043C\u0438\u0442\u044C,
    \u044F \u0443\u043C\u0440\u0443. \u041D\u043E \u0447\u0442\u043E \u0431\u044B
    \u044F \u043D\u0438 \u0432\u044B\u043F\u0438\u043B\u0430, \u044F \u0432\u0441\u0435
    \u0440\u0430\u0432\u043D\u043E \u0443\u043C\u0438\u0440\u0430\u044E. \u0427\u0442\u043E
    \u044F?"
  playerChoices:
  - choiceText: "\u0416\u0430\u0434\u043D\u043E\u0441\u0442\u044C"
    nextNode: {fileID: 11400000, guid: 43dfead3303a22047809afe7de6028fd, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0424\u0438\u043B\u043E\u0441\u043E\u0444\u0441\u0442\u0432\u0443\u0435\u0448\u044C?
      \u041D\u0435\u0432\u0435\u0440\u043D\u043E. \u0416\u0430\u0434\u043D\u043E\u0441\u0442\u044C
      \u043B\u0438\u0448\u044C \u0440\u0430\u0441\u0442\u0435\u0442, \u043A\u043E\u0433\u0434\u0430
      \u0435\u0435 \u043A\u043E\u0440\u043C\u044F\u0442. \u0410 \u044F - \u0443\u043C\u0438\u0440\u0430\u044E."
    failureOutcomeText: "\u0412\u044B \u0441\u043B\u044B\u0448\u0438\u0442\u0435
      \u0449\u0435\u043B\u0447\u043E\u043A \u0437\u0430\u043C\u043A\u0430. \u041E\u0434\u043D\u0430
      \u0438\u0437 \u0441\u0442\u0435\u043D \u043A\u043E\u043C\u043D\u0430\u0442\u044B
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0432 \u0432\u0430\u0448\u0443
      \u0441\u0442\u043E\u0440\u043E\u043D\u0443"
  - choiceText: "\u0422\u0432\u043E\u044F \u0441\u0430\u043C\u043E\u043E\u0446\u0435\u043D\u043A\u0430"
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041E\u043F\u044F\u0442\u044C \u0434\u0435\u0440\u0437\u043E\u0441\u0442\u044C?
      \u0422\u044B \u043F\u044B\u0442\u0430\u0435\u0448\u044C\u0441\u044F \u0432\u044B\u0432\u0435\u0441\u0442\u0438
      \u043C\u0435\u043D\u044F \u0438\u0437 \u0441\u0435\u0431\u044F? \u0423 \u0442\u0435\u0431\u044F
      \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F. \u0410
      \u0432\u043E\u0442 \u0443 \u043C\u0435\u043D\u044F \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F
      \u0432\u044B\u0432\u0435\u0441\u0442\u0438 \u0442\u0435\u0431\u044F... \u0438\u0437
      \u0436\u0438\u0437\u043D\u0438."
    failureOutcomeText: "\u041F\u043E\u0442\u043E\u043B\u043E\u043A \u043D\u0430\u0434
      \u0432\u0430\u043C\u0438 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u043E\u043F\u0443\u0441\u043A\u0430\u0442\u044C\u0441\u044F"
