  maniacProfile: {fileID: 11400000, guid: 294eb8842c28d544180a74cc5ee30bab, type: 2}
  maniacMessages:
  - "\u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0431\u043E\u0438\u0448\u044C\u0441\u044F?
    \u0412\u0440\u0435\u0448\u044C! \u0412\u0441\u0435 \u0447\u0435\u0433\u043E-\u0442\u043E
    \u0431\u043E\u044F\u0442\u0441\u044F. \u041D\u043E... \u043C\u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F
    \u0442\u0432\u043E\u044F \u0431\u0440\u0430\u0432\u0430\u0434\u0430. \u0422\u044B
    \u043D\u0435 \u043F\u043E\u0445\u043E\u0436 \u043D\u0430 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445."
  - "\u041E\u043D\u0438 \u043F\u043B\u0430\u0447\u0443\u0442. \u0422\u044B - \u043D\u0435\u0442.
    \u0425\u043E\u0440\u043E\u0448\u043E. \u0422\u043E\u0433\u0434\u0430 \u0434\u0430\u0432\u0430\u0439
    \u044F \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443 \u0442\u0435\u0431\u0435
    \u0441\u0432\u043E\u0439 \u0441\u0442\u0440\u0430\u0445. \u042F \u0431\u043E\u044E\u0441\u044C...
    \u043E\u0433\u043D\u044F."
  - "\u0422\u044B \u043C\u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0448\u044C\u0441\u044F.
    \u0422\u044B \u043D\u0435 \u043F\u043B\u0430\u0447\u0435\u0448\u044C. \u0422\u044B
    \u043D\u0435 \u043F\u0440\u043E\u0441\u0438\u0448\u044C. \u0422\u044B \u0434\u0435\u0440\u0437\u0438\u0448\u044C.
    \u042F \u0445\u043E\u0447\u0443 \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0442\u0435\u0431\u044F
    \u0447\u0430\u0441\u0442\u044C\u044E \u043D\u0430\u0448\u0435\u0433\u043E \u0434\u0443\u044D\u0442\u0430.
    \u041D\u043E \u043C\u0435\u0441\u0442\u043E \u0442\u043E\u043B\u044C\u043A\u043E
    \u043E\u0434\u043D\u043E. \u041C\u0435\u0441\u0442\u043E \u0410\u0440\u0442\u0443\u0440\u0430.
    \u041E\u043D \u0443\u0436\u0435 \u0441\u0442\u0430\u0440\u044B\u0439 \u0438 \u0441\u043A\u0443\u0447\u043D\u044B\u0439."
  - "\u042F \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u044E \u0442\u0435\u0431\u0435
    \u0441\u0434\u0435\u043B\u043A\u0443. \u0412\u043E\u043D \u0442\u0430\u043C,
    \u043D\u0430 \u0432\u0435\u0440\u0441\u0442\u0430\u043A\u0435, \u043B\u0435\u0436\u0438\u0442
    \u043A\u0430\u043D\u0438\u0441\u0442\u0440\u0430 \u0441 \u0431\u0435\u043D\u0437\u0438\u043D\u043E\u043C
    \u0438 \u0437\u0430\u0436\u0438\u0433\u0430\u043B\u043A\u0430. \u041F\u043E\u0434\u043E\u0436\u0433\u0438
    \u0410\u0440\u0442\u0443\u0440\u0430. \u0418 \u0442\u044B \u0441\u0442\u0430\u043D\u0435\u0448\u044C
    \u043C\u043E\u0438\u043C \u043D\u043E\u0432\u044B\u043C \u043B\u0443\u0447\u0448\u0438\u043C
    \u0434\u0440\u0443\u0433\u043E\u043C. \u041D\u0430\u0432\u0441\u0435\u0433\u0434\u0430."
  playerChoices:
  - choiceText: "\u042F \u043D\u0435 \u0443\u0431\u0438\u0439\u0446\u0430!"
    nextNode: {fileID: 11400000, guid: 43dfead3303a22047809afe7de6028fd, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041D\u0435 \u0443\u0431\u0438\u0439\u0446\u0430? \u0410
      \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F \u0441\u0442\u0430\u0442\u044C!
      \u0418\u043D\u0430\u0447\u0435 \u0440\u0435\u043A\u0432\u0438\u0437\u0438\u0442\u043E\u043C
      \u0441\u0442\u0430\u043D\u0435\u0448\u044C \u0442\u044B!"
    failureOutcomeText: "\u0410\u0440\u0442\u0443\u0440 \u0432\u0441\u0442\u0430\u0435\u0442
      \u0438 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u0438\u0434\u0435\u0442
      \u043A \u0432\u0435\u0440\u0441\u0442\u0430\u043A\u0443 \u0437\u0430 \u043A\u0430\u043D\u0438\u0441\u0442\u0440\u043E\u0439"
  - choiceText: "\u0410 \u0447\u0442\u043E, \u0435\u0441\u043B\u0438 \u044F \u043F\u043E\u0434\u043E\u0436\u0433\u0443
      \u0442\u0435\u0431\u044F?"
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041C\u0435\u043D\u044F? \u0422\u044B \u0436\u0435 \u0437\u043D\u0430\u0435\u0448\u044C,
      \u0447\u0435\u0433\u043E \u044F \u0431\u043E\u044E\u0441\u044C! \u0422\u044B
      \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u0445\u043E\u0447\u0435\u0448\u044C
      \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043C\u043D\u0435 \u0431\u043E\u043B\u044C\u043D\u043E!
      \u0410\u0440\u0442\u0443\u0440, \u043E\u043D \u043F\u043B\u043E\u0445\u043E\u0439!
      \u041D\u0430\u043A\u0430\u0436\u0438 \u0435\u0433\u043E!"
    failureOutcomeText: "\u0410\u0440\u0442\u0443\u0440 \u0445\u0432\u0430\u0442\u0430\u0435\u0442
      \u0441\u043E \u0441\u0442\u043E\u043B\u0430 \u043E\u0441\u0442\u0440\u044B\u0439
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442 \u0438 \u0431\u0440\u043E\u0441\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0432\u0430\u0441"
  - choiceText: "(\u041E\u0431\u0440\u0430\u0442\u0438\u0442\u044C\u0441\u044F \u043A
      \u0410\u0440\u0442\u0443\u0440\u0443) \u0410\u0440\u0442\u0443\u0440, \u0442\u044B
