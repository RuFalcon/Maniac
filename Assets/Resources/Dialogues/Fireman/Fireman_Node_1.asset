  maniacMessages:
  - "\u0412\u043D\u0438\u043C\u0430\u043D\u0438\u0435. \u041E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u043E
    \u0432\u043E\u0437\u0433\u043E\u0440\u0430\u043D\u0438\u0435 \u043A\u043B\u0430\u0441\u0441\u0430
    \"\u0427\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0430\u044F \u0441\u043A\u0432\u0435\u0440\u043D\u0430\".
    \u041D\u0430\u0447\u0430\u0442\u0430 \u043F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u0430
    \u0442\u0435\u0440\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u043E\u0447\u0438\u0449\u0435\u043D\u0438\u044F.
    \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0439\u0442\u0435
    \u0441\u043F\u043E\u043A\u043E\u0439\u0441\u0442\u0432\u0438\u0435."
  - "\u041E\u0433\u043E\u043D\u044C - \u044D\u0442\u043E \u043D\u0435 \u043A\u043E\u043D\u0435\u0446.
    \u042D\u0442\u043E - \u043D\u0430\u0447\u0430\u043B\u043E. \u042D\u0442\u043E
    - \u043E\u0447\u0438\u0449\u0435\u043D\u0438\u0435. \u0427\u0442\u043E\u0431\u044B
    \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u044C, \u0447\u0442\u043E \u0432\u044B
    \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u044B \u043E\u0447\u0438\u0449\u0435\u043D\u0438\u044F,
    \u043F\u0440\u043E\u0439\u0434\u0438\u0442\u0435 \u043F\u0435\u0440\u0432\u043E\u0435
    \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435. \u0427\u0442\u043E \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0433\u043B\u0430\u0432\u043D\u044B\u043C \u0432\u0440\u0430\u0433\u043E\u043C
    \u043E\u0433\u043D\u044F?"
  playerChoices:
  - choiceText: "\u0412\u043E\u0434\u0430."
    nextNode: {fileID: 11400000, guid: 072ff9f99473c214d940fa9bc8ef6f07, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0412\u043E\u0434\u0430... \u0411\u0430\u043D\u0430\u043B\u044C\u043D\u043E.
      \u0412\u043E\u0434\u0430 \u043B\u0438\u0448\u044C \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
      \u0443\u0441\u043C\u0438\u0440\u044F\u0435\u0442 \u043F\u043B\u0430\u043C\u044F,
      \u043D\u043E \u043D\u0435 \u043F\u043E\u0431\u0435\u0436\u0434\u0430\u0435\u0442
      \u0435\u0433\u043E \u0434\u0443\u0445. \u0412\u044B \u043C\u044B\u0441\u043B\u0438\u0442\u0435
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u043D\u043E."
    failureOutcomeText: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430 \u043F\u043E\u0436\u0430\u0440\u043E\u0442\u0443\u0448\u0435\u043D\u0438\u044F
      \u043D\u0430\u0434 \u0432\u0430\u043C\u0438 \u0441\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442,
      \u043D\u043E \u0432\u043C\u0435\u0441\u0442\u043E \u0432\u043E\u0434\u044B
      \u043E\u0431\u0440\u0443\u0448\u0438\u0432\u0430\u0435\u0442 \u043D\u0430 \u0432\u0430\u0441
      \u043F\u043E\u0442\u043E\u043A \u0435\u0434\u043A\u043E\u0439 \u043F\u0435\u043D\u044B,
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0437\u0430\u0442\u0440\u0443\u0434\u043D\u044F\u0435\u0442
      \u0434\u044B\u0445\u0430\u043D\u0438\u0435"
  - choiceText: "\u041E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043A\u0438\u0441\u043B\u043E\u0440\u043E\u0434\u0430."
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041A\u0438\u0441\u043B\u043E\u0440\u043E\u0434... \u041D\u0430\u0443\u0447\u043D\u043E,
      \u043D\u043E \u0431\u0435\u0437\u0434\u0443\u0448\u043D\u043E. \u041E\u0433\u043E\u043D\u044C
      - \u044D\u0442\u043E \u0436\u0438\u0432\u0430\u044F \u0441\u0443\u0449\u043D\u043E\u0441\u0442\u044C,
      \u0430 \u043D\u0435 \u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u0430\u044F
