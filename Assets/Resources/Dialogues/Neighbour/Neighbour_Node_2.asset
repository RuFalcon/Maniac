  maniacProfile: {fileID: 11400000, guid: 94b8fa27113364348bb60942521a3991, type: 2}
  maniacMessages:
  - "\u0421 \u043D\u0435\u0439 \u0432\u0441\u0435 \u0442\u0430\u043A. \u0418 \u043D\u0435
    \u0442\u0430\u043A \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E.
    \u0422\u044B \u0432\u0437\u044F\u043B \u0435\u0435. \u0422\u044B \u0441\u0432\u0435\u0440\u043B\u0438\u043B
    \u0435\u0439 \u0441\u0442\u0435\u043D\u044B. \u0422\u044B \u0432\u0435\u0440\u043D\u0443\u043B
    \u0435\u0435. \u041D\u043E \u0442\u044B \u043D\u0435 \u0441\u043F\u0440\u043E\u0441\u0438\u043B,
    \u043A\u0430\u043A \u0443 \u041D\u0415\u0401 \u0434\u0435\u043B\u0430."
  - "\u041E\u043D\u0430... \u0436\u0430\u043B\u043E\u0432\u0430\u043B\u0430\u0441\u044C.
    \u0422\u044B \u0434\u0430\u0432\u0438\u043B \u043D\u0430 \u043D\u0435\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
    \u0441\u0438\u043B\u044C\u043D\u043E. \u0422\u044B \u0434\u0430\u0436\u0435 \u043D\u0435
    \u043F\u0440\u043E\u0442\u0435\u0440 \u0435\u0435 \u043E\u0442 \u043F\u044B\u043B\u0438
    \u043F\u043E\u0441\u043B\u0435 \u0440\u0430\u0431\u043E\u0442\u044B. \u041E\u043D\u0430
    \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442 \u0441\u0435\u0431\u044F
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u043D\u043E\u0439
    \u0438 \u0443\u043D\u0438\u0436\u0435\u043D\u043D\u043E\u0439. \u0422\u044B \u0434\u043E\u043B\u0436\u0435\u043D
    \u0438\u0437\u0432\u0438\u043D\u0438\u0442\u044C\u0441\u044F."
  playerChoices:
  - choiceText: "\u0418\u0437\u0432\u0438\u043D\u0438\u0442\u044C\u0441\u044F? \u041F\u0435\u0440\u0435\u0434
      \u0434\u0440\u0435\u043B\u044C\u044E? \u0422\u044B \u0441 \u0443\u043C\u0430
      \u0441\u043E\u0448\u0435\u043B?"
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u042F \u043D\u0435 \u0441\u043E\u0448\u0435\u043B \u0441
      \u0443\u043C\u0430! \u042D\u0442\u043E \u0422\u042B \u0431\u0435\u0441\u0447\u0443\u0432\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439!
      \u0422\u044B \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C
      \u0435\u0435 \u0441\u0442\u0440\u0430\u0434\u0430\u043D\u0438\u0439!"
    failureOutcomeText: "\u041E\u043D \u0432 \u044F\u0440\u043E\u0441\u0442\u0438
      \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442 \u0434\u0440\u0435\u043B\u044C.
      \u0417\u0432\u0443\u043A \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0449\u0435\u0433\u043E
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430 \u0432 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0439
      \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0435 \u043E\u0433\u043B\u0443\u0448\u0430\u0435\u0442
      \u0438 \u043F\u0443\u0433\u0430\u0435\u0442"
  - choiceText: "\u0425\u043E\u0440\u043E\u0448\u043E... \u0414\u0440\u0435\u043B\u044C,
      \u043F\u0440\u043E\u0441\u0442\u0438 \u043C\u0435\u043D\u044F, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430.
      \u042F \u0431\u044B\u043B \u043D\u0435\u043F\u0440\u0430\u0432."
    nextNode: {fileID: 11400000, guid: 7f0d1bb4d691ccb40bfedf920f0a9488, type: 2}
    isCorrectChoice: 1
    maniacResponseOnFail: 
    failureOutcomeText: 
  - choiceText: "\u041B\u0451\u0445, \u043C\u043E\u0436\u0435\u0442, \u0442\u0435\u0431\u0435
      \u0441\u0442\u043E\u0438\u0442 \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C?
      \u0412\u044B\u043F\u0438\u0442\u044C \u0447\u0430\u044E?"
    nextNode: {fileID: 11400000, guid: 43dfead3303a22047809afe7de6028fd, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0427\u0430\u044E? \u0422\u044B \u043F\u044B\u0442\u0430\u0435\u0448\u044C\u0441\u044F
      \u043E\u0442\u0432\u043B\u0435\u0447\u044C \u043C\u0435\u043D\u044F! \u0422\u044B
      \u0434\u0443\u043C\u0430\u0435\u0448\u044C, \u044F \u0434\u0443\u0440\u0430\u043A?"
    failureOutcomeText: "\u041E\u043D \u0434\u0435\u043B\u0430\u0435\u0442 \u0448\u0430\u0433
      \u043A \u0432\u0430\u043C \u0438 \u0432\u044B \u0432\u0438\u0434\u0438\u0442\u0435,
