  maniacMessages:
  - "(\u041E\u0431\u0449\u0430\u0435\u0442\u0441\u044F \u0441 \u0432\u0430\u043C\u0438
    \u0447\u0435\u0440\u0435\u0437 \u0421\u041C\u0421, \u0445\u043E\u0442\u044F \u0441\u0442\u043E\u0438\u0442
    \u0432 \u0434\u0432\u0443\u0445 \u043C\u0435\u0442\u0440\u0430\u0445). \u041F\u0440\u0438\u0432\u0435\u0442.
    \u041C\u044B \u0442\u0430\u043A \u0438 \u043D\u0435 \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438
    \u043D\u0430\u0441\u0447\u0435\u0442 \u0434\u0440\u0435\u043B\u0438."
  playerChoices:
  - choiceText: "\u041B\u0451\u0445\u0430, \u0447\u0442\u043E \u0437\u0430 \u0447\u0435\u0440\u0442?
      \u041A\u0430\u043A\u043E\u0433\u043E \u0445\u0440\u0435\u043D\u0430 \u0442\u044B
      \u0437\u0430\u043F\u0435\u0440 \u0434\u0432\u0435\u0440\u044C?"
    nextNode: {fileID: 11400000, guid: 072ff9f99473c214d940fa9bc8ef6f07, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0422\u0438\u0448\u0435, \u0442\u0438\u0448\u0435. \u0417\u0430\u0447\u0435\u043C
      \u0442\u0430\u043A \u043D\u0435\u0440\u0432\u043D\u0438\u0447\u0430\u0442\u044C?
      \u041D\u0435\u0440\u0432\u043D\u044B\u0435 \u043B\u044E\u0434\u0438 \u0434\u0435\u043B\u0430\u044E\u0442
      \u043E\u0448\u0438\u0431\u043A\u0438. \u0410 \u043E\u0448\u0438\u0431\u043E\u043A
      \u044F \u043D\u0435 \u043F\u0440\u043E\u0449\u0430\u044E."
    failureOutcomeText: "\u041E\u043D \u0443\u0433\u0440\u043E\u0436\u0430\u044E\u0449\u0435
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0434\u0440\u0435\u043B\u044C
      \u0438 \u0432\u044B \u0432\u0438\u0434\u0438\u0442\u0435, \u0447\u0442\u043E
      \u0432 \u043D\u0435\u0435 \u0432\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043E
      \u043E\u0447\u0435\u043D\u044C \u0434\u043B\u0438\u043D\u043D\u043E\u0435 \u0438
      \u043E\u0441\u0442\u0440\u043E\u0435 \u0441\u0432\u0435\u0440\u043B\u043E"
  - choiceText: "\u0410, \u0434\u0440\u0435\u043B\u044C! \u0422\u043E\u0447\u043D\u043E.
      \u0418\u0437\u0432\u0438\u043D\u0438, \u0437\u0430\u043C\u043E\u0442\u0430\u043B\u0441\u044F. "
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0414\u0443\u043C\u0430\u0435\u0448\u044C, \u043C\u043E\u0436\u043D\u043E
      \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0430\u043A \u0432\u0435\u0440\u043D\u0443\u0442\u044C?
      \u041F\u043E\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0441\u044F
      \u0438 \u043E\u0442\u0434\u0430\u043B? \u041D\u0435\u0442. \u0422\u044B \u043D\u0430\u0440\u0443\u0448\u0438\u043B...
      \u0431\u0430\u043B\u0430\u043D\u0441. \u0422\u0435\u043F\u0435\u0440\u044C
      \u043D\u0443\u0436\u043D\u043E \u0435\u0433\u043E \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C."
    failureOutcomeText: "\u041E\u043D \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u0438 \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442 \u0443 \u0432\u0430\u0441
