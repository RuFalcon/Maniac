  maniacProfile: {fileID: 11400000, guid: c50885fd6da1ab04ebf10ed8da37ca5a, type: 2}
  maniacMessages:
  - "(\u041F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u0432\u0430\u0441, \u043D\u043E
    \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0438\u0434\u0440\u0430\u0442\u044C\u0441\u044F).
    \u0411\u043E\u043B\u044C\u043D\u043E\u0439, \u0437\u043D\u0430\u0447\u0438\u0442...
    \u041B\u0430\u0434\u043D\u043E, \u043E\u0442\u043A\u043B\u044E\u0447\u0430\u0439\u0441\u044F."
  - "(\u0412\u044B \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0438
    \u0441\u0442\u0430\u0440\u044B\u0439 \u0442\u0440\u044E\u043A \u0441 \u043A\u0430\u0448\u043B\u0435\u043C
    - \u0441\u0438\u0433\u043D\u0430\u043B \u0431\u0435\u0434\u0441\u0442\u0432\u0438\u044F
    (SOS), \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432\u0430\u0448 \u0434\u0440\u0443\u0433
    \u043C\u043E\u0436\u0435\u0442 \u0440\u0430\u0441\u043F\u043E\u0437\u043D\u0430\u0442\u044C.
    \u0412\u044B \u043F\u043E\u0434\u0430\u043B\u0438 \u0441\u0438\u0433\u043D\u0430\u043B,
    \u043D\u0435 \u0432\u044B\u0437\u0432\u0430\u0432 \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u043D\u0438\u0439)"
  - "\u0415\u0441\u0442\u044C \u0445\u043E\u0447\u0443. \u0418\u0434\u0438 \u043D\u0430
    \u043A\u0443\u0445\u043D\u044E. \u041F\u0440\u0438\u043D\u0435\u0441\u0438 \u043C\u043D\u0435
    \u0435\u0434\u044B. \u041D\u043E \u0443\u0447\u0442\u0438, \u044F\u0434 \u0438\u043B\u0438
    \u0441\u0442\u0435\u043A\u043B\u043E \u0432 \u0435\u0434\u0435 \u044F \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E.
    \u0418 \u0442\u0435\u0431\u0435 \u044D\u0442\u043E \u043E\u0447\u0435\u043D\u044C
    \u043D\u0435 \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F. \u0427\u0442\u043E
    \u043F\u0440\u0438\u043D\u0435\u0441\u0435\u0448\u044C?"
  playerChoices:
  - choiceText: "\u041A\u043E\u043D\u0441\u0435\u0440\u0432\u044B \u0438 \u0445\u043B\u0435\u0431."
    nextNode: {fileID: 11400000, guid: 21c7a794c0b7f5646b6b19cf64d425f3, type: 2}
    isCorrectChoice: 1
    maniacResponseOnFail: 
    failureOutcomeText: 
  - choiceText: "(\u041F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C
      \u0433\u043E\u0440\u044F\u0447\u0438\u0439 \u0441\u0443\u043F)."
    nextNode: {fileID: 11400000, guid: 43dfead3303a22047809afe7de6028fd, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0413\u043E\u0442\u043E\u0432\u0438\u0442\u044C? \u0414\u0443\u043C\u0430\u0435\u0448\u044C,
      \u044F \u043F\u043E\u0437\u0432\u043E\u043B\u044E \u0442\u0435\u0431\u0435
      \u0441\u0442\u043E\u044F\u0442\u044C \u0443 \u043F\u043B\u0438\u0442\u044B
      \u0441 \u043D\u043E\u0436\u043E\u043C \u0432 \u0440\u0443\u043A\u0430\u0445?
      \u041D\u0430\u0438\u0432\u043D\u043E."
    failureOutcomeText: "\u041E\u043D \u0438\u0434\u0435\u0442 \u0437\u0430 \u0432\u0430\u043C\u0438
      \u043D\u0430 \u043A\u0443\u0445\u043D\u044E \u0438 \u0441\u0430\u043C \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442
      \u0435\u0434\u0443, \u0434\u0435\u0440\u0436\u0430 \u0432\u0430\u0441 \u043D\u0430
      \u043F\u0440\u0438\u0446\u0435\u043B\u0435"
  - choiceText: "\u0411\u0443\u0442\u044B\u043B\u043A\u0443 \u0432\u0438\u0441\u043A\u0438."
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0410\u043B\u043A\u043E\u0433\u043E\u043B\u044C? \u0425\u043E\u0447\u0435\u0448\u044C
      \u043C\u0435\u043D\u044F \u0441\u043F\u043E\u0438\u0442\u044C \u0438 \u0443\u0441\u044B\u043F\u0438\u0442\u044C?
      \u042F \u043D\u0435 \u043F\u044C\u044E \u043D\u0430 '\u0434\u0435\u043B\u0435'."
    failureOutcomeText: "\u041E\u043D \u0432\u044B\u043B\u0438\u0432\u0430\u0435\u0442
      \u0432\u0438\u0441\u043A\u0438 \u0432 \u0440\u0430\u043A\u043E\u0432\u0438\u043D\u0443
      \u0438 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0435\u0449\u0435
