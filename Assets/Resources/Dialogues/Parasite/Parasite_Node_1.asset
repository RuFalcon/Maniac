  maniacProfile: {fileID: 11400000, guid: 5dd6296d922f0e24b8e8dbc2240cf2c2, type: 2}
  maniacMessages:
  - "\u0422\u044F\u0436\u0435\u043B\u044B\u0439 \u0434\u0435\u043D\u044C, \u0434\u0430?
    \u042F \u0432\u0438\u0434\u0435\u043B. \u0422\u044B \u0441\u0442\u0430\u0440\u0430\u043B\u0441\u044F,
    \u043D\u043E \u043E\u043F\u044F\u0442\u044C \u043D\u0438\u0447\u0435\u0433\u043E
    \u043D\u0435 \u0432\u044B\u0448\u043B\u043E. \u041E\u0431\u0438\u0434\u043D\u043E,
    \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435."
  playerChoices:
  - choiceText: "\u041A\u0442\u043E \u0442\u044B \u0442\u0430\u043A\u043E\u0439?!
      \u0422\u044B \u0441\u043B\u0435\u0434\u0438\u0448\u044C \u0437\u0430 \u043C\u043D\u043E\u0439?"
    nextNode: {fileID: 11400000, guid: 072ff9f99473c214d940fa9bc8ef6f07, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0421\u043B\u0435\u0436\u0443? \u041D\u0435\u0442. \u042F
      \u043F\u0440\u043E\u0441\u0442\u043E... \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E.
      \u0422\u0432\u043E\u044F \u043F\u0430\u043D\u0438\u043A\u0430 \u2014 \u043E\u043D\u0430
      \u0442\u0430\u043A\u0430\u044F \u0441\u043B\u0430\u0434\u043A\u0430\u044F.
      \u0421\u043F\u0430\u0441\u0438\u0431\u043E."
    failureOutcomeText: "\u0412\u044B \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435,
      \u043A\u0430\u043A \u043F\u043E \u0441\u043F\u0438\u043D\u0435 \u043F\u0440\u043E\u0431\u0435\u0433\u0430\u0435\u0442
      \u0445\u043E\u043B\u043E\u0434, \u0430 \u0441\u0438\u043B\u044B \u043F\u043E\u043A\u0438\u0434\u0430\u044E\u0442
      \u0432\u0430\u0441 \u0435\u0449\u0435 \u0431\u043E\u043B\u044C\u0448\u0435"
  - choiceText: "\u0414\u0430, \u0434\u0435\u043D\u044C \u043F\u0430\u0440\u0448\u0438\u0432\u044B\u0439.
      \u0410 \u0442\u044B \u043A\u0442\u043E, \u043C\u043E\u0439 \u043B\u0438\u0447\u043D\u044B\u0439
      \u043F\u0441\u0438\u0445\u043E\u043B\u043E\u0433?"
    nextNode: {fileID: 11400000, guid: 58fcd997507a6994ca856b9b979e647c, type: 2}
    isCorrectChoice: 1
    maniacResponseOnFail: 
    failureOutcomeText: 
  - choiceText: "\u041E\u0442\u0441\u0442\u0430\u043D\u044C."
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0417\u043B\u043E\u0441\u0442\u044C. \u0420\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043D\u0438\u0435.
      \u041F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E. \u0422\u044B \u0442\u0430\u043A\u043E\u0439
      \u0449\u0435\u0434\u0440\u044B\u0439 \u0441\u0435\u0433\u043E\u0434\u043D\u044F."
    failureOutcomeText: "\u0413\u043E\u043B\u043E\u0432\u043D\u0430\u044F \u0431\u043E\u043B\u044C,
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043C\u0443\u0447\u0438\u043B\u0430
      \u0432\u0430\u0441, \u0440\u0435\u0437\u043A\u043E \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F"
