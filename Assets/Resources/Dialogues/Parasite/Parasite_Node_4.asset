  maniacMessages:
  - "...\u041D\u0435\u0442... \u041A\u0430\u043A \u044D\u0442\u043E \u043D\u0435\u0442
    \u0432\u043B\u0430\u0441\u0442\u0438? \u042D\u0442\u043E \u0436\u0435 \u0447\u0430\u0441\u0442\u044C
    \u0442\u0435\u0431\u044F! \u0422\u044B \u043D\u0435 \u043C\u043E\u0436\u0435\u0448\u044C
    \u043F\u0440\u043E\u0441\u0442\u043E... \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C
    \u0435\u0435. \u0422\u044B... \u0442\u044B \u0433\u043E\u043B\u043E\u0434\u043E\u043C
    \u043C\u0435\u043D\u044F \u043C\u043E\u0440\u0438\u0448\u044C."
  - "(\u0415\u0433\u043E \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u044F \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F
    \u043A\u043E\u0440\u043E\u0447\u0435, \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E
    \u0435\u043C\u0443 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0441\u0438\u043B).
    \u0422\u044B... \u0441\u0438\u043B\u044C\u043D\u044B\u0439. \u0421\u043B\u0438\u0448\u043A\u043E\u043C.
    \u041D\u043E \u044D\u0442\u043E \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E.
    \u042D\u043C\u043E\u0446\u0438\u0438 \u0434\u0435\u043B\u0430\u044E\u0442 \u043D\u0430\u0441
    \u043B\u044E\u0434\u044C\u043C\u0438. \u0411\u043E\u043B\u044C, \u0433\u043D\u0435\u0432,
    \u043E\u0442\u0447\u0430\u044F\u043D\u0438\u0435..."
  - "\u042D\u0442\u043E \u0432\u0441\u0435 \u043D\u0443\u0436\u043D\u043E. \u042F
    \u043C\u043E\u0433\u0443 \u043F\u043E\u043C\u043E\u0447\u044C \u0442\u0435\u0431\u0435.
    \u041E\u0442\u0434\u0430\u0439 \u043C\u043D\u0435 \u0441\u0432\u043E\u044E \u0431\u043E\u043B\u044C.
    \u042F \u0437\u0430\u0431\u0435\u0440\u0443 \u0435\u0435 \u0432\u0441\u044E.
    \u0422\u0435\u0431\u0435 \u0441\u0442\u0430\u043D\u0435\u0442 \u0442\u0430\u043A
    \u043B\u0435\u0433\u043A\u043E. "
  - "\u0422\u044B \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0438\u043A\u043E\u0433\u0434\u0430
    \u043D\u0435 \u0431\u0443\u0434\u0435\u0448\u044C \u043D\u0438\u0447\u0435\u0433\u043E
    \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C. \u041F\u0440\u043E\u0441\u0442\u043E
    \u043F\u0443\u0441\u0442\u043E\u0442\u0430 \u0438 \u043F\u043E\u043A\u043E\u0439.
    \u0421\u043E\u0433\u043B\u0430\u0448\u0430\u0439\u0441\u044F."
  playerChoices:
  - choiceText: "\u0414\u0430. \u042F \u0441\u043E\u0433\u043B\u0430\u0441\u0435\u043D.
      \u0417\u0430\u0431\u0435\u0440\u0438 \u0432\u0441\u0435."
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0414\u0410!"
    failureOutcomeText: "\u042D\u043A\u0440\u0430\u043D \u0432\u0441\u043F\u044B\u0445\u0438\u0432\u0430\u0435\u0442
      \u044F\u0440\u043A\u0438\u043C \u0441\u0432\u0435\u0442\u043E\u043C, \u0430
      \u0437\u0430\u0442\u0435\u043C \u0432\u044B \u0432\u0438\u0434\u0438\u0442\u0435
      \u043C\u0438\u0440 \u0432 \u0441\u0435\u0440\u044B\u0445 \u0442\u043E\u043D\u0430\u0445.
      \u0412\u044B \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435.
      \u041D\u0438 \u0431\u043E\u043B\u0438, \u043D\u0438 \u0440\u0430\u0434\u043E\u0441\u0442\u0438.
      \u0412\u044B - \u043F\u0443\u0441\u0442\u0430\u044F \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0430.
      \u041E\u043D \u043F\u043E\u0431\u0435\u0434\u0438\u043B"
  - choiceText: "\u0417\u0430\u043C\u0430\u043D\u0447\u0438\u0432\u043E. \u041D\u043E
      \u044F \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0438\u0442\u0430\u044E \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u0432\u0441\u0435, \u0430 \u043D\u0435 \u043D\u0438\u0447\u0435\u0433\u043E."
    nextNode: {fileID: 11400000, guid: cc762387d3bc1f948b1743f46b209680, type: 2}
    isCorrectChoice: 1
    maniacResponseOnFail: 
    failureOutcomeText: 
  - choiceText: "\u0422\u044B \u0441\u043B\u0430\u0431. \u0422\u044B \u043D\u0435
      \u043C\u043E\u0436\u0435\u0448\u044C \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u0431\u0435\u0437 \u0447\u0443\u0436\u0438\u0445 \u0441\u0442\u0440\u0430\u0434\u0430\u043D\u0438\u0439.
      \u0422\u044B - \u043D\u0438\u0447\u0442\u043E."
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041D\u0415\u041D\u0410\u0412\u0418\u0421\u0422\u042C!
      \u041D\u0410\u041A\u041E\u041D\u0415\u0426-\u0422\u041E! \u042F \u0434\u0443\u043C\u0430\u043B,
      \u044F \u0442\u0435\u0431\u044F \u0443\u0436\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u043B!
      \u042D\u0442\u0430 \u0432\u0441\u043F\u044B\u0448\u043A\u0430 \u0433\u043D\u0435\u0432\u0430...
      \u044D\u0442\u043E\u0433\u043E \u0445\u0432\u0430\u0442\u0438\u0442 \u043D\u0430\u0434\u043E\u043B\u0433\u043E!
      \u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0437\u0430 \u0443\u0433\u043E\u0449\u0435\u043D\u0438\u0435,
      \u0434\u0440\u0443\u0433 \u043C\u043E\u0439. \u042F \u0432\u0435\u0440\u043D\u0443\u0441\u044C,
      \u043A\u043E\u0433\u0434\u0430 \u0442\u044B \u0431\u0443\u0434\u0435\u0448\u044C
      \u0441\u043B\u0430\u0431."
    failureOutcomeText: "\u0427\u0430\u0442 \u0438\u0441\u0447\u0435\u0437\u0430\u0435\u0442,
      \u043D\u043E \u0432\u044B \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435,
      \u0447\u0442\u043E \u043E\u043D \u043D\u0435 \u0443\u0448\u0435\u043B, \u0430
      \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u0442\u0430\u0438\u043B\u0441\u044F,
      \u043E\u0441\u0442\u0430\u0432\u0438\u0432 \u0432 \u0434\u0443\u0448\u0435
      \u043B\u0435\u0434\u044F\u043D\u043E\u0439 \u0441\u043B\u0435\u0434"
