  maniacProfile: {fileID: 11400000, guid: 500f690aef2243b4087d0c94ab5e2366, type: 2}
  maniacMessages:
  - "\u0412\u0430\u0448\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u043E \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E\u0433\u043E
    \u0441\u0442\u043E\u043B\u044C \u0436\u0435 \u043D\u0435\u0440\u0430\u0437\u0432\u0438\u0442\u043E,
    \u043A\u0430\u043A \u0443 \u0438\u043D\u0444\u0443\u0437\u043E\u0440\u0438\u0438.
    \u041B\u044E\u0431\u043E\u043F\u044B\u0442\u043D\u044B\u0439 \u0434\u0435\u0444\u0435\u043A\u0442.
    \u041D\u043E \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u0443
    \u0432\u0430\u0441 \u0431\u043E\u0433\u0430\u0442\u043E\u0435 \u0432\u043E\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435?"
  - "\u041E\u043F\u0438\u0448\u0438\u0442\u0435 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u0439,
    \u043F\u043E-\u0432\u0430\u0448\u0435\u043C\u0443, \u0434\u0435\u043D\u044C.
    \u0411\u0435\u0437 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u0439.
    \u041A\u0430\u043A\u0438\u043C \u0431\u044B \u043E\u043D \u0431\u044B\u043B?"
  playerChoices:
  - choiceText: "\u0414\u0435\u043D\u044C, \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u043D\u044B\u0439
      \u0432 \u0442\u0438\u0448\u0438\u043D\u0435 \u0438 \u043F\u043E\u043A\u043E\u0435,
      \u043D\u0430 \u0431\u0435\u0440\u0435\u0433\u0443 \u043E\u043A\u0435\u0430\u043D\u0430,
      \u0441 \u0445\u043E\u0440\u043E\u0448\u0435\u0439 \u043A\u043D\u0438\u0433\u043E\u0439
      \u0438 \u0431\u043E\u043A\u0430\u043B\u043E\u043C \u0432\u0438\u043D\u0430."
    nextNode: {fileID: 11400000, guid: 43dfead3303a22047809afe7de6028fd, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0413\u0430\u0440\u043C\u043E\u043D\u0438\u044F. \u0415\u0434\u0438\u043D\u0435\u043D\u0438\u0435
      \u0441 \u043F\u0440\u0438\u0440\u043E\u0434\u043E\u0439. \u041F\u043E\u0438\u0441\u043A
      \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0433\u043E \u043F\u043E\u043A\u043E\u044F.
      \u0412 \u0432\u0430\u0441 \u0435\u0441\u0442\u044C \u0433\u043B\u0443\u0431\u0438\u043D\u0430.
      \u042F \u0434\u043E\u043B\u0436\u0435\u043D \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
      \u044D\u0442\u043E \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435 \u0434\u043B\u044F
      \u0432\u0435\u0447\u043D\u043E\u0441\u0442\u0438."
    failureOutcomeText: "\u041A\u043E\u043C\u043D\u0430\u0442\u0430 \u043D\u0430\u043F\u043E\u043B\u043D\u044F\u0435\u0442\u0441\u044F
      \u0430\u0440\u043E\u043C\u0430\u0442\u043E\u043C \u043C\u043E\u0440\u0441\u043A\u043E\u0433\u043E
      \u0431\u0440\u0438\u0437\u0430 \u0438 \u0437\u0432\u0443\u043A\u043E\u043C
      \u0432\u043E\u043B\u043D, \u0430 \u0437\u0430\u0442\u0435\u043C \u2014 \u0443\u0441\u044B\u043F\u043B\u044F\u044E\u0449\u0438\u043C
      \u0433\u0430\u0437\u043E\u043C"
  - choiceText: "\u041F\u043E\u043A\u043E\u0440\u0438\u0442\u044C \u042D\u0432\u0435\u0440\u0435\u0441\u0442,
      \u0430 \u0437\u0430\u0442\u0435\u043C \u043F\u043E\u043B\u0435\u0442\u0435\u0442\u044C
      \u043D\u0430 \u041C\u0430\u0440\u0441."
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0421\u0442\u0440\u0435\u043C\u043B\u0435\u043D\u0438\u0435
      \u043A \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u043C\u0443!
      \u0414\u0443\u0445 \u043F\u0435\u0440\u0432\u043E\u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u0435\u043B\u044F!
      \u0418\u043C\u0435\u043D\u043D\u043E \u0442\u0430\u043A\u0438\u0435 \u0430\u043C\u0431\u0438\u0446\u0438\u0438
      \u0434\u0432\u0438\u0433\u0430\u043B\u0438 \u0432\u0435\u043B\u0438\u0447\u0430\u0439\u0448\u0438\u043C\u0438
      \u043B\u044E\u0434\u044C\u043C\u0438 \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u0438.
      \u0412\u044B \u043E\u0434\u0438\u043D \u0438\u0437 \u043D\u0438\u0445.."
    failureOutcomeText: "\u0414\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0432
      \u043A\u043E\u043C\u043D\u0430\u0442\u0435 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
      \u0440\u0435\u0437\u043A\u043E \u043F\u0430\u0434\u0430\u0442\u044C, \u0438\u043C\u0438\u0442\u0438\u0440\u0443\u044F
      \u0443\u0441\u043B\u043E\u0432\u0438\u044F \u043D\u0430 \u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u0432\u044B\u0441\u043E\u0442\u0435"
  - choiceText: "\u041F\u0440\u043E\u0441\u043D\u0443\u0442\u044C\u0441\u044F, \u043F\u043E\u043D\u044F\u0442\u044C,
      \u0447\u0442\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u044B\u0445\u043E\u0434\u043D\u043E\u0439,
      \u0438 \u0432\u0435\u0441\u044C \u0434\u0435\u043D\u044C \u043B\u0435\u0436\u0430\u0442\u044C
      \u0432 \u043A\u0440\u043E\u0432\u0430\u0442\u0438, \u0441\u043C\u043E\u0442\u0440\u044F
      \u0441\u0435\u0440\u0438\u0430\u043B\u044B."
