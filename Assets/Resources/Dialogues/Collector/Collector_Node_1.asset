  maniacProfile: {fileID: 11400000, guid: 500f690aef2243b4087d0c94ab5e2366, type: 2}
  maniacMessages:
  - "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C.
    \u041D\u0435 \u043F\u0443\u0433\u0430\u0439\u0442\u0435\u0441\u044C. \u0412\u044B
    \u0437\u0434\u0435\u0441\u044C \u043D\u0435 \u0434\u043B\u044F \u0442\u043E\u0433\u043E,
    \u0447\u0442\u043E\u0431\u044B \u0441\u0442\u0440\u0430\u0434\u0430\u0442\u044C.
    \u0412\u044B \u0437\u0434\u0435\u0441\u044C \u0434\u043B\u044F \u0442\u043E\u0433\u043E,
    \u0447\u0442\u043E\u0431\u044B \u0431\u044B\u0442\u044C \u043E\u0446\u0435\u043D\u0435\u043D\u043D\u044B\u043C."
  - "\u042F \u0438\u0437\u0443\u0447\u0438\u043B \u0432\u0430\u0448\u0443 \u0436\u0438\u0437\u043D\u044C.
    \u0412 \u043D\u0435\u0439 \u0435\u0441\u0442\u044C... \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B.
    \u041D\u043E \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0443\u0431\u0435\u0434\u0438\u0442\u044C\u0441\u044F
    \u043B\u0438\u0447\u043D\u043E. \u041E\u0442\u0432\u0435\u0447\u0430\u0439\u0442\u0435
    \u043D\u0430 \u043C\u043E\u0438 \u0432\u043E\u043F\u0440\u043E\u0441\u044B. \u041F\u0435\u0440\u0432\u044B\u0439:
    \u043A\u0430\u043A\u043E\u0435 \u0432\u0430\u0448\u0435 \u0433\u043B\u0430\u0432\u043D\u043E\u0435
    \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u0435 \u0432 \u0436\u0438\u0437\u043D\u0438?"
  playerChoices:
  - choiceText: "\u0412\u044B\u043F\u0443\u0441\u0442\u0438 \u043C\u0435\u043D\u044F,
      \u0443\u0431\u043B\u044E\u0434\u043E\u043A! \u042F \u043D\u0435 \u044D\u043A\u0441\u043F\u043E\u043D\u0430\u0442!"
    nextNode: {fileID: 11400000, guid: 072ff9f99473c214d940fa9bc8ef6f07, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0412\u0443\u043B\u044C\u0433\u0430\u0440\u043D\u043E.
      \u0412\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u043A\u0443\u0441\u043E\u043A
      \u043C\u044F\u0441\u0430, \u043D\u0435 \u0431\u043E\u043B\u0435\u0435. \u0410
      \u043C\u044F\u0441\u043E \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u0440\u0430\u0437\u0434\u0435\u043B\u0430\u043D\u043E.
      \u0412\u044B \u043D\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442\u0435
      \u0434\u043B\u044F \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u0438,
      \u043D\u043E \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442\u0435
      \u0434\u043B\u044F \u0443\u0442\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u0438."
    failureOutcomeText: "\u0421\u0442\u0435\u043D\u0430 \u0437\u0430 \u0432\u0430\u043C\u0438
      \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F, \u043E\u0431\u043D\u0430\u0436\u0430\u044F
      \u0440\u044F\u0434 \u0445\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0445
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u0432"
  - choiceText: "\u042F \u043F\u0440\u043E\u0431\u0435\u0436\u0430\u043B \u043C\u0430\u0440\u0430\u0444\u043E\u043D
      \u0437\u0430 3 \u0447\u0430\u0441\u0430 30 \u043C\u0438\u043D\u0443\u0442."
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0421\u0438\u043B\u0430 \u0432\u043E\u043B\u0438. \u0414\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u0430.
      \u041F\u0440\u0435\u043E\u0434\u043E\u043B\u0435\u043D\u0438\u0435. \u041F\u0440\u0435\u0432\u043E\u0441\u0445\u043E\u0434\u043D\u043E.
      \u0412\u044B \u0441\u0442\u0430\u043D\u0435\u0442\u0435 \u0436\u0435\u043C\u0447\u0443\u0436\u0438\u043D\u043E\u0439
      \u043C\u043E\u0435\u0439 \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u0438.
      \u041F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u044C\u0442\u0435\u0441\u044C
      \u043A \u0432\u0435\u0447\u043D\u043E\u0441\u0442\u0438."
    failureOutcomeText: "\u0412 \u043A\u043E\u043C\u043D\u0430\u0442\u0443 \u043F\u043E\u0441\u0442\u0443\u043F\u0430\u0435\u0442
      \u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u044B\u0439 \u0443\u0441\u044B\u043F\u043B\u044F\u044E\u0449\u0438\u0439
      \u0433\u0430\u0437"
  - choiceText: "\u041E\u0434\u043D\u0430\u0436\u0434\u044B \u044F \u0441\u044A\u0435\u043B
      \u0446\u0435\u043B\u0443\u044E \u043F\u0438\u0446\u0446\u0443 \u0437\u0430
