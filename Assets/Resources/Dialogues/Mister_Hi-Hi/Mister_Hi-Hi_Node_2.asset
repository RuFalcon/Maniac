  maniacProfile: {fileID: 11400000, guid: a09a6bda9cf31ae4290c097d30331557, type: 2}
  maniacMessages:
  - "\u041B\u0430\u0434\u043D\u043E, \u0440\u0430\u0437 \u0442\u044B \u0442\u0430\u043A\u043E\u0439
    \u0432\u0435\u0441\u0435\u043B\u044B\u0439, \u0434\u0430\u0432\u0430\u0439 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043C
    \u0442\u0432\u043E\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u043E \u044E\u043C\u043E\u0440\u0430.
    \u041C\u043D\u0435 \u0441\u043A\u0443\u0447\u043D\u043E. \u0420\u0430\u0437\u0432\u0435\u0441\u0435\u043B\u0438
    \u043C\u0435\u043D\u044F. "
  - "\u0423 \u0442\u0435\u0431\u044F 30 \u0441\u0435\u043A\u0443\u043D\u0434, \u0447\u0442\u043E\u0431\u044B
    \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C \u0441\u0430\u043C\u044B\u0439
    \u0441\u043C\u0435\u0448\u043D\u043E\u0439 \u0430\u043D\u0435\u043A\u0434\u043E\u0442,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C.
    \u0418\u043D\u0430\u0447\u0435 \u044F \u0432\u043A\u043B\u044E\u0447\u0443 \u043E\u0442\u043E\u043F\u043B\u0435\u043D\u0438\u0435
    \u043D\u0430 \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C. \u0411\u0443\u0434\u0435\u0442
    \u043A\u0430\u043A \u0432 \u0441\u0430\u0443\u043D\u0435! \u0412 \u0410\u0414\u0423!"
  playerChoices:
  - choiceText: "\u042F \u0442\u0435\u0431\u0435 \u043D\u0435 \u043A\u043B\u043E\u0443\u043D"
    nextNode: {fileID: 11400000, guid: 43dfead3303a22047809afe7de6028fd, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041D\u0435 \u043A\u043B\u043E\u0443\u043D? \u0410 \u0441\u0435\u0439\u0447\u0430\u0441
      \u043F\u043E\u043A\u0440\u0430\u0441\u043D\u0435\u0435\u0448\u044C, \u043A\u0430\u043A
      \u043A\u043B\u043E\u0443\u043D\u0441\u043A\u0438\u0439 \u043D\u043E\u0441!"
    failureOutcomeText: "\u0411\u0430\u0442\u0430\u0440\u0435\u0438 \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435
      \u0440\u0430\u0441\u043A\u0430\u043B\u044F\u044E\u0442\u0441\u044F \u0434\u043E\u043A\u0440\u0430\u0441\u043D\u0430,
      \u044D\u043A\u0440\u0430\u043D \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
      \u043F\u043E\u0434\u0440\u0430\u0433\u0438\u0432\u0430\u0442\u044C \u043E\u0442
      \u0436\u0430\u0440\u044B"
  - choiceText: "\u0412\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0442\u0441\u044F
      \u043A\u0430\u043A-\u0442\u043E \u0430\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0435\u0446,
      \u043D\u0435\u043C\u0435\u0446 \u0438 \u0440\u0443\u0441\u0441\u043A\u0438\u0439..."
    nextNode: {fileID: 11400000, guid: 2ad34344592e2ee45b4ca91e865adfe9, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0421\u041B\u0418\u0428\u041A\u041E\u041C \u0414\u041B\u0418\u041D\u041D\u041E!
      \u042F \u0423\u0421\u041D\u0423\u041B! \u0410 \u043A\u043E\u0433\u0434\u0430
      \u044F \u0441\u043F\u043B\u044E, \u043C\u043E\u0438 \u043F\u0430\u043B\u044C\u0446\u044B
      \u043C\u043E\u0433\u0443\u0442 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E
      \u043D\u0430\u0436\u0430\u0442\u044C \u043D\u0435 \u043D\u0430 \u0442\u0443
      \u043A\u043D\u043E\u043F\u043A\u0443..."
    failureOutcomeText: "\u0421\u0438\u0433\u043D\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044F
      \u0432 \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0435 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
