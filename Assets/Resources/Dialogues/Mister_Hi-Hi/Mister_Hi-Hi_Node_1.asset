  maniacProfile: {fileID: 11400000, guid: a09a6bda9cf31ae4290c097d30331557, type: 2}
  maniacMessages:
  - "\u0422\u0410-\u0414\u0410\u041C! \u0421\u042E\u0420\u041F\u0420\u0418\u0417!
    \u041D\u0435 \u0441\u043A\u0443\u0447\u0430\u043B? :) \u042F \u0432\u0437\u043B\u043E\u043C\u0430\u043B
    \u0442\u0432\u043E\u0439 \"\u0443\u043C\u043D\u044B\u0439\" \u0434\u043E\u043C.
    \u0422\u0435\u043F\u0435\u0440\u044C \u043E\u043D \u041C\u041E\u0419 \u0434\u043E\u043C.
    \u0418 \u0442\u044B \u0432 \u043D\u0435\u043C \u043C\u043E\u044F \u0438\u0433\u0440\u0443\u0448\u043A\u0430!"
  playerChoices:
  - choiceText: "\u041E, \u043D\u043E\u0432\u0430\u044F \u043F\u0440\u043E\u0448\u0438\u0432\u043A\u0430?
      \u041F\u0440\u0438\u043A\u043E\u043B\u044C\u043D\u044B\u0439 \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441.
      \u0413\u0434\u0435 \u043C\u0435\u043D\u044E \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043A?"
    nextNode: {fileID: 11400000, guid: db889ae7f50646942a48fead68c22ac7, type: 2}
    isCorrectChoice: 1
    maniacResponseOnFail: 
    failureOutcomeText: 
  - choiceText: "\u041A\u0442\u043E \u044D\u0442\u043E?! \u042F \u0437\u0432\u043E\u043D\u044E
      \u0432 \u043F\u043E\u043B\u0438\u0446\u0438\u044E!"
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041F\u043E\u043B\u0438\u0446\u0438\u044F? \u0421\u043A\u0443\u043A\u043E\u0442\u0430!
      \u042F \u0443\u0436\u0435 \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u043B
      \u0438\u043C \u0441\u0432\u0435\u0442\u043E\u0444\u043E\u0440\u044B \u043F\u043E
      \u043F\u0443\u0442\u0438. \u0410 \u0442\u0435\u0431\u0435 \u044F \u0441\u0435\u0439\u0447\u0430\u0441
      \u043E\u0442\u043A\u043B\u044E\u0447\u0443 \u0441\u0432\u0435\u0442. \u041D\u0430\u0432\u0441\u0435\u0433\u0434\u0430."
    failureOutcomeText: "\u042D\u043A\u0440\u0430\u043D \u0433\u0430\u0441\u043D\u0435\u0442,
      \u0441\u043B\u044B\u0448\u0435\u043D \u0437\u0432\u0443\u043A \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0433\u043E
      \u0437\u0430\u043C\u044B\u043A\u0430\u043D\u0438\u044F"
  - choiceText: "\u0427\u0442\u043E \u0442\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E?
      \u0414\u0435\u043D\u044C\u0433\u0438? \u0412\u043E\u0437\u044C\u043C\u0438
      \u0432\u0441\u0435, \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u0442\u0440\u043E\u0433\u0430\u0439
      \u043C\u0435\u043D\u044F!"
    nextNode: {fileID: 11400000, guid: 3d391fb5a900f714dafb1188d88c871c, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0414\u0435\u043D\u044C\u0433\u0438? \u041F\u0444\u0444\u0444.
      \u041A\u0430\u043A \u0431\u0430\u043D\u0430\u043B\u044C\u043D\u043E. \u042F
      \u0438\u0449\u0443 \u0442\u043E, \u0447\u0442\u043E \u0437\u0430 \u0434\u0435\u043D\u044C\u0433\u0438
      \u043D\u0435 \u043A\u0443\u043F\u0438\u0448\u044C. \u0412\u0435\u0441\u0435\u043B\u044C\u0435!"
    failureOutcomeText: "\u0422\u043E\u0441\u0442\u0435\u0440 \u043D\u0430 \u043A\u0443\u0445\u043D\u0435
      \u0432\u0437\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0441 \u0433\u0440\u043E\u043C\u043A\u0438\u043C
      \u0445\u043B\u043E\u043F\u043A\u043E\u043C"
