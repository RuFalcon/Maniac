  maniacProfile: {fileID: 11400000, guid: a09a6bda9cf31ae4290c097d30331557, type: 2}
  maniacMessages:
  - "\u0425\u0410! \u0425\u0410\u0425\u0410\u0425\u0410! \u041A\u041E\u0420\u041E\u0422\u041A\u041E!
    \u0413\u041B\u0423\u041F\u041E! \u0413\u0415\u041D\u0418\u0410\u041B\u042C\u041D\u041E!
    \u041B\u0430\u0434\u043D\u043E, \u0430\u043D\u0435\u043A\u0434\u043E\u0442\u044B
    \u0442\u044B \u0442\u0440\u0430\u0432\u0438\u0442\u044C \u0443\u043C\u0435\u0435\u0448\u044C.
    \u0410 \u043A\u0430\u043A \u0443 \u0442\u0435\u0431\u044F \u0441 \u0440\u0435\u0430\u043A\u0446\u0438\u0435\u0439?"
  - "\u042F \u0441\u0435\u0439\u0447\u0430\u0441 \u0432\u043A\u043B\u044E\u0447\u0443
    \u0442\u0432\u043E\u0439 \u043F\u044B\u043B\u0435\u0441\u043E\u0441-\u0440\u043E\u0431\u043E\u0442
    \u043D\u0430 \u043F\u043E\u043B\u043D\u0443\u044E \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u044C.
    \u0423 \u0442\u0435\u0431\u044F 10 \u0441\u0435\u043A\u0443\u043D\u0434, \u0447\u0442\u043E\u0431\u044B
    \u043A\u0440\u0438\u043A\u043D\u0443\u0442\u044C \u0435\u043C\u0443 \"\u0424\u0443,
    \u043F\u043B\u043E\u0445\u043E\u0439 \u043C\u0430\u043B\u044C\u0447\u0438\u043A!\"."
  - "\u042F \u0441\u043B\u0443\u0448\u0430\u044E \u0447\u0435\u0440\u0435\u0437 \u0442\u0432\u043E\u0439
    \u043C\u0438\u043A\u0440\u043E\u0444\u043E\u043D. \u0412\u0440\u0435\u043C\u044F
    \u043F\u043E\u0448\u043B\u043E!"
  playerChoices:
  - choiceText: "(\u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0434\u0435\u043B\u0430\u0442\u044C)"
    nextNode: {fileID: 11400000, guid: 43dfead3303a22047809afe7de6028fd, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041C\u043E\u043B\u0447\u0438\u0448\u044C? \u041D\u0443,
      \u0440\u0430\u0437 \u0442\u044B \u043D\u0435 \u0445\u043E\u0447\u0435\u0448\u044C
      \u0434\u0440\u0435\u0441\u0441\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0435\u0433\u043E,
      \u043E\u043D \u0431\u0443\u0434\u0435\u0442 \u0434\u0440\u0435\u0441\u0441\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0442\u0435\u0431\u044F! \u042F \u0432\u043A\u043B\u044E\u0447\u0438\u043B
      \u0435\u043C\u0443 \u0440\u0435\u0436\u0438\u043C '\u0442\u0430\u0440\u0430\u043D'."
    failureOutcomeText: "\u0421\u043B\u044B\u0448\u0435\u043D \u0437\u0432\u0443\u043A
      \u0440\u0430\u0437\u0433\u043E\u043D\u044F\u044E\u0449\u0435\u0433\u043E\u0441\u044F
      \u043F\u044B\u043B\u0435\u0441\u043E\u0441\u0430 \u0438 \u0443\u0434\u0430\u0440.
      \u042D\u043A\u0440\u0430\u043D \u0442\u0440\u044F\u0441\u0435\u0442\u0441\u044F
      \u0438 \u0433\u0430\u0441\u043D\u0435\u0442"
  - choiceText: "\u0424\u0443, \u043F\u043B\u043E\u0445\u043E\u0439 \u043C\u0430\u043B\u044C\u0447\u0438\u043A!"
    nextNode: {fileID: 11400000, guid: 7bbff9775399f274abb281e4125c43a2, type: 2}
    isCorrectChoice: 1
    maniacResponseOnFail: 
    failureOutcomeText: 
  - choiceText: "\u0414\u0430 \u043F\u043E\u0448\u0435\u043B \u0442\u044B!"
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041E\u043F\u044F\u0442\u044C \u0433\u0440\u0443\u0431\u043E\u0441\u0442\u0438...
      \u0422\u044B \u0441\u043A\u0443\u0447\u043D\u044B\u0439 \u0438 \u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0443\u0435\u043C\u044B\u0439.
      \u0410 \u044F \u043D\u0435 \u0438\u0433\u0440\u0430\u044E \u0441\u043E \u0441\u043A\u0443\u0447\u043D\u044B\u043C\u0438
      \u0438\u0433\u0440\u0443\u0448\u043A\u0430\u043C\u0438. "
    failureOutcomeText: "\u0421\u043B\u044B\u0448\u0435\u043D \u0433\u0440\u043E\u043C\u043A\u0438\u0439
      \u0445\u043B\u043E\u043F\u043E\u043A \u0438 \u0437\u0432\u0443\u043A \u0440\u0430\u0437\u043B\u0435\u0442\u0430\u044E\u0449\u0438\u0445\u0441\u044F
      \u043E\u0441\u043A\u043E\u043B\u043A\u043E\u0432"
