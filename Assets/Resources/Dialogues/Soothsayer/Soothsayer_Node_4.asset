  maniacProfile: {fileID: 11400000, guid: b0ebe54cbb6b42740b8e7ca97065bc61, type: 2}
  maniacMessages:
  - "\u0427\u0442\u043E?! \u041A\u0430\u043A\u0430\u044F \u0435\u0449\u0435 \u043A\u0430\u043C\u0435\u0440\u0430?!"
  - "\u0422\u044B... \u0442\u044B \u0432\u0441\u0435 \u0438\u0441\u043F\u043E\u0440\u0442\u0438\u043B!
    \u0422\u044B \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u043B \u043C\u0438\u0441\u0442\u0438\u043A\u0443!
    \u0422\u044B \u043D\u0435 \u0432\u0435\u0440\u0438\u0448\u044C \u0432 \u0441\u0443\u0434\u044C\u0431\u0443!
    \u0417\u0430 \u044D\u0442\u043E \u0442\u044B \u043F\u043E\u0437\u043D\u0430\u0435\u0448\u044C
    \u0441\u0432\u043E\u044E, \u0438 \u043E\u043D\u0430 \u0431\u0443\u0434\u0435\u0442
    \u0443\u0436\u0430\u0441\u043D\u0430!"
  playerChoices:
  - choiceText: "\u042D\u0442\u043E \u0442\u044B \u0441\u0435\u0439\u0447\u0430\u0441
      \u043F\u043E\u0437\u043D\u0430\u0435\u0448\u044C \u0441\u0432\u043E\u044E \u0441\u0443\u0434\u044C\u0431\u0443!"
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041C\u043E\u044E \u0441\u0443\u0434\u044C\u0431\u0443?!
      \u042F \u0435\u0435 \u0442\u0432\u043E\u0440\u044E!"
    failureOutcomeText: "\u041E\u043D\u0430 \u043D\u0430\u0436\u0438\u043C\u0430\u0435\u0442
      \u043A\u043D\u043E\u043F\u043A\u0443 \u043F\u043E\u0434 \u0441\u0442\u043E\u043B\u043E\u043C,
      \u0438 \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0443 \u0432\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043E\u0445\u0440\u0430\u043D\u0430"
  - choiceText: "\u0423\u0441\u043F\u043E\u043A\u043E\u0439\u0441\u044F, \u0434\u0430\u0432\u0430\u0439
      \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C."
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0413\u043E\u0432\u043E\u0440\u0438\u0442\u044C?! \u0421
      \u043D\u0435\u0432\u0435\u0440\u0443\u044E\u0449\u0438\u043C?! \u041D\u0438\u043A\u043E\u0433\u0434\u0430!"
    failureOutcomeText: "\u041E\u043D\u0430 \u043E\u043F\u0440\u043E\u043A\u0438\u0434\u044B\u0432\u0430\u0435\u0442
      \u0441\u0442\u043E\u043B \u0438 \u0433\u043E\u0440\u044F\u0449\u0438\u0435
      \u0441\u0432\u0435\u0447\u0438 \u043F\u043E\u0434\u0436\u0438\u0433\u0430\u044E\u0442
      \u0441\u043A\u0430\u0442\u0435\u0440\u0442\u044C. \u041A\u043E\u043C\u043D\u0430\u0442\u0430
      \u0431\u044B\u0441\u0442\u0440\u043E \u043D\u0430\u043F\u043E\u043B\u043D\u044F\u0435\u0442\u0441\u044F
      \u0434\u044B\u043C\u043E\u043C"
  - choiceText: "\u042F \u0442\u043E\u0436\u0435 \u043A\u043E\u0435-\u0447\u0442\u043E
      \u0432\u0438\u0436\u0443. \u042F \u0432\u0438\u0436\u0443, \u043A\u0430\u043A
      \u0442\u044B \u043D\u0430\u0436\u0438\u043C\u0430\u0435\u0448\u044C \u043D\u0430
      \u043A\u043D\u043E\u043F\u043A\u0443 \u043F\u043E\u0434 \u0441\u0442\u043E\u043B\u043E\u043C,
      \u0447\u0442\u043E\u0431\u044B \u0432\u044B\u0437\u0432\u0430\u0442\u044C \u043E\u0445\u0440\u0430\u043D\u0443.
      \u041D\u043E \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0434\u0430\u0435\u0442
      \u0441\u0431\u043E\u0439."
