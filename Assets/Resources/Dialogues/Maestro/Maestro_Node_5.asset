  maniacProfile: {fileID: 11400000, guid: 220b51d79a594394a8ab9d33929ec382, type: 2}
  maniacMessages:
  - "\u0423\u0441\u043B\u043E\u0432\u0438\u0438? \u0413\u0435\u043D\u0438\u0439 \u0441\u0442\u0430\u0432\u0438\u0442
    \u043C\u043D\u0435 \u0443\u0441\u043B\u043E\u0432\u0438\u044F? \u042F \u0437\u0430\u0438\u043D\u0442\u0440\u0438\u0433\u043E\u0432\u0430\u043D!
    \u0413\u043E\u0432\u043E\u0440\u0438!"
  playerChoices: []
  victoryMessage: "\u0412\u044B \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442\u0435:
    \"\u041C\u043E\u0435 \u0443\u0441\u043B\u043E\u0432\u0438\u0435 - \u0441\u0432\u043E\u0431\u043E\u0434\u0430.
    \u042F \u0431\u0443\u0434\u0443 \u0432\u0430\u0448\u0438\u043C \u0441\u043E\u0430\u0432\u0442\u043E\u0440\u043E\u043C,
    \u043D\u043E \u0443\u0434\u0430\u043B\u0435\u043D\u043D\u043E. \u042F \u0431\u0443\u0434\u0443
    \u043F\u0440\u0438\u0441\u044B\u043B\u0430\u0442\u044C \u0432\u0430\u043C \u0438\u0434\u0435\u0438,
    \u0430 \u0432\u044B - \u0432\u043E\u043F\u043B\u043E\u0449\u0430\u0442\u044C.
    \u0413\u0435\u043D\u0438\u044E \u043D\u0435 \u043D\u0443\u0436\u043D\u0430 \u043A\u043B\u0435\u0442\u043A\u0430,
    \u0435\u043C\u0443 \u043D\u0443\u0436\u0435\u043D \u043F\u0440\u043E\u0441\u0442\u043E\u0440
    \u0434\u043B\u044F \u043C\u044B\u0441\u043B\u0438\". \u041C\u0430\u044D\u0441\u0442\u0440\u043E,
    \u043E\u043F\u044C\u044F\u043D\u0435\u043D\u043D\u044B\u0439 \u0438\u0434\u0435\u0435\u0439
    \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u0430
    \u0441 \u0440\u0430\u0432\u043D\u044B\u043C \u0441\u0435\u0431\u0435 \"\u0433\u0435\u043D\u0438\u0435\u043C\",
    \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u0435\u0442\u0441\u044F. \u041E\u043D
    \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0434\u0432\u0435\u0440\u044C,
    \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u0439, \u0447\u0442\u043E \u0432\u044B
    \u0431\u0443\u0434\u0435\u0442\u0435 \u043D\u0430 \u0441\u0432\u044F\u0437\u0438.
    \u0412\u044B, \u0440\u0430\u0437\u0443\u043C\u0435\u0435\u0442\u0441\u044F, \u043D\u0435\u0442"
