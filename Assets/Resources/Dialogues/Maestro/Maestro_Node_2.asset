  maniacMessages:
  - "\u0412\u044B... \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u0435\u0442\u0435\u0441\u044C
    \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E\u043C? \u041F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E!"
  - "\u041A\u043E\u043D\u0446\u0435\u043F\u0446\u0438\u044F - \u044D\u0442\u043E
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435 \u044D\u043A\u0437\u0438\u0441\u0442\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0439
    \u043F\u0443\u0441\u0442\u043E\u0442\u044B \u0432 \u044D\u043F\u043E\u0445\u0443
    \u0446\u0438\u0444\u0440\u043E\u0432\u043E\u0433\u043E \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u0430.
    \u0412\u0430\u0448\u0430 \u0444\u0438\u0433\u0443\u0440\u0430 \u043D\u0430 \u0431\u0435\u043B\u043E\u043C
    \u0444\u043E\u043D\u0435 - \u044D\u0442\u043E \u0441\u0438\u043C\u0432\u043E\u043B..."
  - "\u041D\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0438\u0434\u0435\u0442\u044C
    - \u044D\u0442\u043E \u0441\u0442\u0430\u0442\u0438\u0447\u043D\u043E. \u0418\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E
    \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0434\u0438\u043D\u0430\u043C\u0438\u043A\u0438!
    \u0421\u0435\u0439\u0447\u0430\u0441 \u044F \u0431\u0443\u0434\u0443 \u043C\u0435\u043D\u044F\u0442\u044C
    \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u0435, \u0447\u0442\u043E\u0431\u044B
    \u043F\u043E\u0434\u0447\u0435\u0440\u043A\u043D\u0443\u0442\u044C \u0440\u0430\u0437\u043D\u044B\u0435
    \u0433\u0440\u0430\u043D\u0438 \u0432\u0430\u0448\u0435\u0433\u043E \u043E\u0442\u0447\u0430\u044F\u043D\u0438\u044F."
  - "\u0421\u043A\u0430\u0436\u0438\u0442\u0435, \u043A\u0430\u043A\u043E\u0439 \u0446\u0432\u0435\u0442
    \u043B\u0443\u0447\u0448\u0435 \u043E\u0442\u0440\u0430\u0436\u0430\u0435\u0442
    \u0432\u0430\u0448\u0443 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u044E\u044E
