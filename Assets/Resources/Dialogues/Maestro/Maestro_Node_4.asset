  maniacProfile: {fileID: 11400000, guid: 220b51d79a594394a8ab9d33929ec382, type: 2}
  maniacMessages:
  - "...\u0414\u0438\u0430\u043B\u043E\u0433? \u0418\u043D\u0442\u0435\u0440\u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0439
    \u043F\u0435\u0440\u0444\u043E\u0440\u043C\u0430\u043D\u0441? \u0427\u0442\u043E\u0431\u044B
    \u0431\u0435\u0437\u043B\u0438\u043A\u0430\u044F \u0442\u043E\u043B\u043F\u0430...
    \u0441\u0442\u0430\u043B\u0430 \u0447\u0430\u0441\u0442\u044C\u044E \u043C\u043E\u0435\u0433\u043E
    \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0435\u043D\u0438\u044F?"
  - "\u0412\u044B... \u0432\u044B \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442\u0435
    \u043C\u043D\u0435 \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u044E
    \u0432 \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0435! \u042F \u0434\u043E\u043B\u0436\u0435\u043D
    \u044D\u0442\u043E \u043E\u0431\u0434\u0443\u043C\u0430\u0442\u044C!"
  - "\u042D\u0442\u043E \u0432\u0441\u0435 \u043C\u0435\u043D\u044F\u0435\u0442!
    \"\u0418\u0437\u043E\u043B\u044F\u0446\u0438\u044F\" \u043C\u0435\u0440\u0442\u0432\u0430!
    \u0414\u0430 \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0435\u0442
    \"\u0421\u043E\u043F\u0440\u0438\u0447\u0430\u0441\u0442\u043D\u043E\u0441\u0442\u044C\"!
    \u0412\u044B \u0433\u0435\u043D\u0438\u0439! \u042F \u043D\u0435 \u043C\u043E\u0433\u0443
    \u0431\u043E\u043B\u044C\u0448\u0435 \u0434\u0435\u0440\u0436\u0430\u0442\u044C
    \u0432\u0430\u0441 \u0437\u0434\u0435\u0441\u044C, \u0432\u0437\u0430\u043F\u0435\u0440\u0442\u0438."
  - "\u0412\u044B \u0434\u043E\u043B\u0436\u043D\u044B \u0431\u044B\u0442\u044C \u043D\u0430
    \u0441\u0446\u0435\u043D\u0435, \u0432 \u0441\u0432\u0435\u0442\u0435 \u0441\u043E\u0444\u0438\u0442\u043E\u0432!
    \u042F \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0443\u044E \u043D\u0430\u043C
    \u0432\u044B\u0441\u0442\u0430\u0432\u043A\u0443 \u0432 \u0433\u043B\u0430\u0432\u043D\u043E\u0439
    \u0433\u0430\u043B\u0435\u0440\u0435\u0435 \u0433\u043E\u0440\u043E\u0434\u0430!
    \u041C\u044B \u0441\u0442\u0430\u043D\u0435\u043C \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u044B!"
  playerChoices:
  - choiceText: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E! \u042F \u0441\u043E\u0433\u043B\u0430\u0441\u0435\u043D!"
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E!
      \u0410\u0441\u0441\u0438\u0441\u0442\u0435\u043D\u0442\u044B, \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u044C\u0442\u0435
      '\u042D\u043A\u0441\u043F\u043E\u043D\u0430\u0442' \u043A \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u043A\u0435!"
    failureOutcomeText: "\u0412\u0430\u0441 \u0443\u0441\u044B\u043F\u043B\u044F\u044E\u0442,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0435\u0440\u0435\u0432\u0435\u0437\u0442\u0438
      \u043D\u0430 \u043D\u043E\u0432\u043E\u0435 \"\u043C\u0435\u0441\u0442\u043E
      \u0440\u0430\u0431\u043E\u0442\u044B\". \u0412\u044B \u043F\u0440\u043E\u0441\u0442\u043E
      \u0441\u043C\u0435\u043D\u0438\u043B\u0438 \u043E\u0434\u043D\u0443 \u043A\u043B\u0435\u0442\u043A\u0443
      \u043D\u0430 \u0434\u0440\u0443\u0433\u0443\u044E, \u0431\u043E\u043B\u0435\u0435
      \u043F\u0443\u0431\u043B\u0438\u0447\u043D\u0443\u044E"
  - choiceText: "\u0411\u043E\u044E\u0441\u044C, \u0443 \u043C\u0435\u043D\u044F
      \u0434\u0440\u0443\u0433\u0438\u0435 \u043F\u043B\u0430\u043D\u044B."
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0414\u0440\u0443\u0433\u0438\u0435 \u043F\u043B\u0430\u043D\u044B?
      \u041A\u0430\u043A\u0438\u0435 \u043F\u043B\u0430\u043D\u044B \u043C\u043E\u0433\u0443\u0442
      \u0431\u044B\u0442\u044C \u0432\u0430\u0436\u043D\u0435\u0435 \u0418\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0430?!
      \u0422\u044B... \u0442\u044B \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0448\u044C\u0441\u044F
      \u043E\u0442 \u0432\u0435\u043B\u0438\u0447\u0438\u044F? \u0422\u044B \u043F\u0440\u0435\u0434\u0430\u0442\u0435\u043B\u044C!
      \u0422\u044B \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u0435\u0448\u044C
      \u0437\u0430\u0431\u0432\u0435\u043D\u0438\u044F!"
    failureOutcomeText: "\u041E\u043D \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u0432\u0430\u0441 \u0437\u0430\u043F\u0435\u0440\u0442\u044B\u043C \u0432
      \u044D\u0442\u043E\u0439 \u043A\u043E\u043C\u043D\u0430\u0442\u0435 \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430,
      \u043A\u0430\u043A \u043D\u0435\u0443\u0434\u0430\u0432\u0448\u0438\u0439\u0441\u044F
      \u043F\u0440\u043E\u0435\u043A\u0442"
  - choiceText: "\u042F \u0441\u043E\u0433\u043B\u0430\u0441\u0435\u043D. \u041D\u043E
      \u043F\u0440\u0438 \u043E\u0434\u043D\u043E\u043C \u0443\u0441\u043B\u043E\u0432\u0438\u0438."
