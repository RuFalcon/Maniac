  maniacMessages:
  - "\u0427-\u0447\u0442\u043E? \u0422\u041E\u0420\u0422\u041E\u041C?! \u0412 \u041A\u041D\u041E\u041F\u041A\u0423?!
    \u042D\u0442\u043E... \u044D\u0442\u043E... \u042D\u0422\u041E \u0413\u0415\u041D\u0418\u0410\u041B\u042C\u041D\u041E!
    \u0425\u0410-\u0425\u0410-\u0425\u0410-\u0425\u0410-\u0425\u0410!"
  - "\u0422\u044B... \u0442\u044B \u043C\u0435\u043D\u044F \u0440\u0430\u0441\u0441\u043C\u0435\u0448\u0438\u043B.
    \u041F\u043E-\u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C\u0443. \u041D\u0438\u043A\u0442\u043E
    \u0435\u0449\u0435 \u0442\u0430\u043A \u043D\u0435 \u0434\u0435\u043B\u0430\u043B.
    \u0422\u044B \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0440\u0438\u0442\u0435\u043B\u044C,
    \u0442\u044B - \u0430\u0440\u0442\u0438\u0441\u0442! \u042F \u043E\u0442\u043F\u0443\u0449\u0443
    \u0442\u0435\u0431\u044F. \u041D\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0441\u043B\u0435
    \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0439 \u0448\u0443\u0442\u043A\u0438."
  - "\u0422\u044B \u0434\u043E\u043B\u0436\u0435\u043D \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C
    \u043C\u043D\u0435 \u0441\u0430\u043C\u044B\u0439 \u0441\u043C\u0435\u0448\u043D\u043E\u0439
    \u0430\u043D\u0435\u043A\u0434\u043E\u0442, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0437\u043D\u0430\u0435\u0448\u044C. \u0415\u0441\u043B\u0438 \u044F \u0437\u0430\u0441\u043C\u0435\u044E\u0441\u044C
    - \u0442\u044B \u0441\u0432\u043E\u0431\u043E\u0434\u0435\u043D. \u0415\u0441\u043B\u0438
    \u043D\u0435\u0442... \u0437\u0430\u043D\u0430\u0432\u0435\u0441."
  playerChoices:
  - choiceText: "\u0412\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0442\u0441\u044F
      \u0434\u0432\u0430 \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u0430..."
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0421\u043B\u044B\u0448\u0430\u043B. \u041D\u0435 \u0441\u043C\u0435\u0448\u043D\u043E.
      \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439!"
    failureOutcomeText: "\u0417\u0430 \u0432\u0430\u0448\u0435\u0439 \u0441\u043F\u0438\u043D\u043E\u0439
      \u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F \u0442\u044F\u0436\u0435\u043B\u044B\u0439
      \u0442\u0435\u0430\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0439 \u0437\u0430\u043D\u0430\u0432\u0435\u0441,
      \u043E\u0442\u0440\u0435\u0437\u0430\u044F \u043F\u0443\u0442\u044C \u043A
      \u043E\u0442\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u044E"
  - choiceText: "\u041A\u043E\u043B\u043E\u0431\u043E\u043A \u043F\u043E\u0432\u0435\u0441\u0438\u043B\u0441\u044F."
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041E, \u0447\u0435\u0440\u043D\u044B\u0439 \u044E\u043C\u043E\u0440!
      \u042F \u0435\u0433\u043E \u043B\u044E\u0431\u043B\u044E! \u041D\u043E... \u044D\u0442\u043E\u0442
      \u0430\u043D\u0435\u043A\u0434\u043E\u0442 \u043C\u043D\u0435 \u0443\u0436\u0435
      \u043A\u0442\u043E-\u0442\u043E \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B.
      \u041F\u043B\u0430\u0433\u0438\u0430\u0442! \u041D\u0435\u0445\u043E\u0440\u043E\u0448\u043E!"
    failureOutcomeText: "\u041E\u043D \u0434\u043E\u0441\u0442\u0430\u0435\u0442
      \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0439 \u0432\u043E\u0434\u044F\u043D\u043E\u0439
      \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442, \u043D\u043E \u0432\u044B
      \u0441\u043E\u043C\u043D\u0435\u0432\u0430\u0435\u0442\u0435\u0441\u044C, \u0447\u0442\u043E
      \u0432\u043D\u0443\u0442\u0440\u0438 \u0432\u043E\u0434\u0430"
  - choiceText: "\u042F \u043D\u0435 \u0431\u0443\u0434\u0443 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C
      \u0430\u043D\u0435\u043A\u0434\u043E\u0442. \u042F \u043F\u043E\u043A\u0430\u0436\u0443
      \u0444\u043E\u043A\u0443\u0441. \u0421\u043C\u043E\u0442\u0440\u0438, \u0443
