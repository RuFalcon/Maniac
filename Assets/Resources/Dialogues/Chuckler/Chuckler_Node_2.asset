  maniacMessages:
  - "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E! \u0425\u0410-\u0425\u0410!
    \u0422\u044B \u0443\u043C\u043D\u0438\u0446\u0430! \u0417\u0430\u0432\u0442\u0440\u0430
    \u0432\u0441\u0435\u0433\u0434\u0430 \u0432\u043F\u0435\u0440\u0435\u0434\u0438!
    \u041C\u043D\u0435 \u043D\u0440\u0430\u0432\u044F\u0442\u0441\u044F \u0443\u043C\u043D\u044B\u0435
    \u0437\u0440\u0438\u0442\u0435\u043B\u0438! \u041E\u043D\u0438 \u043B\u0443\u0447\u0448\u0435
    \u043F\u043E\u043D\u0438\u043C\u0430\u044E\u0442 \u0448\u0443\u0442\u043A\u0438."
  - "\u0410 \u0442\u0435\u043F\u0435\u0440\u044C - \u0432\u0440\u0435\u043C\u044F
    \u0434\u043B\u044F \u0444\u043E\u043A\u0443\u0441\u0430! \u041A\u0430\u0436\u0434\u043E\u043C\u0443
    \u0444\u043E\u043A\u0443\u0441\u043D\u0438\u043A\u0443 \u043D\u0443\u0436\u0435\u043D
    \u0440\u0435\u043A\u0432\u0438\u0437\u0438\u0442. \u041F\u0435\u0440\u0435\u0434
    \u0442\u043E\u0431\u043E\u0439 \u0442\u0440\u0438 \u044F\u0449\u0438\u043A\u0430.
    \u0412 \u043E\u0434\u043D\u043E\u043C - \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0435
    \u0446\u0432\u0435\u0442\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0431\u0440\u044B\u0437\u0433\u0430\u044E\u0442
    \u043A\u0438\u0441\u043B\u043E\u0442\u043E\u0439"
  - "\u0412 \u0434\u0440\u0443\u0433\u043E\u043C - \u043C\u0438\u043B\u044B\u0439
    \u0440\u0435\u0437\u0438\u043D\u043E\u0432\u044B\u0439 \u0446\u044B\u043F\u043B\u0435\u043D\u043E\u043A,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432\u0437\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F.
    \u0410 \u0432 \u0442\u0440\u0435\u0442\u044C\u0435\u043C... \u0432 \u0442\u0440\u0435\u0442\u044C\u0435\u043C
    \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u043E\u0440\u0442."
  - "\u041D\u043E \u043E\u043D \u0441 \u0441\u044E\u0440\u043F\u0440\u0438\u0437\u043E\u043C!
    \u0425\u044B-\u0445\u044B! \u0412\u044B\u0431\u0435\u0440\u0438 \u044F\u0449\u0438\u043A
    \u0434\u043B\u044F \u043D\u0430\u0448\u0435\u0433\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
    \u043D\u043E\u043C\u0435\u0440\u0430!"
