  maniacMessages:
  - "\u0428\u043D\u0443\u0440\u043E\u043A? \u0425\u044B-\u0445\u044B, \u0441\u0430\u043C\u0430\u044F
    \u0441\u0442\u0430\u0440\u0430\u044F \u0448\u0443\u0442\u043A\u0430 \u0432..."
  playerChoices: []
  victoryMessage: "\u041E\u043D \u0438\u043D\u0441\u0442\u0438\u043D\u043A\u0442\u0438\u0432\u043D\u043E
    \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432\u043D\u0438\u0437 \u043D\u0430
    \u0441\u0432\u043E\u0438 \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0435 \u043A\u043B\u043E\u0443\u043D\u0441\u043A\u0438\u0435
    \u0431\u043E\u0442\u0438\u043D\u043A\u0438. \u0412 \u044D\u0442\u043E\u0442 \u043C\u043E\u043C\u0435\u043D\u0442
    \u0432\u044B, \u043D\u0435 \u0442\u0435\u0440\u044F\u044F \u0432\u0440\u0435\u043C\u0435\u043D\u0438,
    \u0442\u043E\u043B\u043A\u0430\u0435\u0442\u0435 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0443\u044E
    \u0441\u0442\u043E\u0439\u043A\u0443 \u0441 \u0440\u0435\u043A\u0432\u0438\u0437\u0438\u0442\u043E\u043C,
    \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u044F \u0445\u0430\u043E\u0441, \u0438
    \u0431\u0440\u043E\u0441\u0430\u0435\u0442\u0435\u0441\u044C \u043A \u0434\u0432\u0435\u0440\u0438,
    \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043E\u043D \u043E\u0442\u043A\u0440\u044B\u043B,
    \u0447\u0442\u043E\u0431\u044B \u0432\u043E\u0439\u0442\u0438. \u0412\u044B \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0438
    \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044E\u044E \u0448\u0443\u0442\u043A\u0443
    \u043D\u0435 \u0434\u043B\u044F \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B
    \u0440\u0430\u0441\u0441\u043C\u0435\u0448\u0438\u0442\u044C \u0435\u0433\u043E,
    \u0430 \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u0432\u043B\u0435\u0447\u044C.
    \u0412\u044B \u0441\u0431\u0435\u0436\u0430\u043B\u0438"
