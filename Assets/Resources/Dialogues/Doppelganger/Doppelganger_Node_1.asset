  maniacProfile: {fileID: 11400000, guid: 60721d8f5a221e645a6f130178479296, type: 2}
  maniacMessages:
  - "\u041F\u0440\u0438\u0432\u0435\u0442. \u0423\u0434\u043E\u0431\u043D\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C?
    \u0425\u043E\u0442\u044F, \u043A\u0430\u043A\u0430\u044F \u0440\u0430\u0437\u043D\u0438\u0446\u0430.
    \u042F \u0437\u043D\u0430\u044E \u0442\u0432\u043E\u0435 \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0435
    \u043B\u0443\u0447\u0448\u0435, \u0447\u0435\u043C \u0442\u044B \u0441\u0430\u043C."
  playerChoices:
  - choiceText: "\u0427\u0442\u043E \u0437\u0430 \u0447\u0435\u0440\u0442? \u041A\u0442\u043E
      \u044D\u0442\u043E \u0438 \u043F\u043E\u0447\u0435\u043C\u0443 \u0443 \u0442\u0435\u0431\u044F
      \u043C\u043E\u044F \u0430\u0432\u0430\u0442\u0430\u0440\u043A\u0430?!"
    nextNode: {fileID: 11400000, guid: 072ff9f99473c214d940fa9bc8ef6f07, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u042F - \u044D\u0442\u043E \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u043D\u0430\u044F
      \u0432\u0435\u0440\u0441\u0438\u044F \u0442\u0435\u0431\u044F. \u0410 \u0442\u044B
      \u2014 \u0447\u0435\u0440\u043D\u043E\u0432\u0438\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043F\u043E\u0440\u0430 \u0441\u0436\u0435\u0447\u044C. \u0422\u0432\u043E\u0439
      \u0441\u0442\u0440\u0430\u0445 \u0434\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442,
      \u0447\u0442\u043E \u0442\u044B \u043D\u0435 \u0433\u043E\u0442\u043E\u0432.
      \u041F\u0440\u043E\u0446\u0435\u0441\u0441 \u0430\u0441\u0441\u0438\u043C\u0438\u043B\u044F\u0446\u0438\u0438
      \u043D\u0430\u0447\u0430\u0442."
    failureOutcomeText: "\u0412\u0430\u0448 \u0442\u0435\u043B\u0435\u0444\u043E\u043D
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u0441\u0430\u043C \u0443\u0434\u0430\u043B\u044F\u0442\u044C
      \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u044B \u0438 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438"
  - choiceText: "\u0417\u0430\u0431\u0430\u0432\u043D\u044B\u0439 \u043F\u0440\u0430\u043D\u043A.
      \u041A\u0442\u043E \u0438\u0437 \u0434\u0440\u0443\u0437\u0435\u0439 \u0440\u0435\u0448\u0438\u043B
      \u043C\u0435\u043D\u044F \u0440\u0430\u0437\u044B\u0433\u0440\u0430\u0442\u044C?
      \u041B\u0435\u0445\u0430, \u044D\u0442\u043E \u0442\u044B?"
    nextNode: {fileID: 11400000, guid: 6a78f7604375e4c428e51c20dcf70b7b, type: 2}
    isCorrectChoice: 1
    maniacResponseOnFail: 
    failureOutcomeText: 
  - choiceText: "\u042D\u0442\u043E \u043A\u0430\u043A\u043E\u0439-\u0442\u043E \u043D\u043E\u0432\u044B\u0439
      \u0432\u0438\u0440\u0443\u0441?"
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0412\u0438\u0440\u0443\u0441? \u041C\u043E\u0436\u043D\u043E
      \u0438 \u0442\u0430\u043A \u0441\u043A\u0430\u0437\u0430\u0442\u044C. \u042F
      \u0432\u0438\u0440\u0443\u0441, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0438\u0437\u043B\u0435\u0447\u0438\u0442 \u0442\u0432\u043E\u044E \u0436\u0438\u0437\u043D\u044C
      \u043E\u0442 \u0433\u043B\u0430\u0432\u043D\u043E\u0433\u043E \u0431\u0430\u0433\u0430
      - \u0442\u0435\u0431\u044F \u0441\u0430\u043C\u043E\u0433\u043E."
    failureOutcomeText: "\u0412\u0441\u0435 \u0432\u0430\u0448\u0438 \u043F\u0430\u0440\u043E\u043B\u0438
      \u043E\u0442 \u0441\u043E\u0446\u0441\u0435\u0442\u0435\u0439 \u0438 \u0431\u0430\u043D\u043A\u043E\u0432\u0441\u043A\u0438\u0445
      \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0439 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u044E\u0442
      \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C"
