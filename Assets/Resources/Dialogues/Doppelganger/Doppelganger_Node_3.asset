    \u044F \u0437\u0430\u0439\u043C\u0443 \u0442\u0432\u043E\u0435 \u043C\u0435\u0441\u0442\u043E.
    \u0418\u0434\u0435\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u0434\u0435\u043B\u043A\u0430."
  playerChoices:
  - choiceText: "\u041D\u0438\u043A\u043E\u0433\u0434\u0430! \u042D\u0442\u043E \u041C\u041E\u042F
      \u0436\u0438\u0437\u043D\u044C, \u043A\u0430\u043A\u043E\u0439 \u0431\u044B
      \u043E\u043D\u0430 \u043D\u0438 \u0431\u044B\u043B\u0430!"
    nextNode: {fileID: 11400000, guid: 43dfead3303a22047809afe7de6028fd, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041F\u0430\u0444\u043E\u0441\u043D\u043E. \u041D\u043E
      \u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0443\u0435\u043C\u043E. \u0427\u0442\u043E
      \u0436, \u0442\u043E\u0433\u0434\u0430 \u044F \u043F\u0440\u043E\u0441\u0442\u043E
      \u0432\u043E\u0437\u044C\u043C\u0443 \u0435\u0435 \u0441\u0438\u043B\u043E\u0439.
      \u041D\u0430\u0447\u0438\u043D\u0430\u044E \u0441 \u0442\u0432\u043E\u0435\u0433\u043E
      \u0446\u0438\u0444\u0440\u043E\u0432\u043E\u0433\u043E \u0441\u043B\u0435\u0434\u0430."
    failureOutcomeText: "\u0412\u0430\u0448\u0438 \u0430\u043A\u043A\u0430\u0443\u043D\u0442\u044B
      \u0432 \u0441\u043E\u0446\u0441\u0435\u0442\u044F\u0445 \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442
      \u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u0442\u044C \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0435,
      \u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0435\u0442\u0438\u0440\u0443\u044E\u0449\u0438\u0435
      \u043F\u043E\u0441\u0442\u044B"
  - choiceText: "\u0417\u0432\u0443\u0447\u0438\u0442 \u0437\u0430\u043C\u0430\u043D\u0447\u0438\u0432\u043E...
      \u041D\u043E \u0447\u0442\u043E \u0442\u044B \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0448\u044C
      \u0432\u0437\u0430\u043C\u0435\u043D? \u041F\u0440\u043E\u0441\u0442\u043E
      \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u043C\u0435\u043D\u044F?"
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0422\u044B \u0442\u043E\u0440\u0433\u0443\u0435\u0448\u044C\u0441\u044F
      \u0437\u0430 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E
