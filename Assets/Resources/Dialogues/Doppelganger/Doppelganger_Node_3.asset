    \u0432\u044B\u0431\u043E\u0440."
  - "\u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u043B\u0438\u0431\u043E \u0431\u043E\u0440\u043E\u0442\u044C\u0441\u044F
    \u0438 \u0431\u044B\u0442\u044C \u0441\u0442\u0435\u0440\u0442\u044B\u043C \u043D\u0430\u0441\u0438\u043B\u044C\u043D\u043E,
    \u043B\u0438\u0431\u043E \u043C\u043E\u0436\u0435\u0448\u044C \u0443\u0439\u0442\u0438
    \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u043D\u043E. \u0418\u0441\u0447\u0435\u0437\u043D\u0443\u0442\u044C"
  - "\u041D\u0430\u0447\u0430\u0442\u044C \u0432\u0441\u0435 \u0441 \u043D\u0443\u043B\u044F
    \u0433\u0434\u0435-\u043D\u0438\u0431\u0443\u0434\u044C, \u0433\u0434\u0435 \u0442\u0435\u0431\u044F
