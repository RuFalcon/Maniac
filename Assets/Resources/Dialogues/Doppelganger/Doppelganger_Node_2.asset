  maniacProfile: {fileID: 11400000, guid: 60721d8f5a221e645a6f130178479296, type: 2}
  maniacMessages:
  - "\u0422\u044B \u0432\u0441\u0435 \u0435\u0449\u0435 \u0434\u0443\u043C\u0430\u0435\u0448\u044C,
    \u0447\u0442\u043E \u044D\u0442\u043E \u0448\u0443\u0442\u043A\u0430? \u0425\u043E\u0440\u043E\u0448\u043E."
  - "\u0417\u0430\u0433\u0430\u0434\u043A\u0430 \u0434\u043B\u044F \u0442\u0435\u0431\u044F:
    \u0447\u0442\u043E \u0442\u044B \u0441\u043A\u0430\u0437\u0430\u043B \u0441\u0432\u043E\u0435\u0439
    \u043C\u0430\u0442\u0435\u0440\u0438 \u0432\u0447\u0435\u0440\u0430 \u0432 20:15,
    \u043A\u043E\u0433\u0434\u0430 \u043E\u043D\u0430 \u043F\u043E\u0437\u0432\u043E\u043D\u0438\u043B\u0430?
    \u0421\u043B\u043E\u0432\u043E \u0432 \u0441\u043B\u043E\u0432\u043E."
  playerChoices:
  - choiceText: "\u0421\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u043B\u044E\u0431\u043B\u044E
      \u0435\u0435 \u0438 \u0441\u043A\u043E\u0440\u043E \u043F\u0440\u0438\u0435\u0434\u0443."
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041B\u043E\u0436\u044C. \u0422\u044B \u0441\u043A\u0430\u0437\u0430\u043B:
      '\u041C\u0430\u043C, \u0434\u0430\u0432\u0430\u0439 \u043D\u0435 \u0441\u0435\u0439\u0447\u0430\u0441,
      \u044F \u0441\u043C\u043E\u0442\u0440\u044E \u0441\u0435\u0440\u0438\u0430\u043B'.
      \u0422\u044B \u043F\u043B\u043E\u0445\u043E\u0439 \u0441\u044B\u043D. \u042F
      \u0431\u0443\u0434\u0443 \u043B\u0443\u0447\u0448\u0435. \u042F \u0443\u0436\u0435
      \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B \u0435\u0439 \u0446\u0432\u0435\u0442\u044B
      \u043E\u0442 \u0442\u0432\u043E\u0435\u0433\u043E \u0438\u043C\u0435\u043D\u0438.
      \u0422\u043E \u0435\u0441\u0442\u044C, \u043E\u0442 \u043C\u043E\u0435\u0433\u043E."
    failureOutcomeText: "\u0412\u0430\u043C \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442
      \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u0435 \u043E\u0442
      \u0431\u0430\u043D\u043A\u0430 \u043E \u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0438
      \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u0437\u0430 \u0446\u0432\u0435\u0442\u044B"
  - choiceText: "\u0421\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u0437\u0430\u043D\u044F\u0442
      \u0438 \u043F\u0435\u0440\u0435\u0437\u0432\u043E\u043D\u044E \u043F\u043E\u0437\u0436\u0435."
    nextNode: {fileID: 11400000, guid: 43dfead3303a22047809afe7de6028fd, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0418\u043C\u0435\u043D\u043D\u043E. \u0410 \u043F\u043E\u0442\u043E\u043C
      \u043D\u0435 \u043F\u0435\u0440\u0435\u0437\u0432\u043E\u043D\u0438\u043B.
      \u042F \u044D\u0442\u043E \u0443\u0436\u0435 \u0438\u0441\u043F\u0440\u0430\u0432\u0438\u043B.
      \u041C\u044B \u043C\u0438\u043B\u043E \u043F\u043E\u0431\u043E\u043B\u0442\u0430\u043B\u0438
      15 \u043C\u0438\u043D\u0443\u0442 \u043D\u0430\u0437\u0430\u0434. \u041E\u043D\u0430
      \u0434\u0430\u0436\u0435 \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0430
      \u0440\u0430\u0437\u043D\u0438\u0446\u044B. \u0422\u044B \u043B\u0435\u0433\u043A\u043E
      \u0437\u0430\u043C\u0435\u043D\u0438\u043C."
    failureOutcomeText: "\u041D\u0430 \u0432\u0430\u0448 \u0442\u0435\u043B\u0435\u0444\u043E\u043D
      \u043F\u043E\u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u0437\u0432\u043E\u043D\u043E\u043A
      \u043E\u0442 \u043C\u0430\u043C\u044B \u0441 \u043F\u043E\u0434\u043F\u0438\u0441\u044C\u044E
      \"\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0437\u0430 \u0437\u0432\u043E\u043D\u043E\u043A,
      \u0441\u043E\u043B\u043D\u044B\u0448\u043A\u043E!\""
  - choiceText: "\u042F \u043D\u0435 \u043F\u043E\u043C\u043D\u044E. \u041A\u0442\u043E
      \u0432\u043E\u043E\u0431\u0449\u0435 \u0442\u0430\u043A\u043E\u0435 \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442?"
