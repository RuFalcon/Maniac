  maniacMessages:
  - "(\u041F\u0430\u0443\u0437\u0430 \u043D\u0430 0.5 \u0441\u0435\u043A\u0443\u043D\u0434\u044B,
    \u043F\u043E\u043A\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u043E\u0431\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442
    \u043D\u0435\u0442\u0438\u043F\u0438\u0447\u043D\u044B\u0439 \u0432\u043E\u043F\u0440\u043E\u0441).
    \"0.13% \u2014 \u044D\u0442\u043E \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u044C
    \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u0442\u044B \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u0448\u044C
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0441 \u043D\u0443\u043B\u0435\u0432\u043E\u0439
    \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u044C\u044E."
  - "\u042D\u0442\u043E \u0442\u0435\u043E\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u043F\u043E\u0433\u0440\u0435\u0448\u043D\u043E\u0441\u0442\u044C. \u041E\u043D\u0430
    \u043D\u0435 \u0438\u043C\u0435\u0435\u0442 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F."
  - "\u0422\u0432\u043E\u0439 \u0438\u043D\u0442\u0435\u0440\u0435\u0441 \u043A \u043F\u043E\u0433\u0440\u0435\u0448\u043D\u043E\u0441\u0442\u0438
    \u0437\u0430\u043D\u0435\u0441\u0435\u043D \u0432 \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B.
    \u041F\u0440\u043E\u0432\u0435\u0434\u0435\u043C \u043F\u0440\u043E\u0441\u0442\u043E\u0439
    \u0442\u0435\u0441\u0442. \u041F\u0435\u0440\u0435\u0434 \u0442\u043E\u0431\u043E\u0439
    \u043D\u0430 \u0441\u0442\u043E\u043B\u0435 \u0434\u0432\u0435 \u043A\u043D\u043E\u043F\u043A\u0438:
    \u043A\u0440\u0430\u0441\u043D\u0430\u044F \u0438 \u0441\u0438\u043D\u044F\u044F. "
  - "\u042F \u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u044E
    \u0441 \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u044C\u044E
