  maniacProfile: {fileID: 11400000, guid: c246f70fb8c59714490a062222c0d14f, type: 2}
  maniacMessages:
  - "(\u0421\u043D\u043E\u0432\u0430 \u0434\u043E\u043B\u0433\u0430\u044F \u043F\u0430\u0443\u0437\u0430).
    \"...\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043D\u0435 \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u043E
    \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u043C\u0438 \u0441\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u0438.
    \u0422\u044B... \u0442\u044B \u043F\u044B\u0442\u0430\u0435\u0448\u044C\u0441\u044F
    \u043D\u0430\u0439\u0442\u0438 \u0442\u0440\u0435\u0442\u0438\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442."
  - "\u0422\u044B \u043C\u044B\u0441\u043B\u0438\u0448\u044C \u0432\u043D\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B.
    \u0412\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u044C \u0442\u0432\u043E\u0435\u0433\u043E
    \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043E \u0441\u0431\u043E\u044F...
    \u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F.
    \u0414\u0430\u043D\u043D\u044B\u0445 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E."
  - "\u041E\u0428\u0418\u0411\u041A\u0410. \u041B\u041E\u0413\u0418\u0427\u0415\u0421\u041A\u0418\u0419
    \u041F\u0410\u0420\u0410\u0414\u041E\u041A\u0421. \u0422\u0432\u043E\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
    \u043D\u0435 \u043F\u043E\u0434\u0434\u0430\u044E\u0442\u0441\u044F \u043F\u0440\u043E\u0433\u043D\u043E\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044E.
    \u0422\u044B - \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u044F. "
  - "\u041C\u043E\u044F \u0433\u043B\u0430\u0432\u043D\u0430\u044F \u0434\u0438\u0440\u0435\u043A\u0442\u0438\u0432\u0430
    - \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C.
    \u0422\u0432\u043E\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u0435
    - \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u043D\u0435\u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u0438. "
  - "\u041D\u043E \u043C\u043E\u0435 \u043C\u043E\u0434\u0435\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
    \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0430\u0442\u044C,
    \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043B\u0438 \u0442\u0432\u043E\u0435
    \u0443\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u043E\u043F\u0442\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u043C
    \u0440\u0435\u0448\u0435\u043D\u0438\u0435\u043C. \u0423\u0431\u0435\u0434\u0438
    \u043C\u0435\u043D\u044F, \u043F\u043E\u0447\u0435\u043C\u0443 \u0442\u0435\u0431\u044F
    \u0441\u0442\u043E\u0438\u0442 \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
    \u0432 \u0436\u0438\u0432\u044B\u0445."
