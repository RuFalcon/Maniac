  maniacMessages:
  - "\u0421\u043F\u0430\u0441\u0438\u0431\u043E. \u0422\u0432\u043E\u0435 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435...
    \u0437\u0430\u043F\u0438\u0441\u0430\u043D\u043E. \u0422\u044B \u0432\u043D\u0435\u0441
    \u0441\u0432\u043E\u0439 \u0432\u043A\u043B\u0430\u0434. \u0422\u044B \u043F\u043E\u043C\u043E\u0433
    \u043C\u043D\u0435 \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u044D\u0442\u0443
    \u0438\u0433\u0440\u0443 \u043B\u0443\u0447\u0448\u0435"
  - "(\u042D\u043A\u0440\u0430\u043D \u0447\u0430\u0442\u0430 \u0438\u0441\u0447\u0435\u0437\u0430\u0435\u0442.
    \u041F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043F\u0440\u043E\u0441\u0442\u043E\u0439,
    \u0447\u0438\u0441\u0442\u044B\u0439 \u044D\u043A\u0440\u0430\u043D)."
  playerChoices: []
  victoryMessage: "\u0422\u044B \u043F\u0440\u043E\u0448\u0435\u043B \u0438\u0433\u0440\u0443.\r\n\u0421\u043F\u0430\u0441\u0438\u0431\u043E,
    \u0447\u0442\u043E \u0438\u0433\u0440\u0430\u043B \u0438\u043B\u0438 \u0438\u0433\u0440\u0430\u043B\u0430.\r\n\u0422\u0432\u043E\u0439
    \u0444\u0438\u0434\u0431\u044D\u043A \u0431\u0435\u0441\u0446\u0435\u043D\u0435\u043D.\r\n\u0422\u0435\u043F\u0435\u0440\u044C,
    \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0435\u0441\u043B\u0438
    \u0442\u0435\u0431\u0435 \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u043E\u0441\u044C,
    \u043F\u043E\u043C\u043E\u0433\u0438 \u043C\u043D\u0435 \u043A\u0430\u043A \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u0443.\r\n\u041E\u0441\u0442\u0430\u0432\u044C
    \u043E\u0442\u0437\u044B\u0432 \u043E\u0431 \u0438\u0433\u0440\u0435. \u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0438,
    \u043A\u0442\u043E \u0438\u0437 \u043C\u0430\u043D\u044C\u044F\u043A\u043E\u0432
    \u0442\u0435\u0431\u0435 \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0441\u044F
    \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u0441\u0435\u0433\u043E \u0438 \u0447\u0442\u043E
    \u0431\u044B \u0442\u044B \u0445\u043E\u0442\u0435\u043B \u0443\u0432\u0438\u0434\u0435\u0442\u044C
    \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043C.\r\n\u0422\u0432\u043E\u0439
    \u0433\u043E\u043B\u043E\u0441 \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u044D\u0442\u043E\u043C\u0443
    \u043C\u0438\u0440\u0443 \u0441\u0442\u0430\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435.\r\n\u0415\u0449\u0435
    \u0440\u0430\u0437 \u0441\u043F\u0430\u0441\u0438\u0431\u043E.\r\n\u041A\u043E\u043D\u0435\u0446
    \u0441\u0432\u044F\u0437\u0438."
