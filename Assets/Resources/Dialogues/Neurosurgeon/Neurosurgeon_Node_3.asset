  maniacMessages:
  - "(\u0412\u0430\u0448\u0430 \u0440\u0443\u043A\u0430 \u0434\u0435\u0440\u0433\u0430\u0435\u0442\u0441\u044F,
    \u043D\u043E \u0441 \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u043C \u0443\u0441\u0438\u043B\u0438\u0435\u043C
    \u0432\u044B \u043C\u0435\u043D\u044F\u0435\u0442\u0435 \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u044E
    \u0438 \u0431\u044C\u0435\u0442\u0435 \u043F\u043E \u0441\u0442\u0430\u043A\u0430\u043D\u0443.
    \u041E\u043D \u0440\u0430\u0437\u043B\u0435\u0442\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u043E\u0441\u043A\u043E\u043B\u043A\u0438). "
  - "<\u0410\u043D\u043E\u043C\u0430\u043B\u0438\u044F! \u0417\u0430\u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043E
    \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E\u0435 \u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0435\u043D\u0438\u0435
    \u043A\u043E\u043C\u0430\u043D\u0434\u044B! \u041A\u0430\u043A?..> \u0422\u044B...
    \u0442\u044B \u0441\u043C\u043E\u0433 \u043E\u043A\u0430\u0437\u0430\u0442\u044C
    \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u0435?"
  - "\u041D\u0435 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0435, \u0430
    \u0432\u043E\u043B\u0435\u0432\u043E\u0435... \u042D\u0442\u043E \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E!
    \u0421\u0438\u0441\u0442\u0435\u043C\u0430 \u043D\u0435\u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u0430!"
  - "\u0422\u044B - \u043A\u043B\u044E\u0447 \u043A \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044E
    \u043C\u043E\u0435\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u044B! \u0422\u0432\u043E\u044F
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u043A \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u044E
    - \u044D\u0442\u043E \u043D\u0435 \u0431\u0430\u0433, \u044D\u0442\u043E \u0444\u0438\u0447\u0430,
    \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u044F \u0434\u043E\u043B\u0436\u0435\u043D
    \u0438\u0437\u0443\u0447\u0438\u0442\u044C!"
  - "\u042F \u0434\u0430\u043C \u0442\u0435\u0431\u0435 \u043D\u043E\u0432\u0443\u044E
    \u0437\u0430\u0434\u0430\u0447\u0443. \u042F \u043F\u0440\u0438\u043A\u0430\u0437\u044B\u0432\u0430\u044E
    \u0442\u0435\u0431\u0435 \u0432\u0437\u044F\u0442\u044C \u043E\u0441\u043A\u043E\u043B\u043E\u043A
    \u0441\u0442\u0435\u043A\u043B\u0430 \u0438 \u0441\u0434\u0435\u043B\u0430\u0442\u044C
    \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043D\u0430\u0434\u0440\u0435\u0437
    \u043D\u0430 \u0441\u0432\u043E\u0435\u0439 \u0440\u0443\u043A\u0435. "
  - "\u041D\u043E \u044F \u0442\u0430\u043A\u0436\u0435 \u0437\u043D\u0430\u044E,
    \u0447\u0442\u043E \u0442\u0432\u043E\u0439 \u0438\u043D\u0441\u0442\u0438\u043D\u043A\u0442
    \u0441\u0430\u043C\u043E\u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F
    \u0431\u0443\u0434\u0435\u0442 \u044D\u0442\u043E\u043C\u0443 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u044F\u0442\u044C\u0441\u044F.
    \u0427\u044C\u044F \u043A\u043E\u043C\u0430\u043D\u0434\u0430 \u043E\u043A\u0430\u0436\u0435\u0442\u0441\u044F
    \u0441\u0438\u043B\u044C\u043D\u0435\u0435? \u041C\u043E\u044F \u0438\u043B\u0438
    \u0442\u0432\u043E\u0435\u0433\u043E \u043C\u043E\u0437\u0433\u0430?"
