  maniacProfile: {fileID: 11400000, guid: a05d443e48cb56a43ba5b8e4bd41fea1, type: 2}
  maniacMessages:
  - "\u0414\u043E\u0431\u0440\u043E\u0433\u043E \u0441\u043D\u0430. \u041D\u0440\u0430\u0432\u0438\u0442\u0441\u044F
    \u043C\u043E\u0439 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u0440\u0435\u043C\u043E\u043D\u0442?
    \u041D\u0435 \u043F\u044B\u0442\u0430\u0439\u0441\u044F \u043F\u0440\u043E\u0441\u043D\u0443\u0442\u044C\u0441\u044F.
    \u0422\u044B \u043D\u0435 \u0441\u043C\u043E\u0436\u0435\u0448\u044C. \u041F\u043E\u043A\u0430
    \u044F \u043D\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0443."
  - "\u0414\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u0430, \u0434\u0430\u0432\u0430\u0439
    \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043C, \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C
    \u043B\u0438 \u0442\u044B, \u0433\u0434\u0435 \u043D\u0430\u0445\u043E\u0434\u0438\u0448\u044C\u0441\u044F.
    \u0427\u0442\u043E \u043D\u0435 \u0442\u0430\u043A \u0441 \u0442\u0432\u043E\u0438\u043C
    \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u043E\u043C?"
  playerChoices:
  - choiceText: "\u041E\u043D \u0441\u0434\u0435\u043B\u0430\u043D \u0438\u0437 \u0448\u043E\u043A\u043E\u043B\u0430\u0434\u0430!"
    nextNode: {fileID: 11400000, guid: fe7d852001f89d945abef86529d17340, type: 2}
    isCorrectChoice: 1
    maniacResponseOnFail: 
    failureOutcomeText: 
  - choiceText: "\u041E\u043D \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442, \u0445\u043E\u0442\u044F
      \u043D\u0435 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D \u043A
      \u0440\u043E\u0437\u0435\u0442\u043A\u0435!"
    nextNode: {fileID: 11400000, guid: 072ff9f99473c214d940fa9bc8ef6f07, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041D\u0435\u0432\u0435\u0440\u043D\u043E. \u0412\u043E
      \u0441\u043D\u0435 \u043D\u0438\u0447\u0435\u043C\u0443 \u043D\u0435 \u043D\u0443\u0436\u043D\u0430
      \u044D\u043D\u0435\u0440\u0433\u0438\u044F. \u041A\u0440\u043E\u043C\u0435
      \u043C\u0435\u043D\u044F. \u0410 \u0442\u044B \u0442\u043E\u043B\u044C\u043A\u043E
      \u0447\u0442\u043E \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u043B \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0441\u0432\u043E\u0435\u0439, \u0437\u0430\u0434\u0430\u0432 \u0433\u043B\u0443\u043F\u044B\u0439
      \u0432\u043E\u043F\u0440\u043E\u0441."
    failureOutcomeText: "\u0412\u044B \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435
      \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u0443\u044E, \u0441\u0438\u043B\u044C\u043D\u0443\u044E
      \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u044C, \u043A\u0430\u043A
      \u0431\u0443\u0434\u0442\u043E \u043D\u0435 \u0441\u043F\u0430\u043B\u0438
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u0443\u0442\u043E\u043A"
  - choiceText: "\u041A\u0442\u043E \u0442\u044B \u0442\u0430\u043A\u043E\u0439?!
      \u0427\u0442\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442?!"
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041F\u0430\u043D\u0438\u043A\u0430. \u0421\u0430\u043C\u0430\u044F
      \u0431\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u043D\u0430\u044F \u044D\u043C\u043E\u0446\u0438\u044F
      \u0432\u043E \u0441\u043D\u0435. \u041E\u043D\u0430 \u043B\u0438\u0448\u044C
      \u0437\u0430\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442 \u0442\u0435\u0431\u044F
      \u0433\u043B\u0443\u0431\u0436\u0435."
    failureOutcomeText: "\u041F\u043E\u043B \u043F\u043E\u0434 \u0432\u0430\u0448\u0435\u0439
      \u043A\u0440\u043E\u0432\u0430\u0442\u044C\u044E \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
