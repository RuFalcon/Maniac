    \u043D\u0435 \u0441\u0442\u0430\u043B \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0430\u0442\u044C.
    \u0422\u044B \u0434\u0430\u043B \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442.
    \u041F\u043E\u0445\u0432\u0430\u043B\u044C\u043D\u043E."
  - " \u041A \u0434\u043E\u0441\u043A\u0435. \u0422\u0435\u043C\u0430: \"\u0427\u0435\u043C\u0443
    \u044F \u043D\u0430\u0443\u0447\u0438\u043B\u0441\u044F \u0432 \u0436\u0438\u0437\u043D\u0438\".
    \u0423 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C \u043C\u0435\u043B.
    \u0423 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C \u0442\u0440\u0438 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430
    \u043E\u0442\u0432\u0435\u0442\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u043D\u0430\u043F\u0438\u0441\u0430\u0442\u044C."
  - "\u0422\u044B \u0434\u043E\u043B\u0436\u0435\u043D \u0432\u044B\u0431\u0440\u0430\u0442\u044C
    \u0442\u043E\u0442, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u044F \u0441\u043E\u0447\u0442\u0443
    \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u043C."
  - "(\u041D\u0430 \u0434\u043E\u0441\u043A\u0435 \u0442\u0440\u0438 \u043D\u0430\u0434\u043F\u0438\u0441\u0438:
