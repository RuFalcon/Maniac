  - choiceText: "15 \u043F\u043B\u044E\u0441 10 \u043F\u043B\u044E\u0441 4... \u044D\u0442\u043E
      29."
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041E\u0442\u0432\u0435\u0442 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439,
      \u043D\u043E \u0442\u044B \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0430\u043B
      \u0432\u0441\u043B\u0443\u0445. \u0425\u043E\u0440\u043E\u0448\u0438\u0439
      \u0443\u0447\u0435\u043D\u0438\u043A \u0440\u0435\u0448\u0430\u0435\u0442 \u0432
      \u0443\u043C\u0435. \u0422\u0432\u043E\u044F \u043D\u0435\u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u044C
      - \u0442\u0432\u043E\u044F \u0441\u043B\u0430\u0431\u043E\u0441\u0442\u044C."
    failureOutcomeText: "\u041E\u043D\u0430 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u043A \u0434\u043E\u0441\u043A\u0435 \u0438 \u0441 \u043E\u0442\u0432\u0440\u0430\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C
