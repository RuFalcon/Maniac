      \u043D\u0435\u0439 \u043C\u0435\u043B\u043E\u043C \u0432\u0430\u0448\u0435
      \u0438\u043C\u044F \u0432 \u0441\u043F\u0438\u0441\u043A\u0435 \"\u0434\u0432\u043E\u0435\u0447\u043D\u0438\u043A\u043E\u0432\""
  - choiceText: "\u042D\u0442\u043E \u043D\u0435\u043A\u043E\u0440\u0440\u0435\u043A\u0442\u043D\u0430\u044F
      \u0437\u0430\u0434\u0430\u0447\u0430. \u041D\u0435\u043B\u044C\u0437\u044F
      \"\u0438\u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C\" \u0443\u0447\u0435\u043D\u0438\u043A\u0430."
    nextNode: {fileID: 11400000, guid: 43dfead3303a22047809afe7de6028fd, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041E\u043F\u044F\u0442\u044C \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0438\u044F?
      \u042F \u0437\u0430\u0434\u0430\u043B\u0430 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E
      \u0437\u0430\u0434\u0430\u0447\u0443. \u0422\u0440\u0435\u0431\u043E\u0432\u0430\u043B\u0441\u044F
      \u0447\u0438\u0441\u043B\u043E\u0432\u043E\u0439 \u043E\u0442\u0432\u0435\u0442.
      \u0422\u044B \u043D\u0435 \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F
      \u0441 \u0437\u0430\u0434\u0430\u043D\u0438\u0435\u043C."
    failureOutcomeText: "\u041E\u043D\u0430 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u0438 \u043A\u043E\u043D\u0444\u0438\u0441\u043A\u0443\u0435\u0442 \u0432\u0430\u0448\u0443
