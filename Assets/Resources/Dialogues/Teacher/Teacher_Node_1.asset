  maniacProfile: {fileID: 11400000, guid: c3fd6e23e3f6a3341a498fdb9df6023d, type: 2}
  maniacMessages:
  - "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439. \u042F \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0430
    \u0442\u0432\u043E\u0438 \"\u043E\u0446\u0435\u043D\u043A\u0438\" \u043F\u043E
    \u0436\u0438\u0437\u043D\u0438. \u041D\u0435\u0443\u0434\u043E\u0432\u043B\u0435\u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E.
    \u0421\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E \u043E\u0448\u0438\u0431\u043E\u043A.
    \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0443 \u043D\u0430\u0441 \u0440\u0430\u0431\u043E\u0442\u0430
    \u043D\u0430\u0434 \u043E\u0448\u0438\u0431\u043A\u0430\u043C\u0438. "
  - "\u041D\u0430\u0447\u043D\u0435\u043C \u0441 \u043F\u0440\u043E\u0441\u0442\u043E\u0433\u043E.
    \u0418\u0441\u043F\u0440\u0430\u0432\u044C \u043E\u0448\u0438\u0431\u043A\u0443
    \u0432 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0438: \"\u0421\u043E\u043B\u043D\u0446\u0435
    \u0441\u0432\u0435\u0442\u0438\u0442, \u0438 \u043F\u0442\u0438\u0447\u043A\u0438
    \u043F\u043E\u044E\u0442\"."
  playerChoices:
  - choiceText: "\u0417\u0434\u0435\u0441\u044C \u043D\u0435\u0442 \u043E\u0448\u0438\u0431\u043A\u0438."
    nextNode: {fileID: 11400000, guid: 072ff9f99473c214d940fa9bc8ef6f07, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "(\u041F\u0438\u0448\u0435\u0442 \u043D\u0430 \u043B\u0438\u0441\u0442\u043A\u0435)
      \"\u041E\u0428\u0418\u0411\u041A\u0410 \u0415\u0421\u0422\u042C \u0412\u0421\u0415\u0413\u0414\u0410.
      \u0414\u0412\u0410."
    failureOutcomeText: "\u041E\u043D\u0430 \u0441 \u0441\u0438\u043B\u043E\u0439
      \u0441\u0442\u0443\u0447\u0438\u0442 \u0443\u043A\u0430\u0437\u043A\u043E\u0439
      \u043F\u043E \u0441\u0442\u043E\u043B\u0443. \u0412\u044B \u0441\u043B\u044B\u0448\u0438\u0442\u0435,
      \u043A\u0430\u043A \u0437\u0430\u043C\u043E\u043A \u043D\u0430 \u0434\u0432\u0435\u0440\u0438
      \u0449\u0435\u043B\u043A\u0430\u0435\u0442, \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044F
      \u0435\u0449\u0435 \u043E\u0434\u0438\u043D \u043E\u0431\u043E\u0440\u043E\u0442"
  - choiceText: "\u041D\u0443\u0436\u043D\u043E \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0442\u0438\u0440\u0435, \u0430 \u043D\u0435 \u0437\u0430\u043F\u044F\u0442\u0443\u044E."
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041D\u0415\u0412\u0415\u0420\u041D\u041E. \u0422\u0432\u043E\u0438
      \u0437\u043D\u0430\u043D\u0438\u044F \u0433\u0440\u0430\u043C\u043C\u0430\u0442\u0438\u043A\u0438
      \u043D\u0435\u0443\u0434\u043E\u0432\u043B\u0435\u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B.
      \u041E\u0441\u0442\u0430\u0435\u0448\u044C\u0441\u044F \u043F\u043E\u0441\u043B\u0435
      \u0443\u0440\u043E\u043A\u043E\u0432."
    failureOutcomeText: "\u0421\u0432\u0435\u0442 \u0432 \u043A\u043B\u0430\u0441\u0441\u0435
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0435\u0449\u0435
      \u0442\u0443\u0441\u043A\u043B\u0435\u0435, \u0441\u0433\u0443\u0449\u0430\u044F
      \u0442\u0435\u043D\u0438 \u043F\u043E \u0443\u0433\u043B\u0430\u043C"
  - choiceText: "\u041E\u0448\u0438\u0431\u043A\u0430 \u0432 \u0442\u043E\u043C,
      \u0447\u0442\u043E \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u043E\u0447\u044C
      \u0418 \u0441\u043E\u043B\u043D\u0446\u0435 \u043D\u0435 \u0441\u0432\u0435\u0442\u0438\u0442,
      \u0438 \u043F\u0442\u0438\u0447\u043A\u0438 \u043D\u0435 \u043F\u043E\u044E\u0442."
