    \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442, \u0447\u0442\u043E
    \u0434\u0430\u0436\u0435 \u0432\u043D\u0443\u0442\u0440\u0438 \u0434\u043E\u043C\u0430
    \u0435\u0441\u0442\u044C \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435
