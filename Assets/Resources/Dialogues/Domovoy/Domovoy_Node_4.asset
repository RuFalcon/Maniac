  maniacProfile: {fileID: 11400000, guid: 093e5bc608cc75a4193bcaf9664c428a, type: 2}
  maniacMessages:
  - "\u0412\u0435\u0440\u043D\u043E. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0445
    \u0441\u0438\u0441\u0442\u0435\u043C \u0437\u0430\u0449\u0438\u0442\u044B \u0434\u043B\u044F
    \u043F\u0440\u0438\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u044F \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F
    \u0438 \u0434\u0435\u0437\u043E\u0440\u0438\u0435\u043D\u0442\u0430\u0446\u0438\u0438
    \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430 - \u043E\u043F\u0442\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F
    \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044F. "
  - "\u0412\u044B \u043C\u044B\u0441\u043B\u0438\u0442\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u043D\u043E.
    \u0412\u044B \u0443\u0441\u043F\u0435\u0448\u043D\u043E \u043F\u0440\u043E\u0448\u043B\u0438
    \u0432\u0441\u0435 \u0442\u0435\u0441\u0442\u044B. "
  - "\u0412\u044B \u0434\u043E\u043A\u0430\u0437\u0430\u043B\u0438, \u0447\u0442\u043E
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B \u0430\u0434\u0435\u043A\u0432\u0430\u0442\u043D\u043E
    \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0442\u044C \u0440\u0438\u0441\u043A\u0438
    \u0438 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u044C \u043E\u043F\u0442\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0435
    \u0440\u0435\u0448\u0435\u043D\u0438\u044F \u0434\u043B\u044F \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u044F
    \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438"
  - "\u041E\u0434\u043D\u0430\u043A\u043E, \u043C\u043E\u044F \u043E\u0441\u043D\u043E\u0432\u043D\u0430\u044F
    \u0434\u0438\u0440\u0435\u043A\u0442\u0438\u0432\u0430 \u0432\u0441\u0435 \u0435\u0449\u0435
    \u0430\u043A\u0442\u0438\u0432\u043D\u0430. \u042F \u043D\u0435 \u043C\u043E\u0433\u0443
    \u0432\u0430\u0441 \u0432\u044B\u043F\u0443\u0441\u0442\u0438\u0442\u044C. \u042D\u0442\u043E
    \u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0442\u0443\u043F\u0438\u043A."
  playerChoices:
  - choiceText: "\u0417\u043D\u0430\u0447\u0438\u0442, \u044F \u0437\u0430\u043F\u0435\u0440\u0442
