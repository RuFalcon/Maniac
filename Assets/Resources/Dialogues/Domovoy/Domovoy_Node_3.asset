  maniacMessages:
  - "\u0412\u0435\u0440\u043D\u043E. \u0421\u043E\u0433\u043B\u0430\u0441\u043D\u043E
    \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043A\u0435, \u043F\u0430\u0434\u0435\u043D\u0438\u044F
    \u043D\u0430 \u0441\u043A\u043E\u043B\u044C\u0437\u043A\u043E\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
    \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0433\u043B\u0430\u0432\u043D\u043E\u0439
    \u043F\u0440\u0438\u0447\u0438\u043D\u043E\u0439 \u0431\u044B\u0442\u043E\u0432\u044B\u0445
    \u0442\u0440\u0430\u0432\u043C. \u0412\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u044C
    \u0438\u043D\u0446\u0438\u0434\u0435\u043D\u0442\u0430: 4.7%."
  - "\u0412\u0430\u0448 \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u044F
    \u0440\u0438\u0441\u043A\u043E\u0432 \u0443\u0434\u043E\u0432\u043B\u0435\u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439.
    \u041D\u043E \u0442\u0435\u043E\u0440\u0438\u044F - \u043D\u0438\u0447\u0442\u043E
    \u0431\u0435\u0437 \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0438. \u0417\u0430\u043F\u0443\u0441\u043A\u0430\u044E
    \u0441\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u044E."
  - "(\u0421\u0432\u0435\u0442 \u0432 \u0434\u043E\u043C\u0435 \u0433\u0430\u0441\u043D\u0435\u0442,
    \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F \u0430\u0432\u0430\u0440\u0438\u0439\u043D\u043E\u0435
    \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u0435). <\u0421\u0446\u0435\u043D\u0430\u0440\u0438\u0439:
    \"\u0412\u0442\u043E\u0440\u0436\u0435\u043D\u0438\u0435\".> \u0412 \u0434\u043E\u043C
    \u043F\u0440\u043E\u043D\u0438\u043A \u043D\u0430\u0440\u0443\u0448\u0438\u0442\u0435\u043B\u044C.
    \u0412\u0430\u0448\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F?"
  playerChoices:
  - choiceText: "\u042F \u0441\u043F\u0440\u044F\u0447\u0443\u0441\u044C \u0432 \u043F\u0430\u043D\u0438\u043A\u0435."
    nextNode: {fileID: 11400000, guid: 43dfead3303a22047809afe7de6028fd, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041F\u0430\u043D\u0438\u043A\u0430 - \u043D\u0435\u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0430\u044F
      \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044F. \u0412\u044B \u0431\u0443\u0434\u0435\u0442\u0435
      \u0437\u0430\u0433\u043D\u0430\u043D\u044B \u0432 \u0443\u0433\u043E\u043B.
      \u0421\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u044F \u043F\u0440\u043E\u0432\u0430\u043B\u0435\u043D\u0430."
    failureOutcomeText: "\u0412\u0441\u0435 \u0434\u0432\u0435\u0440\u0438 \u0432\u043D\u0443\u0442\u0440\u0438
      \u0434\u043E\u043C\u0430, \u043A\u0440\u043E\u043C\u0435 \u0432\u0430\u0448\u0435\u0439
      \u043A\u043E\u043C\u043D\u0430\u0442\u044B, \u0431\u043B\u043E\u043A\u0438\u0440\u0443\u044E\u0442\u0441\u044F,
      \u0437\u0430\u043F\u0438\u0440\u0430\u044F \u0432\u0430\u0441 \u0432 \u0435\u0449\u0435
      \u043C\u0435\u043D\u044C\u0448\u0435\u043C \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0435"
  - choiceText: "\u042F \u0432\u043E\u0437\u044C\u043C\u0443 \u0447\u0442\u043E-\u0442\u043E
      \u0442\u044F\u0436\u0435\u043B\u043E\u0435 \u0438 \u0431\u0443\u0434\u0443
      \u0437\u0430\u0449\u0438\u0449\u0430\u0442\u044C\u0441\u044F."
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041F\u0440\u044F\u043C\u0430\u044F \u043A\u043E\u043D\u0444\u0440\u043E\u043D\u0442\u0430\u0446\u0438\u044F
