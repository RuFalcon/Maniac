    \u0447\u0435\u0441\u0442\u044C - \u0438\u0441\u043F\u0438\u0442\u044C \u043C\u0435\u043D\u044F."
  - "\u041D\u043E \u0435\u0441\u0442\u044C \u043E\u0434\u043D\u043E \u0443\u0441\u043B\u043E\u0432\u0438\u0435.
