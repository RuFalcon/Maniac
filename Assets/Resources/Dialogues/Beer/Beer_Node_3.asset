  - choiceText: "\u0421\u0443\u0445\u0430\u0440\u0438\u043A\u0438."
    nextNode: {fileID: 11400000, guid: 43dfead3303a22047809afe7de6028fd, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0421\u0423\u0425\u0410\u0420\u0418\u041A\u0418?! \u042D\u0442\u0443
      \u0431\u0435\u0437\u0432\u043A\u0443\u0441\u043D\u0443\u044E \u0442\u0440\u0443\u0445\u0443?!
      \u0422\u044B \u0445\u043E\u0447\u0435\u0448\u044C \u043E\u0441\u043A\u043E\u0440\u0431\u0438\u0442\u044C
      \u043C\u0435\u043D\u044F?! \u042D\u0442\u043E \u0435\u0434\u0430 \u0434\u043B\u044F
      \u0432\u0430\u0440\u0432\u0430\u0440\u043E\u0432!"
    failureOutcomeText: "\u0422\u0430\u0440\u0435\u043B\u043A\u0430 \u0441 \u0441\u0443\u0445\u0430\u0440\u0438\u043A\u0430\u043C\u0438
      \u0432\u0437\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F, \u043E\u0441\u044B\u043F\u0430\u044F
      \u0432\u0430\u0441 \u0441\u043E\u043B\u0435\u043D\u044B\u043C\u0438 \u043A\u0440\u043E\u0448\u043A\u0430\u043C\u0438"
  - choiceText: "\u0420\u044B\u0431\u0430."
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0420\u042B\u0411\u0410?! \u0422\u044B \u0445\u043E\u0447\u0435\u0448\u044C
      \u043F\u0435\u0440\u0435\u0431\u0438\u0442\u044C \u043C\u043E\u0439 \u0442\u043E\u043D\u043A\u0438\u0439
      \u0430\u0440\u043E\u043C\u0430\u0442 \u0432\u043E\u043D\u044C\u044E \u0434\u043E\u0445\u043B\u043E\u0439
      \u0441\u0435\u043B\u0435\u0434\u043A\u0438?! \u041D\u0415\u041F\u0420\u041E\u0421\u0422\u0418\u0422\u0415\u041B\u042C\u041D\u041E!"
    failureOutcomeText: "\u0412\u044F\u043B\u0435\u043D\u0430\u044F \u0440\u044B\u0431\u0430
      \u043D\u0430 \u0442\u0430\u0440\u0435\u043B\u043A\u0435 \u043E\u0436\u0438\u0432\u0430\u0435\u0442
