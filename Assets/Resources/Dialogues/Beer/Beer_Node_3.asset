  maniacMessages:
  - "\u0412\u0435\u0440\u043D\u043E! \u0422\u044B \u0443\u043B\u043E\u0432\u0438\u043B
    \u0442\u043E\u043D\u043A\u0438\u0435 \u043D\u043E\u0442\u043A\u0438! \u0423 \u0442\u0435\u0431\u044F
    \u0435\u0441\u0442\u044C \u0437\u0430\u0434\u0430\u0442\u043A\u0438!"
  - "\u0423\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E. \u0422\u0432\u043E\u0438
    \u0440\u0435\u0446\u0435\u043F\u0442\u043E\u0440\u044B \u043D\u0435 \u0442\u0430\u043A
    \u043C\u0435\u0440\u0442\u0432\u044B, \u043A\u0430\u043A \u044F \u0434\u0443\u043C\u0430\u043B.
    \u041D\u043E \u0431\u043B\u0430\u0433\u043E\u0440\u043E\u0434\u043D\u044B\u0439
    \u043D\u0430\u043F\u0438\u0442\u043E\u043A \u0442\u0440\u0435\u0431\u0443\u0435\u0442
    \u0431\u043B\u0430\u0433\u043E\u0440\u043E\u0434\u043D\u043E\u0439 \u0437\u0430\u043A\u0443\u0441\u043A\u0438."
  - "\u042F \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0438\u0437\u0443\u044E
    \u0442\u0440\u0438 \u0431\u043B\u044E\u0434\u0430. \u0412\u044B\u0431\u0435\u0440\u0438
    \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E \u0432\u0435\u0440\u043D\u043E\u0435
    \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0435 \u0434\u043B\u044F \u0431\u0435\u043B\u044C\u0433\u0438\u0439\u0441\u043A\u043E\u0433\u043E
    \u044D\u043B\u044F."
  playerChoices:
  - choiceText: "\u0421\u044B\u0440 \u0411\u0440\u0438."
