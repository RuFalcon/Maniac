    \u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0430\u0442!"
  playerChoices:
  - choiceText: "\u0421\u043A\u043E\u043B\u044C\u043A\u043E \u0442\u044B \u0445\u043E\u0447\u0435\u0448\u044C,
      \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u043C\u043E\u043B\u0447\u0430\u0442\u044C
      \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430?"
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0412\u0438\u0434\u0438\u0448\u044C! \u0417\u043D\u0430\u0447\u0438\u0442,
      \u0432\u0441\u0435-\u0442\u0430\u043A\u0438 \u0435\u0441\u0442\u044C, \u0447\u0442\u043E
      \u0441\u043A\u0440\u044B\u0432\u0430\u0442\u044C! \u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u043C\u0441\u044F
      \u043A \u0446\u0435\u043D\u0435."
    failureOutcomeText: "\u0412\u044B \u0441\u043D\u043E\u0432\u0430 \u043F\u043E\u043F\u0430\u043B\u0438\u0441\u044C
      \u043D\u0430 \u043A\u0440\u044E\u0447\u043E\u043A, \u043F\u0440\u043E\u044F\u0432\u0438\u0432
      \u0441\u0442\u0440\u0430\u0445"
  - choiceText: "\u0415\u0449\u0435 \u043E\u0434\u043D\u0430 \u0442\u0430\u043A\u0430\u044F
      \u0443\u0433\u0440\u043E\u0437\u0430, \u0438 \u044F \u0432\u0441\u0435-\u0442\u0430\u043A\u0438
      \u043F\u043E\u0439\u0434\u0443 \u0432 \u043F\u043E\u043B\u0438\u0446\u0438\u044E.
      \u0422\u0435\u043F\u0435\u0440\u044C \u0443 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C
      \u043D\u0430\u0448\u0430 \u043F\u0435\u0440\u0435\u043F\u0438\u0441\u043A\u0430."
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0423\u0434\u0430\u0447\u0438 \u0442\u0435\u0431\u0435
      \u0441 \u044D\u0442\u0438\u043C."
    failureOutcomeText: "\u041E\u043D \u043C\u043E\u0436\u0435\u0442 \u0438\u0441\u043F\u0443\u0433\u0430\u0442\u044C\u0441\u044F
