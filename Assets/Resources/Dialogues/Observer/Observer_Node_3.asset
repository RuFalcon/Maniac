    isCorrectChoice: 0
    maniacResponseOnFail: "\u042F \u0442\u0430\u043A \u0438 \u0434\u0443\u043C\u0430\u043B."
    failureOutcomeText: "\u0412\u044B \u0441\u0430\u043C\u0438 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043B\u0438,
