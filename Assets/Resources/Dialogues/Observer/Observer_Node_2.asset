  maniacProfile: {fileID: 11400000, guid: 71193edbcbaa7f449afa6fa62eb1a099, type: 2}
  maniacMessages:
  - "(\u041F\u0430\u0443\u0437\u0430). \"...\u041D\u0435 \u043F\u0430\u043D\u0438\u043A\u0443\u0435\u0448\u044C?
    \u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E. \u0420\u0435\u0447\u044C
    \u043E \u0442\u043E\u043C \u0441\u0430\u043C\u043E\u043C \u0441\u0435\u043A\u0440\u0435\u0442\u0435.
    \u041D\u0435 \u043F\u0440\u0438\u043A\u0438\u0434\u044B\u0432\u0430\u0439\u0441\u044F,
    \u0447\u0442\u043E \u043D\u0435 \u043F\u043E\u043D\u044F\u043B."
  - "\u0425\u0432\u0430\u0442\u0438\u0442 \u0438\u0433\u0440. \u0423 \u043C\u0435\u043D\u044F
    \u0435\u0441\u0442\u044C \u0444\u0430\u0439\u043B. \u0424\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438.
    \u0412\u0438\u0434\u0435\u043E. \u0415\u0441\u043B\u0438 \u0442\u044B \u043D\u0435
    \u0445\u043E\u0447\u0435\u0448\u044C, \u0447\u0442\u043E\u0431\u044B \u0442\u0432\u043E\u0438
    \u0434\u0440\u0443\u0437\u044C\u044F, \u0441\u0435\u043C\u044C\u044F \u0438 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A
    \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438 \u0435\u0433\u043E, \u0442\u044B
    \u0431\u0443\u0434\u0435\u0448\u044C \u0434\u0435\u043B\u0430\u0442\u044C \u0442\u043E,
    \u0447\u0442\u043E \u044F \u0441\u043A\u0430\u0436\u0443."
  - "\u0414\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u0430, \u043F\u0435\u0440\u0435\u0432\u0435\u0434\u0438
    1000 \u0434\u043E\u043B\u043B\u0430\u0440\u043E\u0432 \u043D\u0430 \u044D\u0442\u043E\u0442
    \u0441\u0447\u0435\u0442. \u042D\u0442\u043E \u0442\u043E\u043B\u044C\u043A\u043E
    \u043D\u0430\u0447\u0430\u043B\u043E."
  playerChoices:
  - choiceText: "\u0423 \u043C\u0435\u043D\u044F \u043D\u0435\u0442 \u0442\u0430\u043A\u0438\u0445
      \u0434\u0435\u043D\u0435\u0433!"
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041D\u0435\u0442 \u0434\u0435\u043D\u0435\u0433? \u041D\u0430\u0439\u0434\u0438.
      \u0423 \u0442\u0435\u0431\u044F 24 \u0447\u0430\u0441\u0430. \u0412\u0440\u0435\u043C\u044F
      \u043F\u043E\u0448\u043B\u043E."
    failureOutcomeText: "\u041E\u043D \u0432\u0435\u0440\u0438\u0442, \u0447\u0442\u043E
      \u0432\u044B \u043D\u0430\u043F\u0443\u0433\u0430\u043D\u044B \u0438 \u043D\u0430
      \u043A\u0440\u044E\u0447\u043A\u0435. \u0414\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F"
  - choiceText: "\u0425\u043E\u0440\u043E\u0448\u043E, \u044F \u0437\u0430\u043F\u043B\u0430\u0447\u0443.
      \u0422\u043E\u043B\u044C\u043A\u043E \u0443\u0434\u0430\u043B\u0438 \u0444\u0430\u0439\u043B
      \u043F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0433\u043E."
    nextNode: {fileID: 11400000, guid: 43dfead3303a22047809afe7de6028fd, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041A\u043E\u043D\u0435\u0447\u043D\u043E, \u0443\u0434\u0430\u043B\u044E.
      \u0427\u0435\u0441\u0442\u043D\u043E\u0435 \u0441\u043B\u043E\u0432\u043E."
    failureOutcomeText: "\u041E\u043D \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
      \u0434\u0435\u043D\u044C\u0433\u0438 \u0438, \u0440\u0430\u0437\u0443\u043C\u0435\u0435\u0442\u0441\u044F,
      \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0443\u0434\u0430\u043B\u044F\u0435\u0442,
      \u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C
      \u0435\u0449\u0435 \u0431\u043E\u043B\u044C\u0448\u0435. \u0412\u044B \u043F\u043E\u043F\u0430\u043B\u0438
      \u0432 \u0446\u0438\u043A\u043B \u0448\u0430\u043D\u0442\u0430\u0436\u0430"
  - choiceText: "\u041F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u044F \u0447\u0442\u043E-\u0442\u043E
      \u0431\u0443\u0434\u0443 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0438\u0442\u044C,
      \u044F \u0445\u043E\u0447\u0443 \u0443\u0432\u0438\u0434\u0435\u0442\u044C
      \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E."
