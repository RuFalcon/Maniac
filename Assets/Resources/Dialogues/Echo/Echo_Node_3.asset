  maniacMessages:
  - "(\u0413\u043E\u043B\u043E\u0441 \u043C\u043E\u043B\u043E\u0434\u043E\u0433\u043E
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u043D\u0430 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435
    \u0441\u0431\u0438\u0432\u0430\u0435\u0442\u0441\u044F, \u043F\u0440\u0435\u0440\u044B\u0432\u0430\u044F\u0441\u044C
    \u043F\u043E\u043C\u0435\u0445\u0430\u043C\u0438)"
  - "\u042F... \u044F \u043D\u0435 \u043F\u043E\u043C\u043D\u044E. \u041F\u0440\u043E\u0441\u0442\u043E
    \u0433\u043E\u043B\u043E\u0441. \u041A\u0430\u043A \u0443 \u0442\u0435\u0431\u044F.
    \u041E\u043D \u0432\u0435\u043B\u0435\u043B \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0442\u044C...
    \u041F\u043E\u043C\u043E\u0433\u0438 \u043C\u043D\u0435. \u0421\u043F\u0440\u043E\u0441\u0438,
    \u0433\u0434\u0435 \u043C\u044B"
  - "(\u0413\u043E\u043B\u043E\u0441 \u0436\u0435\u043D\u0449\u0438\u043D\u044B,
    \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u0439) \u041E\u043D \u0441\u043A\u0430\u0437\u0430\u043B,
    \u0447\u0442\u043E \u0435\u0441\u043B\u0438 \u0437\u0430\u043F\u0443\u0442\u0430\u0442\u044C
    \u0435\u0433\u043E... \u0437\u0430\u0434\u0430\u0442\u044C \u0432\u043E\u043F\u0440\u043E\u0441,
    \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043D\u0435\u0442 \u043E\u0442\u0432\u0435\u0442\u0430
    \u0432 \u0435\u0433\u043E \"\u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0435\"...
    \u0437\u0430\u043F\u0438\u0441\u044C \u0434\u0430\u0441\u0442 \u0441\u0431\u043E\u0439."
  - "\u0421\u043F\u0440\u043E\u0441\u0438 \u0435\u0433\u043E... \u0441\u043F\u0440\u043E\u0441\u0438
    \u0435\u0433\u043E, \u043A\u0430\u043A\u043E\u0433\u043E \u0446\u0432\u0435\u0442\u0430
    \u0442\u0438\u0448\u0438\u043D\u0430."
  playerChoices:
  - choiceText: "\u0425\u043E\u0440\u043E\u0448\u043E. \u041A\u0430\u043A\u043E\u0433\u043E
      \u0446\u0432\u0435\u0442\u0430 \u0442\u0438\u0448\u0438\u043D\u0430?"
    nextNode: {fileID: 11400000, guid: 9919e5e7bafe66f4b8a3f49bcb121834, type: 2}
    isCorrectChoice: 1
    maniacResponseOnFail: 
    failureOutcomeText: 
  - choiceText: "\u041F\u043E\u0447\u0435\u043C\u0443 \u044F \u0434\u043E\u043B\u0436\u0435\u043D
      \u0442\u0435\u0431\u0435 \u0432\u0435\u0440\u0438\u0442\u044C? \u0422\u044B
      \u043C\u043E\u0436\u0435\u0448\u044C \u0431\u044B\u0442\u044C \u0438\u043C
      \u0436\u0435."
    nextNode: {fileID: 11400000, guid: 43dfead3303a22047809afe7de6028fd, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: " (\u0422\u043E\u0442 \u0436\u0435 \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u0439
      \u0436\u0435\u043D\u0441\u043A\u0438\u0439 \u0433\u043E\u043B\u043E\u0441,
      \u043D\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u0441 \u043D\u043E\u0442\u043A\u0430\u043C\u0438
      \u043C\u0435\u0442\u0430\u043B\u043B\u0430) \u041D\u0435\u0434\u043E\u0432\u0435\u0440\u0438\u0435...
      \u041B\u043E\u0433\u0438\u0447\u043D\u043E. \u041D\u043E \u043D\u0435\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u0438\u0432\u043D\u043E.
      \u041F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0438\u0439 \u0442\u043E\u0436\u0435
      \u0441\u043E\u043C\u043D\u0435\u0432\u0430\u043B\u0441\u044F."
    failureOutcomeText: "\u041A\u043E\u043C\u043D\u0430\u0442\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
      \u0432\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F, \u0432\u044B\u0437\u044B\u0432\u0430\u044F
      \u0441\u0438\u043B\u044C\u043D\u043E\u0435 \u0433\u043E\u043B\u043E\u0432\u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u0435
      \u0438 \u0434\u0435\u0437\u043E\u0440\u0438\u0435\u043D\u0442\u0430\u0446\u0438\u044E"
  - choiceText: "\u042D\u0442\u043E \u0433\u043B\u0443\u043F\u043E. \u042F \u043B\u0443\u0447\u0448\u0435
      \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u044E \u0440\u0430\u0437\u0431\u0438\u0442\u044C
      \u0434\u0438\u043A\u0442\u043E\u0444\u043E\u043D."
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "(\u0413\u043E\u043B\u043E\u0441 \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
      \u043D\u0430 \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439,
      \u0431\u0435\u0437\u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439)
      \u041F\u043E\u043F\u044B\u0442\u043A\u0430 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C
      \u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C. \u041D\u0435\u0434\u043E\u043F\u0443\u0441\u0442\u0438\u043C\u043E.
      \u0410\u043A\u0442\u0438\u0432\u0430\u0446\u0438\u044F \u0437\u0430\u0449\u0438\u0442\u043D\u043E\u0439
      \u0441\u0438\u0441\u0442\u0435\u043C\u044B."
    failureOutcomeText: "\u0414\u0438\u043A\u0442\u043E\u0444\u043E\u043D \u0438\u0441\u043F\u0443\u0441\u043A\u0430\u0435\u0442
      \u043C\u043E\u0449\u043D\u044B\u0439 \u0443\u043B\u044C\u0442\u0440\u0430\u0437\u0432\u0443\u043A\u043E\u0432\u043E\u0439
