  playerChoices:
  - choiceText: "\u0425\u043E\u0440\u043E\u0448\u043E. \u041E\u0442\u0434\u0430\u0439
      \u043A\u043B\u044E\u0447!"
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "(\u0413\u043E\u043B\u043E\u0441 \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439, \u043D\u0430\u0441\u043C\u0435\u0448\u043B\u0438\u0432\u044B\u0439)
      \"'\u041E\u0442\u0434\u0430\u0439 \u043A\u043B\u044E\u0447'. \u0418\u043C\u0435\u043D\u043D\u043E
      \u044D\u0442\u0438 \u0441\u043B\u043E\u0432\u0430 \u0441\u043A\u0430\u0437\u0430\u043B
      \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0438\u0439. \u0418 \u043E\u043D
      \u0442\u043E\u0436\u0435 \u043F\u043E\u043F\u0430\u043B\u0441\u044F."
    failureOutcomeText: "\u0414\u0432\u0435\u0440\u044C \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0443
      \u0437\u0430 \u0432\u0430\u043C\u0438 \u0441 \u0433\u0440\u043E\u0445\u043E\u0442\u043E\u043C
      \u0437\u0430\u0445\u043B\u043E\u043F\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0438 \u0437\u0430\u043F\u0438\u0440\u0430\u0435\u0442\u0441\u044F"
  - choiceText: "\u041A\u043E\u0433\u043E \"\u0435\u0433\u043E\"? \u041A\u0442\u043E
      \u0442\u0435\u0431\u0435 \u044D\u0442\u043E \u0441\u043A\u0430\u0437\u0430\u043B?"
    nextNode: {fileID: 11400000, guid: d1ff9fe85a75f9345a0d5935f5aa9ddc, type: 2}
    isCorrectChoice: 1
    maniacResponseOnFail: 
    failureOutcomeText: 
  - choiceText: "\u042D\u0442\u043E \u043B\u043E\u0432\u0443\u0448\u043A\u0430. \u041F\u043E\u0447\u0435\u043C\u0443
      \u0442\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435 \u043C\u043E\u0436\u0435\u0448\u044C
      \u043F\u043E\u0438\u0441\u043A\u0430\u0442\u044C \u0441\u0430\u043C?"
    nextNode: {fileID: 11400000, guid: 43dfead3303a22047809afe7de6028fd, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "(\u0413\u043E\u043B\u043E\u0441 \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
      \u043D\u0430 \u043F\u043B\u0430\u0447\u0443\u0449\u0438\u0439, \u0434\u0435\u0442\u0441\u043A\u0438\u0439)
      \"\u042F \u043D\u0435 \u043C\u043E\u0433\u0443! \u042F \u0431\u043E\u044E\u0441\u044C!
      \u041E\u043D \u043F\u043E\u0432\u0441\u044E\u0434\u0443! \u041E\u043D \u0432\u0441\u0435
      \u0441\u043B\u044B\u0448\u0438\u0442!"
    failureOutcomeText: "\u0421\u0432\u0435\u0442 \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u043C\u0435\u0440\u0446\u0430\u0442\u044C,
      \u0438 \u0432\u044B \u0441\u043B\u044B\u0448\u0438\u0442\u0435 \u0442\u0438\u0445\u0438\u0439
