  maniacProfile: {fileID: 11400000, guid: 78d1db6aa0be3c24b8e800ace88dc587, type: 2}
  maniacMessages:
  - "\u0412\u043E\u0442 \u0438 \u0443\u043C\u043D\u0438\u0446\u0430. \u041F\u043E\u0441\u043B\u0443\u0448\u043D\u044B\u0439
    \u043F\u0430\u0446\u0438\u0435\u043D\u0442 \u2014 \u0437\u0430\u043B\u043E\u0433
    \u0443\u0441\u043F\u0435\u0448\u043D\u043E\u0433\u043E \u043B\u0435\u0447\u0435\u043D\u0438\u044F.
    \u0421\u0435\u0439\u0447\u0430\u0441 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C..."
  - "\u0422\u0430\u043A-\u0442\u0430\u043A... \u041A\u0430\u0440\u0442\u0438\u043D\u0430
    \u044F\u0441\u043D\u0430. \u041D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439
    \u043A\u0430\u0440\u0438\u0435\u0441 \u043D\u0430 \u0441\u0435\u043C\u0435\u0440\u043A\u0435,
    \u0437\u0443\u0431\u043D\u043E\u0439 \u043A\u0430\u043C\u0435\u043D\u044C...
    \u041D\u043E \u044D\u0442\u043E \u0432\u0441\u0435 \u043C\u0435\u043B\u043E\u0447\u0438.
    \u0413\u043B\u0430\u0432\u043D\u0430\u044F \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430
    - \u0443 \u0432\u0430\u0441 \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439
    \u043F\u0440\u0438\u043A\u0443\u0441."
  - "\u0418 \u0446\u0432\u0435\u0442 \u044D\u043C\u0430\u043B\u0438 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
    \u0431\u0435\u043B\u044B\u0439. \u042D\u0442\u043E \u043D\u0430\u0440\u0443\u0448\u0430\u0435\u0442
    \u0433\u0430\u0440\u043C\u043E\u043D\u0438\u044E. \u042D\u0442\u043E \u043D\u0443\u0436\u043D\u043E
    \u0438\u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C. \u0420\u0430\u0434\u0438\u043A\u0430\u043B\u044C\u043D\u043E."
  playerChoices:
  - choiceText: "\u041D\u0435 \u043D\u0430\u0434\u043E \u043D\u0438\u0447\u0435\u0433\u043E
      \u0438\u0441\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C! \u041C\u0435\u043D\u044F
      \u0432\u0441\u0435 \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442!"
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0412\u0430\u0441 \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442
      \u043D\u0435\u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0441\u0442\u0432\u043E?
      \u042D\u0442\u043E \u0441\u0438\u043C\u043F\u0442\u043E\u043C. \u0411\u043E\u043B\u0435\u0437\u043D\u044C
      \u043D\u0443\u0436\u043D\u043E \u043B\u0435\u0447\u0438\u0442\u044C, \u0430
      \u043D\u0435 \u043C\u0438\u0440\u0438\u0442\u044C\u0441\u044F \u0441 \u043D\u0435\u0439."
    failureOutcomeText: "\u041E\u043D \u0431\u0435\u0440\u0435\u0442 \u0432 \u0440\u0443\u043A\u0438
      \u0449\u0438\u043F\u0446\u044B \u0434\u043B\u044F \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u044F
      \u0437\u0443\u0431\u043E\u0432"
  - choiceText: "\u0410 \u043A\u0430\u043A\u0438\u0435 \u0435\u0441\u0442\u044C \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u044B
      \u043B\u0435\u0447\u0435\u043D\u0438\u044F?"
    nextNode: {fileID: 11400000, guid: e068c10145d55dc45b360a8bfb8ffb6f, type: 2}
    isCorrectChoice: 1
    maniacResponseOnFail: 
    failureOutcomeText: 
  - choiceText: "\u041C\u043E\u0436\u0435\u0442, \u0434\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u0430
      \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043C
