    nextNode: {fileID: 11400000, guid: 43dfead3303a22047809afe7de6028fd, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041F\u043B\u043E\u043C\u0431\u0443? \u042D\u0442\u043E
      \u043A\u0430\u043A \u043F\u0440\u0438\u043A\u043B\u0435\u0438\u0442\u044C \u043F\u043B\u0430\u0441\u0442\u044B\u0440\u044C
      \u043D\u0430 \u0440\u0430\u043A\u043E\u0432\u0443\u044E \u043E\u043F\u0443\u0445\u043E\u043B\u044C!
      \u041C\u044B \u043D\u0435 \u043B\u0435\u0447\u0438\u043C \u0441\u0438\u043C\u043F\u0442\u043E\u043C\u044B,
      \u043C\u044B \u0438\u0441\u043A\u043E\u0440\u0435\u043D\u044F\u0435\u043C \u043F\u0440\u0438\u0447\u0438\u043D\u0443!"
