  maniacProfile: {fileID: 11400000, guid: 0bd2d4eee4bf58248bb317d92b86f2cb, type: 2}
  maniacMessages:
  - "(\u0423\u0445\u043C\u044B\u043B\u043A\u0430 \u043F\u0440\u043E\u043F\u0430\u0434\u0430\u0435\u0442,
    \u0441\u043C\u0435\u043D\u044F\u044F\u0441\u044C \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u0438\u0435\u043C).
    \u0410 \u0442\u044B... \u0434\u043E\u0433\u0430\u0434\u0430\u043B\u0441\u044F.
    \u0411\u044B\u0441\u0442\u0440\u0435\u0435, \u0447\u0435\u043C \u044F \u043E\u0436\u0438\u0434\u0430\u043B.
    \u042D\u0442\u043E \u0443\u0441\u043B\u043E\u0436\u043D\u044F\u0435\u0442 \u0437\u0430\u0434\u0430\u0447\u0443."
  - "\u041D\u043E \u043D\u0435 \u043C\u0435\u043D\u044F\u0435\u0442 \u0441\u0443\u0442\u0438.
    \u041C\u0435\u0441\u0442\u043E \u0432 \u044D\u0442\u043E\u043C \u043C\u0438\u0440\u0435
    \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043B\u044F \u043E\u0434\u043D\u043E\u0433\u043E
    \u0438\u0437 \u043D\u0430\u0441."
  - "\u0420\u0430\u0437 \u0442\u044B \u0432\u0441\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C,
    \u0434\u0430\u0432\u0430\u0439 \u0431\u0443\u0434\u0435\u043C \u0447\u0435\u0441\u0442\u043D\u044B.
    \u0412\u0441\u043F\u043E\u043C\u043D\u0438 \u0432\u0441\u0435\u0445, \u043A\u043E\u0433\u043E
    \u0442\u044B \u043F\u043E\u0431\u0435\u0434\u0438\u043B."
  - "\u0417\u0430\u0433\u0430\u0434\u043E\u0447\u043D\u0438\u043A: \u0422\u044B \u043F\u043E\u0431\u0435\u0434\u0438\u043B
    \u0435\u0433\u043E, \u043F\u043E\u0434\u044B\u0433\u0440\u0430\u0432 \u0435\u0433\u043E
    \u044D\u0433\u043E. \u042D\u0442\u043E \u0431\u044B\u043B\u0430 \u043B\u0435\u0441\u0442\u044C.
    \u041B\u043E\u0436\u044C.\r\n"
  - "\u041A\u0443\u043A\u043B\u043E\u0432\u043E\u0434: \u0422\u044B \u0441\u043F\u0430\u0441
    \u0441\u0435\u0431\u044F, \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0432
    \u0435\u043C\u0443 \u0441\u0435\u0431\u044F \u0432 \u0436\u0435\u0440\u0442\u0432\u0443.
    \u042D\u0442\u043E \u0431\u044B\u043B\u0430 \u043C\u0430\u043D\u0438\u043F\u0443\u043B\u044F\u0446\u0438\u044F.
    \u0416\u0435\u0441\u0442\u043E\u043A\u043E\u0441\u0442\u044C."
  - "\u0422\u0435\u043E\u0440\u0435\u0442\u0438\u043A \u0417\u0430\u0433\u043E\u0432\u043E\u0440\u0430:
    \u0422\u044B \u043E\u0431\u043C\u0430\u043D\u0443\u043B \u0435\u0433\u043E, \u043F\u0440\u0438\u0442\u0432\u043E\u0440\u0438\u0432\u0448\u0438\u0441\u044C
    \u0441\u0432\u043E\u0438\u043C. \u041F\u0440\u0435\u0434\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E."
  - "\u0422\u044B \u043D\u0438\u0447\u0435\u043C \u043D\u0435 \u043B\u0443\u0447\u0448\u0435
    \u0438\u0445. \u0422\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u0445\u0438\u0442\u0440\u0435\u0435.
    \u041F\u0440\u0438\u0437\u043D\u0430\u0439 \u044D\u0442\u043E."
  playerChoices:
  - choiceText: "\u041D\u0435\u0442! \u042F \u0434\u0435\u043B\u0430\u043B \u044D\u0442\u043E,
      \u0447\u0442\u043E\u0431\u044B \u0432\u044B\u0436\u0438\u0442\u044C!"
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041E\u043F\u0440\u0430\u0432\u0434\u0430\u043D\u0438\u044F.
      \u0422\u043E, \u0447\u0435\u043C \u0441\u043B\u0430\u0431\u044B\u0435 \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u044E\u0442
      \u0441\u0432\u043E\u0438 \u0433\u0440\u0435\u0445\u0438. \u0422\u044B \u043D\u0438\u0447\u0435\u043C\u0443
      \u043D\u0435 \u043D\u0430\u0443\u0447\u0438\u043B\u0441\u044F."
    failureOutcomeText: "\u0412\u0430\u0448\u0435 \u043E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u0435
      \u0434\u043E\u0441\u0442\u0430\u0435\u0442 \u0438\u0437-\u0437\u0430 \u0441\u043F\u0438\u043D\u044B
      \u043D\u043E\u0436. \u0423 \u0432\u0430\u0441 \u0432 \u0440\u0443\u043A\u0435
      \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F"
  - choiceText: "\u0414\u0430. \u042F \u0434\u0435\u043B\u0430\u043B \u0432\u0441\u0435
      \u044D\u0442\u043E. \u0418 \u044F \u0431\u044B \u0441\u0434\u0435\u043B\u0430\u043B
      \u044D\u0442\u043E \u0441\u043D\u043E\u0432\u0430."
    nextNode: {fileID: 11400000, guid: 43dfead3303a22047809afe7de6028fd, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041F\u0440\u0438\u0437\u043D\u0430\u043D\u0438\u0435
      \u0431\u0435\u0437 \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044F.
      \u0417\u043D\u0430\u0447\u0438\u0442, \u0442\u044B \u0442\u0430\u043A\u043E\u0439
      \u0436\u0435, \u043A\u0430\u043A \u043E\u043D\u0438. \u0422\u044B - \u043C\u043E\u043D\u0441\u0442\u0440.
      \u0410 \u043C\u043E\u043D\u0441\u0442\u0440\u043E\u0432 \u043D\u0443\u0436\u043D\u043E
      \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0432 \u043A\u043B\u0435\u0442\u043A\u0435."
    failureOutcomeText: "\u0417\u0435\u0440\u043A\u0430\u043B\u043E \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0440\u0435\u0448\u0435\u0442\u043A\u0443, \u0437\u0430\u043F\u0438\u0440\u0430\u044F
      \u0432\u0430\u0441 \u0432 \u0438\u043B\u043B\u044E\u0437\u043E\u0440\u043D\u043E\u0439
      \u043A\u0430\u043C\u0435\u0440\u0435"
  - choiceText: "\u0422\u043E\u043B\u044C\u043A\u043E \u043F\u043B\u043E\u0445\u043E\u0435?
      \u041D\u043E \u0431\u044B\u043B\u0438 \u0438 \u0441\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0435
      \u043A \u0410\u043D\u043D\u0435 \u0438 \u0441\u043C\u0435\u043A\u0430\u043B\u043A\u0430
      \u0441 \u0418\u043D\u0436\u0435\u043D\u0435\u0440\u043E\u043C."
