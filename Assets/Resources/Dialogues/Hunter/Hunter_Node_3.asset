  maniacProfile: {fileID: 11400000, guid: 7c74e68958a7824468246d99e087f92d, type: 2}
  maniacMessages:
  - "(\u0415\u0449\u0435 \u0447\u0435\u0440\u0435\u0437 10 \u043C\u0438\u043D\u0443\u0442)
    \u041B\u0430\u0434\u043D\u043E, \u043F\u0440\u0438\u0437\u043D\u0430\u044E, \u0442\u044B
    \u0443\u043C\u0435\u0435\u0448\u044C \u043F\u0443\u0442\u0430\u0442\u044C \u0441\u043B\u0435\u0434\u044B.
    \u041D\u043E \u043B\u0435\u0441 - \u043C\u043E\u0439 \u0434\u043E\u043C. \u042F
    \u0441\u043B\u044B\u0448\u0443 \u043A\u0430\u0436\u0434\u044B\u0439 \u0448\u043E\u0440\u043E\u0445."
  - "\u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u0441\u0435\u0439\u0447\u0430\u0441
    \u044F \u0441\u043B\u044B\u0448\u0443, \u043A\u0430\u043A \u0442\u044B \u0442\u044F\u0436\u0435\u043B\u043E
    \u0434\u044B\u0448\u0438\u0448\u044C \u0437\u0430 \u0441\u0442\u0430\u0440\u044B\u043C
    \u043F\u043E\u0432\u0430\u043B\u0435\u043D\u043D\u044B\u043C \u0434\u0443\u0431\u043E\u043C."
  playerChoices:
  - choiceText: "\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043F\u043E\u0449\u0430\u0434\u0438!
      \u042F \u0443\u0441\u0442\u0430\u043B, \u044F \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435 \u043C\u043E\u0433\u0443 \u0431\u0435\u0436\u0430\u0442\u044C!"
    nextNode: {fileID: 11400000, guid: 43dfead3303a22047809afe7de6028fd, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0423\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u044C
      \u2014 \u044D\u0442\u043E \u043F\u0440\u0438\u0437\u043D\u0430\u043A \u0441\u043B\u0430\u0431\u043E\u0441\u0442\u0438.
      \u0410 \u0441\u043B\u0430\u0431\u044B\u0439 \u0434\u043E\u043B\u0436\u0435\u043D
      \u0443\u043C\u0435\u0440\u0435\u0442\u044C. \u0421\u043F\u0430\u0441\u0438\u0431\u043E,
      \u0447\u0442\u043E \u043E\u0431\u043B\u0435\u0433\u0447\u0438\u043B \u043C\u043D\u0435
      \u0440\u0430\u0431\u043E\u0442\u0443."
    failureOutcomeText: "\u041E\u043D \u0431\u0435\u0441\u0448\u0443\u043C\u043D\u043E
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u043A \u0434\u0443\u0431\u0443
      \u0441\u0437\u0430\u0434\u0438"
  - choiceText: "\u0422\u0430\u043A \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u043B\u043E\u0432\u0443\u0448\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
      \u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B 5 \u043C\u0438\u043D\u0443\u0442
      \u043D\u0430\u0437\u0430\u0434. \u041F\u0440\u043E\u0441\u0442\u043E\u0439
      \u043A\u0430\u043F\u043A\u0430\u043D \u0438\u0437 \u0432\u0435\u0442\u043E\u043A."
    nextNode: {fileID: 11400000, guid: 44a2acc6de8c3804c9af4158915b6f1b, type: 2}
    isCorrectChoice: 1
    maniacResponseOnFail: 
    failureOutcomeText: 
  - choiceText: "\u0414\u0430, \u044F \u0437\u0434\u0435\u0441\u044C! \u0418\u0434\u0438
      \u0441\u044E\u0434\u0430, \u0442\u0440\u0443\u0441, \u0435\u0441\u043B\u0438
      \u043D\u0435 \u0431\u043E\u0438\u0448\u044C\u0441\u044F!"
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0412\u044B\u0437\u043E\u0432 \u043F\u0440\u0438\u043D\u044F\u0442."
    failureOutcomeText: "\u0412 \u0434\u0435\u0440\u0435\u0432\u043E \u043D\u0430\u0434
      \u0432\u0430\u0448\u0435\u0439 \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u0432\u043E\u043D\u0437\u0430\u0435\u0442\u0441\u044F
      \u0441\u0442\u0440\u0435\u043B\u0430 \u0438\u0437 \u0430\u0440\u0431\u0430\u043B\u0435\u0442\u0430"
