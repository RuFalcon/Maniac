  maniacMessages:
  - "\u041D\u0435\u0432\u0435\u0440\u043D\u043E. \u041C\u0430\u0448\u0438\u043D\u0430
    \u0431\u044B\u043B\u0430 \u043A\u0440\u0430\u0441\u043D\u0430\u044F. \u041D\u043E
    \u0432\u0430\u0448\u0430 \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    \u0432 \u043B\u043E\u0436\u043D\u043E\u043C \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0438
    - \u044D\u0442\u043E \u0438\u043C\u0435\u043D\u043D\u043E \u0442\u043E\u0442
    \u044D\u0444\u0444\u0435\u043A\u0442, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043C\u044B \u0438\u0449\u0435\u043C."
  - "\u041F\u0440\u0435\u0432\u043E\u0441\u0445\u043E\u0434\u043D\u043E. \u0422\u0435\u0441\u0442
    \u043F\u0440\u043E\u0439\u0434\u0435\u043D."
  - "\u0422\u0435\u043F\u0435\u0440\u044C \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043C
    \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u0443\u044E
    \u043F\u0430\u043C\u044F\u0442\u044C. \u042F \u043F\u043E\u043A\u0430\u0436\u0443
    \u0432\u0430\u043C \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044E.
    (\u041D\u0430 \u044D\u043A\u0440\u0430\u043D\u0435 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0444\u043E\u0442\u043E \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E
    \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u043E\u0433\u043E \u0432\u0430\u043C
    \u0443\u043B\u044B\u0431\u0430\u044E\u0449\u0435\u0433\u043E\u0441\u044F \u0440\u0435\u0431\u0435\u043D\u043A\u0430)."
  - "\u042D\u0442\u043E \u0432\u0430\u0448 \u0441\u044B\u043D. \u0412\u044B \u043F\u043E\u043C\u043D\u0438\u0442\u0435,
    \u043A\u0430\u043A \u0433\u043E\u0440\u0434\u0438\u043B\u0438\u0441\u044C \u0438\u043C,
    \u043A\u043E\u0433\u0434\u0430 \u043E\u043D \u0432\u044B\u0438\u0433\u0440\u0430\u043B
    \u0448\u043A\u043E\u043B\u044C\u043D\u0443\u044E \u043E\u043B\u0438\u043C\u043F\u0438\u0430\u0434\u0443?
    \u041E\u043F\u0438\u0448\u0438\u0442\u0435 \u0432\u0430\u0448\u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u0430."
  playerChoices:
  - choiceText: "\u042D\u0442\u043E \u043D\u0435 \u043C\u043E\u0439 \u0441\u044B\u043D!
      \u0423 \u043C\u0435\u043D\u044F \u043D\u0435\u0442 \u0434\u0435\u0442\u0435\u0439!"
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0421\u0443\u0431\u044A\u0435\u043A\u0442 \u043E\u0442\u0432\u0435\u0440\u0433\u0430\u0435\u0442
      \u0438\u043C\u043F\u043B\u0430\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0435
      \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435. \u0421\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u0435
      \u0432\u044B\u0441\u043E\u043A\u043E\u0435. \u0422\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F
      \u043A\u043E\u0440\u0440\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u043A\u0430
      \u0434\u043E\u0437\u044B."
    failureOutcomeText: "\u0412\u044B \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435
      \u043B\u0435\u0433\u043A\u0438\u0439 \u0443\u043A\u043E\u043B \u0432 \u0448\u0435\u044E
      \u043E\u0442 \u043D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u043E\u0433\u043E
      \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u0430 \u0432 \u043F\u043E\u0434\u0433\u043E\u043B\u043E\u0432\u043D\u0438\u043A\u0435
      \u043A\u0440\u0435\u0441\u043B\u0430. \u041C\u0438\u0440 \u043D\u0430 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435
      \u0442\u0435\u043C\u043D\u0435\u0435\u0442"
  - choiceText: "\u042F... \u044F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E
      \u0433\u043E\u0440\u0434\u043E\u0441\u0442\u044C. \u0414\u0430. \u041E\u043D
