  maniacProfile: {fileID: 11400000, guid: 2eda7ce2bec2c4443ae5b89286206049, type: 2}
  maniacMessages:
  - "\u0412\u0435\u0440\u043D\u044B\u0439 \u0432\u044B\u0431\u043E\u0440. \u041F\u0430\u043D\u0435\u043B\u044C
    \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F - \u044D\u0442\u043E
    \u043F\u0435\u0440\u0432\u044B\u0439 \u0448\u0430\u0433. \u0421\u0438\u0441\u0442\u0435\u043C\u0430
    \u0433\u043E\u0442\u043E\u0432\u0430 \u043F\u0440\u0438\u043D\u044F\u0442\u044C
    \u0432\u0432\u043E\u0434."
  - "\u041F\u0435\u0440\u0432\u0430\u044F \u0437\u0430\u0434\u0430\u0447\u0430. \u041D\u0430
    \u0441\u0442\u0435\u043D\u0430\u0445 \u043A\u043E\u043C\u043D\u0430\u0442\u044B
    \u043D\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u043D\u044B \u0447\u0435\u0442\u044B\u0440\u0435
    \u0441\u0438\u043C\u0432\u043E\u043B\u0430: \u043A\u0440\u0430\u0441\u043D\u044B\u0439
    \u043A\u0432\u0430\u0434\u0440\u0430\u0442, \u0441\u0438\u043D\u0438\u0439 \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A,
    \u0437\u0435\u043B\u0435\u043D\u0430\u044F \u0437\u0432\u0435\u0437\u0434\u0430
    \u0438 \u0436\u0435\u043B\u0442\u044B\u0439 \u043A\u0440\u0443\u0433. "
  - "\u0422\u044B \u0434\u043E\u043B\u0436\u0435\u043D \u043D\u0430\u0436\u0430\u0442\u044C
    \u043D\u0430 \u043A\u043D\u043E\u043F\u043A\u0438 \u0432 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0439
    \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438.
    \u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430: \"\u041D\u0430\u0447\u043D\u0438
    \u0441 \u0442\u043E\u0433\u043E, \u0443 \u0447\u0435\u0433\u043E \u043C\u0435\u043D\u044C\u0448\u0435
    \u0432\u0441\u0435\u0433\u043E \u0443\u0433\u043B\u043E\u0432 \u0438 \u0437\u0430\u043A\u043E\u043D\u0447\u0438
    \u0442\u0435\u043C, \u0443 \u0447\u0435\u0433\u043E \u0438\u0445 \u0431\u043E\u043B\u044C\u0448\u0435
    \u0432\u0441\u0435\u0433\u043E\"."
  playerChoices:
  - choiceText: "\u041A\u0440\u0443\u0433, \u0422\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A,
      \u041A\u0432\u0430\u0434\u0440\u0430\u0442, \u0417\u0432\u0435\u0437\u0434\u0430."
    nextNode: {fileID: 11400000, guid: 573222c44558b094b8b8e10c3c780e36, type: 2}
    isCorrectChoice: 1
    maniacResponseOnFail: 
    failureOutcomeText: 
