    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041D\u0435\u0432\u0435\u0440\u043D\u043E. \u0428\u0442\u0440\u0430\u0444:
      \u043C\u0438\u043D\u0443\u0441 3 \u043C\u0438\u043D\u0443\u0442\u044B."
    failureOutcomeText: "\u0422\u0430\u0439\u043C\u0435\u0440 \u0442\u0438\u043A\u0430\u0435\u0442
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435. \u041A\u043D\u043E\u043F\u043A\u0438
      \u043D\u0430 \u043F\u0430\u043D\u0435\u043B\u0438 \u0433\u0430\u0441\u043D\u0443\u0442
      \u043D\u0430 30 \u0441\u0435\u043A\u0443\u043D\u0434, \u043D\u0435 \u0434\u0430\u0432\u0430\u044F
      \u0432\u0430\u043C \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
      \u0441\u043D\u043E\u0432\u0430"
  - choiceText: "\u041A\u0432\u0430\u0434\u0440\u0430\u0442, \u0417\u0432\u0435\u0437\u0434\u0430,
      \u041A\u0440\u0443\u0433, \u0422\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A."
    nextNode: {fileID: 11400000, guid: 43dfead3303a22047809afe7de6028fd, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041D\u0435\u0432\u0435\u0440\u043D\u043E. \u0428\u0442\u0440\u0430\u0444:
      \u043C\u0438\u043D\u0443\u0441 3 \u043C\u0438\u043D\u0443\u0442\u044B."
    failureOutcomeText: "\u0422\u0430\u0439\u043C\u0435\u0440 \u0442\u0438\u043A\u0430\u0435\u0442
