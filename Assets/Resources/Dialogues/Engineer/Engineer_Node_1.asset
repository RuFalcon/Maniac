  - "\u0423 \u0442\u0435\u0431\u044F 20 \u043C\u0438\u043D\u0443\u0442, \u0447\u0442\u043E\u0431\u044B
    \u043D\u0430\u0439\u0442\u0438 \u0432\u044B\u0445\u043E\u0434. \u041A\u0430\u0436\u0434\u043E\u0435
    \u043D\u0435\u0432\u0435\u0440\u043D\u043E\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
    \u0431\u0443\u0434\u0435\u0442 \u043E\u0442\u043D\u0438\u043C\u0430\u0442\u044C
    \u0443 \u0442\u0435\u0431\u044F \u0432\u0440\u0435\u043C\u044F. \u041A\u0430\u0436\u0434\u043E\u0435
    \u0432\u0435\u0440\u043D\u043E\u0435 - \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u0442\u044C
    \u043A \u0441\u0432\u043E\u0431\u043E\u0434\u0435."
  - "\u0414\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u0430, \u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0441\u044C.
