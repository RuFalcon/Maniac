  maniacMessages:
  - "\u041E\u0431\u044A\u0435\u043A\u0442 \u0432 \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0438.
    \u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B \"\u041B\u0430\u0431\u0438\u0440\u0438\u043D\u0442\"
    \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u043D. \u0414\u043E\u0431\u0440\u043E
    \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C \u0432 \u043C\u043E\u0435
    \u0442\u0432\u043E\u0440\u0435\u043D\u0438\u0435. \u0422\u044B \u0437\u0430\u043F\u0435\u0440\u0442
    \u0432 \u0441\u0430\u043C\u043E\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E\u0439
