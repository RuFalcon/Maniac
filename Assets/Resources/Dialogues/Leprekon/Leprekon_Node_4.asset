    failureOutcomeText: "\u0416\u0430\u0434\u043D\u043E\u0441\u0442\u044C \u0431\u0435\u0440\u0435\u0442
      \u0432\u0435\u0440\u0445 \u0438 \u043E\u043D \u0432 \u044F\u0440\u043E\u0441\u0442\u0438
