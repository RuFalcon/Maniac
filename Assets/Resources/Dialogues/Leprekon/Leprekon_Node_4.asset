  - choiceText: "\u041A\u043B\u044F\u043D\u0443\u0441\u044C \u0442\u0432\u043E\u0438\u043C
      \u0437\u043E\u043B\u043E\u0442\u043E\u043C."
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u041C\u041E\u0418\u041C \u0417\u041E\u041B\u041E\u0422\u041E\u041C?!
      \u0422\u044B \u0441\u043C\u0435\u0435\u0448\u044C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
