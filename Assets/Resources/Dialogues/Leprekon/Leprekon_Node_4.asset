  maniacProfile: {fileID: 11400000, guid: 731b095c18a3be747baef032197baafd, type: 2}
  maniacMessages:
  - "\u0412\u0435\u0440\u043D\u043E. \u0411\u044B\u0441\u0442\u0440\u043E. \u0411\u0443\u0434\u044C
    \u0442\u044B \u043F\u0440\u043E\u043A\u043B\u044F\u0442, \u0434\u043B\u0438\u043D\u043D\u043E\u043D\u043E\u0433\u0438\u0439!
    \u0422\u044B \u0438 \u043F\u0440\u0430\u0432\u0434\u0430 \u0443\u043C\u0435\u043D.
    \u041B\u0430\u0434\u043D\u043E, \u0441\u0434\u0435\u043B\u043A\u0430 \u0435\u0441\u0442\u044C
    \u0441\u0434\u0435\u043B\u043A\u0430. \u042F \u043F\u043E\u043A\u0430\u0436\u0443
    \u0442\u0435\u0431\u0435 \u0432\u044B\u0445\u043E\u0434."
  - "\u041D\u043E... \u043F\u043E \u0437\u0430\u043A\u043E\u043D\u0443 \u043D\u0430\u0448\u0435\u0433\u043E
    \u043D\u0430\u0440\u043E\u0434\u0430, \u044F \u043D\u0435 \u043C\u043E\u0433\u0443
    \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0442\u043E\u0433\u043E,
    \u043A\u0442\u043E \u0437\u043D\u0430\u0435\u0442 \u0434\u043E\u0440\u043E\u0433\u0443
    \u043A \u043C\u043E\u0435\u043C\u0443 \u0441\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u0443,
    \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0430\u043A. "
  - "\u0422\u044B \u0434\u043E\u043B\u0436\u0435\u043D \u0434\u0430\u0442\u044C \u043C\u043D\u0435
    \u043A\u043B\u044F\u0442\u0432\u0443. \u0427\u0435\u043C \u0442\u044B \u043F\u043E\u043A\u043B\u044F\u043D\u0435\u0448\u044C\u0441\u044F
    \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F?"
  playerChoices:
  - choiceText: "\u041A\u043B\u044F\u043D\u0443\u0441\u044C \u0441\u0432\u043E\u0435\u0439
      \u0436\u0438\u0437\u043D\u044C\u044E."
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0422\u0432\u043E\u044F \u0436\u0438\u0437\u043D\u044C?
      \u041E\u043D\u0430 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0441\u0442\u043E\u0438\u0442
      \u0434\u043B\u044F \u043C\u0435\u043D\u044F! \u0421\u043B\u0438\u0448\u043A\u043E\u043C
      \u0434\u0435\u0448\u0435\u0432\u0430\u044F \u043A\u043B\u044F\u0442\u0432\u0430!"
    failureOutcomeText: "\u041E\u043D \u0441\u0447\u0438\u0442\u0430\u0435\u0442
