  maniacProfile: {fileID: 11400000, guid: 731b095c18a3be747baef032197baafd, type: 2}
  maniacMessages:
  - "\u0410\u0433\u0430! \u041F\u043E\u043F\u0430\u043B\u0441\u044F, \u0432\u043E\u0440\u0438\u0448\u043A\u0430!
    \u0415\u0449\u0435 \u043E\u0434\u0438\u043D \u0434\u043B\u0438\u043D\u043D\u043E\u043D\u043E\u0433\u0438\u0439
    \u0443\u0431\u043B\u044E\u0434\u043E\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043F\u0440\u0438\u0448\u0435\u043B \u0437\u0430 \u043C\u043E\u0438\u043C \u0437\u043E\u043B\u043E\u0442\u043E\u043C!
    \u0412\u0441\u0435 \u0432\u044B \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u0435."
  - "\u0414\u0443\u043C\u0430\u0435\u0442\u0435, \u044F \u043D\u0435 \u0432\u0438\u0436\u0443
    \u0431\u043B\u0435\u0441\u043A \u0436\u0430\u0434\u043D\u043E\u0441\u0442\u0438
    \u0432 \u0432\u0430\u0448\u0438\u0445 \u0433\u043B\u0430\u0437\u0430\u0445? \u041F\u0440\u0438\u0437\u043D\u0430\u0432\u0430\u0439\u0441\u044F,
    \u0437\u0430\u0447\u0435\u043C \u043F\u0440\u0438\u0448\u0435\u043B?"
  playerChoices:
  - choiceText: "\u041A\u0430\u043A\u043E\u0435 \u0437\u043E\u043B\u043E\u0442\u043E?!
      \u042F \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0443\u0440\u0438\u0441\u0442,
      \u044F \u0437\u0430\u0431\u043B\u0443\u0434\u0438\u043B\u0441\u044F!"
    nextNode: {fileID: 11400000, guid: 072ff9f99473c214d940fa9bc8ef6f07, type: 2}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0417\u0430\u0431\u043B\u0443\u0434\u0438\u043B\u0441\u044F?
      \u0412 \u043C\u043E\u0435\u0439 \u043F\u0435\u0449\u0435\u0440\u0435, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
      \u0441\u043A\u0440\u044B\u0442\u0430 \u0441\u0435\u043C\u044C\u044E \u0438\u043B\u043B\u044E\u0437\u0438\u044F\u043C\u0438?
      \u0412\u0440\u0435\u0448\u044C! \u0412\u0441\u0435 \u0432\u044B \u043B\u0436\u0435\u0442\u0435!"
    failureOutcomeText: "\u041A\u0430\u043F\u043A\u0430\u043D \u043D\u0430 \u0432\u0430\u0448\u0435\u0439
      \u043D\u043E\u0433\u0435 \u0441\u0436\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      \u0441\u0438\u043B\u044C\u043D\u0435\u0435, \u0432\u044B\u0437\u044B\u0432\u0430\u044F
      \u043E\u0441\u0442\u0440\u0443\u044E \u0431\u043E\u043B\u044C"
  - choiceText: "\u0414\u0430, \u044F \u043F\u0440\u0438\u0448\u0435\u043B \u0437\u0430
      \u0437\u043E\u043B\u043E\u0442\u043E\u043C! \u041E\u0442\u0434\u0430\u0439
      \u0435\u0433\u043E, \u0438 \u044F \u0442\u0435\u0431\u044F \u043D\u0435 \u0442\u0440\u043E\u043D\u0443!"
    nextNode: {fileID: 0}
    isCorrectChoice: 0
    maniacResponseOnFail: "\u0423\u0433\u0440\u043E\u0436\u0430\u0435\u0448\u044C?!
      \u041C\u041D\u0415?! \u0412 \u041C\u041E\u0415\u0419 \u0421\u041E\u0411\u0421\u0422\u0412\u0415\u041D\u041D\u041E\u0419
      \u041F\u0415\u0429\u0415\u0420\u0415?!"
    failureOutcomeText: "\u0418\u0437 \u0442\u0435\u043C\u043D\u043E\u0442\u044B
      \u0432\u044B\u043B\u0435\u0442\u0430\u0435\u0442 \u0433\u043E\u0440\u0441\u0442\u044C
      \u0437\u043E\u043B\u043E\u0442\u043E\u0439 \u043F\u044B\u043B\u0438, \u043A\u043E\u0442\u043E\u0440\u0430\u044F,
      \u043F\u043E\u043F\u0430\u0434\u0430\u044F \u043D\u0430 \u0432\u0430\u0441,
      \u0432\u044B\u0437\u044B\u0432\u0430\u0435\u0442 \u0441\u0438\u043B\u044C\u043D\u044B\u0439
      \u0437\u0443\u0434 \u0438 \u0436\u0436\u0435\u043D\u0438\u0435"
  - choiceText: "\u042F \u043F\u0440\u0438\u0448\u0435\u043B \u043D\u0435 \u0437\u0430\u0431\u0438\u0440\u0430\u0442\u044C,
      \u0430 \u043C\u0435\u043D\u044F\u0442\u044C\u0441\u044F."
